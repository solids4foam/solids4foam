Dockerfile
.dockerignore

.git

tutorialsTest

**/log.Allwmake

**/*~
**/.*~
**/*.bak
**/*.bak[0-9][0-9]
**/*.orig
**/*.orig[0-9][0-9]
**/\#*\#

# Keep OpenFOAM initial-condition folders
!tutorials/**/0.orig/
!tutorials/**/0.orig/**

**/*.[oa]
**/*.la
**/*.so
**/*.jar
**/*.dylib

# Corefiles
**/core

# dependency files - anywhere
**/*.dep

# lnInclude (symlink) folders - anywhere
**/lnInclude

# sources generated by a unity build - they are regenerated in the image
src/solids4FoamModels/unityBuild

# ThirdParty software is downloaded inside the image: copying in a local
# eigen3, which is often a symlink to a system install, makes that download
# fail with "mv: cannot overwrite non-directory 'eigen3'"
ThirdParty/eigen3

# A hidden file created by the Mac OS X Finder.
**/.DS_Store

# build folders - anywhere
**/linux*Gcc*/
**/linux*Icc*/
**/darwin*Gcc*/
**/darwin*Intel*/
**/darwin*Arm*/
**/darwin*Clang*/
**/linuxming*/
**/SiCortex*Gcc*/
**/solaris*Gcc*/
**/SunOS*Gcc*/
