FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Three-dimensional mesh of cells of width 0.0125 m

convertToMeters 1;

vertices
(
    (0   0   0)
    (0.4 0   0)
    (0.4 0.4 0)
    (0   0.4 0)
    (0   0   0.4)
    (0.4 0   0.4)
    (0.4 0.4 0.4)
    (0   0.4 0.4)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (32 32 32) simpleGrading (1 1 1)
);

boundary
(
    sides
    {
        type            wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

