FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Two-dimensional mesh graded in x, from cells of width 0.0139 m at x = 0
// to 0.0069 m at x = 0.4 m, so that the bodies move into cells of a
// different width, with its mid-plane at z = 0, a plane of the cluster grid

convertToMeters 1;

vertices
(
    (0   0   -0.05)
    (0.4 0   -0.05)
    (0.4 0.4 -0.05)
    (0   0.4 -0.05)
    (0   0   0.05)
    (0.4 0   0.05)
    (0.4 0.4 0.05)
    (0   0.4 0.05)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 40 1) simpleGrading (0.5 1 1)
);

boundary
(
    sides
    {
        type            wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type            empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

