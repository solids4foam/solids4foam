FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lawChecks;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The laws Test-mechanicalConstitutiveLawChecks checks, one at a time, with
// the constants of the tutorials that use them. finiteStrain selects the
// update the law implements, isotropic and linear the checks that apply, and
// fields the coupling inputs the law reads, at its reference values.
//
// The plasticity laws read constant/plasticStrainVsYieldStress, which has
// more than two rows, so that the nonlinear hardening branch is the one run.
// electroMechanicalLaw appears twice: with its tension ramped over a long time
// from zero, so that at time 0 the reference state is stress free and the
// reference checks apply, and with the tension on from the start, so that the
// objectivity check sees the active term; the reference checks, which assume
// a stress-free reference, are off for that one. The two plasticity laws give
// yieldBounds, the initial yield stress and the last of the hardening table

linearElastic
{
    finiteStrain    no;
    isotropic       yes;
    linear          yes;
    law
    {
        type            linearElastic;
        rho             rho [1 -3 0 0 0 0 0] 7854;
        E               E [1 -1 -2 0 0 0 0] 200e9;
        nu              nu [0 0 0 0 0 0 0] 0.3;
    }
}

linearElasticMisesPlastic
{
    finiteStrain    no;
    isotropic       yes;
    linear          no;
    yieldBounds     (243e6 600e6);
    law
    {
        type            linearElasticMisesPlastic;
        rho             rho [1 -3 0 0 0 0 0] 3500;
        E               E [1 -1 -2 0 0 0 0] 70e9;
        nu              nu [0 0 0 0 0 0 0] 0.3;
        "file|fileName" "$FOAM_CASE/constant/plasticStrainVsYieldStress";
        outOfBounds     clamp;
    }
}

