#!/bin/bash
cd ${0%/*} || exit 1    # run from this directory

echo "optionalFixes/Allcheck"

# This script reports on files that can be optionally fixed in the OpenFOAM
# installation. To see the consequence of these fixes, visit www.solids4foam.com.

# If S4F_NO_FILE_FIXES is not defined, then set it to 1
# To enable checks, set S4F_NO_FILE_FIXES to 0 on the command line, e.g
# export S4F_NO_FILE_FIXES=0
: "${S4F_NO_FILE_FIXES:=1}"

# Function for the checking and reporting how to replace a file
# Arguments:
#   $1  - Directory in optionalFixes containing the replacement file
#   $2  - File name
#   $3  - Target path, without the file name and the slash at the end
#   $4  - Path to library to be re-built
#
checkAndReport()
{
    if [ "$S4F_NO_FILE_FIXES" = "1" ]
    then
        echo
        echo "The S4F_NO_FILE_FIXES variable is set so checks will not be performed"
        echo "To enable these checks, set the S4F_NO_FILE_FIXES variable to 0, i.e."
        echo "export S4F_NO_FILE_FIXES=0"
    elif cmp --silent "./${1}/${2}" "${3}/${2}"
    then
        echo "'${2}' has already been replaced"
        return 0
    else
        echo
        echo "******** PLEASE FIX THIS ***********"
        echo "You should replace the file '${3}/${2}' with 'optionalFixes/${1}/${2}'"
        echo "and re-build the library '${4}'."
        echo
        echo "You can do it by running the following commands:"
        echo "    cp optionalFixes/${1}/${2} ${3}/"
        echo "    wmake libso ${4}"
        echo "************************************"
        echo
        return 1
    fi
}


# Different checks required for each version of OpenFOAM/foam; no fixes are
# required for OpenFOAM.com
result=0
if [ "$WM_PROJECT" = "foam" ]
then
    # This fixes segmentation errors related to point fields when mesh
    # topological changes occur
    checkAndReport \
        "foam-extend-4.1" \
        "pointBoundaryMesh.C" \
        "$FOAM_SRC/foam/meshes/pointMesh/pointBoundaryMesh" \
        "$FOAM_SRC/foam"
    if [ $? -ne 0 ]; then result=1; fi

    # Fix time index storage in the storeOldTimes function
    checkAndReport \
        "foam-extend-4.1" \
        "GeometricField.C" \
        "$FOAM_SRC/foam/fields/GeometricFields/GeometricField" \
        "$FOAM_SRC/foam"
    if [ $? -ne 0 ]; then result=1; fi
elif [[ $WM_PROJECT_VERSION != v* ]]
then
    # Fix time index storage in the storeOldTimes function
    checkAndReport \
        "OpenFOAM-9" \
        "GeometricField.C" \
        "$FOAM_SRC/OpenFOAM/fields/GeometricFields/GeometricField" \
        "$FOAM_SRC/OpenFOAM"
    if [ $? -ne 0 ]; then result=1; fi
fi

echo

# If files check fails, then print error below
if [ "$result" -ne 0 ]
then
    echo "******** PLEASE FIX THIS ***********"
    echo "Please replace the files above"
    echo "************************************"
    echo
    exit 1
fi
