#!/usr/bin/env python3
"""Draw a circulation circuit as an electrical circuit diagram (SVG).

    circulationSchematic circuit.json [circuit.svg] [--layout auto|line|ring]

circuit.json is written by  circulationFoam -diagram  (which calls this script
if it is on the PATH). The drawing uses the electrical analogy of the model:

    resistor      zigzag               blood flow resistance R
    inductor      coil                 blood inertance L
    valve         diode                orifice valve (flow one way only)
    source        circle with arrow    prescribed flow
    capacitor     two plates to ground compliance (a node that stores volume)
    variable cap. plates with an arrow heart chamber (time-varying elastance)
    ground        three bars           fixed pressure (the reference)
    CFD port      blue box             a coupled patch of the CFD domain

The nodes are placed by Graphviz (dot for chains, circo for loops) if it is
installed, otherwise by a simple built-in layout; Graphviz is used for the
positions only. Standard library only.
"""
import json
import math
import os
import shutil
import subprocess
import sys

LSYM = 76          # length of an element's symbol along its wire
MIN_EDGE = 165     # shortest wire between two nodes after scaling
STROKE = "#1d1d1f"
FONT = "Helvetica, Arial, sans-serif"

# ---------------------------------------------------------------- symbols
# Each symbol is drawn in local coordinates along +x from 0 to its length,
# centre line y = 0, and returns SVG path/element strings.


def line(x1, y1, x2, y2, extra=""):
    return '<line x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" %s/>' % (x1, y1, x2, y2, extra)


def sym_resistor(L):
    n, lead = 6, 14.0
    w = (L - 2 * lead) / n
    pts = [(lead, 0.0)] + [(lead + (i + 0.5) * w, 8.0 * (-1) ** i) for i in range(n)] + [(L - lead, 0.0)]
    pts = [(0.0, 0.0)] + pts + [(L, 0.0)]
    return ['<polyline points="%s" fill="none"/>' % " ".join("%.1f,%.1f" % p for p in pts)]


def sym_inductor(L):
    n, lead = 4, 12.0
    w = (L - 2 * lead) / n
    d = "M0,0 L%.1f,0 " % lead + " ".join("a%.1f,%.1f 0 0 1 %.1f,0" % (w / 2, w / 2, w) for _ in range(n)) + " L%.1f,0" % L
    return ['<path d="%s" fill="none"/>' % d]


def sym_diode(L):
    c = L / 2
    return [line(0, 0, c - 9, 0), line(c + 9, 0, L, 0),
            '<polygon points="%.1f,-10 %.1f,10 %.1f,0" fill="#fff"/>' % (c - 9, c - 9, c + 9),
            line(c + 9, -10, c + 9, 10, 'stroke-width="2.4"')]


def sym_source(L):
    c = L / 2
    return [line(0, 0, c - 14, 0), line(c + 14, 0, L, 0),
            '<circle cx="%.1f" cy="0" r="14" fill="#fff"/>' % c,
            line(c - 8, 0, c + 3, 0),
            '<polygon points="%.1f,0 %.1f,-4.5 %.1f,4.5" fill="%s"/>' % (c + 9, c + 2, c + 2, STROKE)]


def sym_box(L):
    c = L / 2
    return [line(0, 0, c - 18, 0), line(c + 18, 0, L, 0),
            '<rect x="%.1f" y="-8" width="36" height="16" fill="#fff"/>' % (c - 18)]


def sym_ground(x, y_len=None):
    """Ground symbol whose wire starts at local x (axis along +x)."""
    return [line(x, 0, x + 14, 0),
            line(x + 14, -11, x + 14, 11), line(x + 19, -7, x + 19, 7), line(x + 24, -3, x + 24, 3)]


def sym_capacitor(variable):
    """Shunt capacitor from a node (local x = 0) to ground, axis along +x."""
    out = [line(0, 0, 17, 0), line(17, -13, 17, 13, 'stroke-width="2.2"'),
           line(24, -13, 24, 13, 'stroke-width="2.2"'), line(24, 0, 40, 0)]
    out += sym_ground(40)
    if variable:
        out += [line(10, 17, 31, -17), '<polygon points="31,-17 24,-13 28,-8" fill="%s"/>' % STROKE]
    return out


SYMBOLS = {
    "resistor": sym_resistor, "inductor": sym_inductor, "orificeValve": sym_diode,
    "flowSource": sym_source,
}


def symbol_for(el):
    if el["type"] in SYMBOLS:
        return SYMBOLS[el["type"]]
    return {"flowSource": sym_source, "inertia": sym_inductor}.get(el["role"], sym_box)


# ---------------------------------------------------------------- helpers

def fmt(p):
    unit = p["unit"]
    v = p["value"]
    s = ("%g" % v)
    return "%s = %s%s" % (p["name"], s, (" " + unit) if unit else "")


def element_texts(el):
    """Name and one or two value lines for an element."""
    ps = el.get("params", [])
    if el["type"] == "orificeValve":
        keep = [p for p in ps if p["name"] in ("CQ", "R")]
    else:
        keep = ps[:1]
    return el["name"], [fmt(p) for p in keep]


def node_texts(part):
    ps = {p["name"]: p for p in part.get("params", [])}
    if part["type"] == "compliance" and "C" in ps:
        return part["name"], [fmt(ps["C"])]
    if "Emax" in ps:
        return part["name"], ["E = %g to %g %s" % (ps["Emin"]["value"], ps["Emax"]["value"], ps["Emax"]["unit"])]
    if part["type"] == "mixedChamber":
        return part["name"], ["chamber"]
    return part["name"], []


def text(x, y, s, size=11, weight="normal", anchor="middle", fill=STROKE):
    s = s.replace("&", "&amp;").replace("<", "&lt;")
    return '<text x="%.1f" y="%.1f" font-size="%d" font-weight="%s" text-anchor="%s" fill="%s">%s</text>' % (
        x, y, size, weight, anchor, fill, s)


# ---------------------------------------------------------------- graph

def build_graph(net):
    """Nodes and edges to draw. A fixed-pressure node (ground) is split so that
    every element that touches it gets its own ground symbol, as on a schematic."""
    nodes = {n["id"]: dict(n, ground_of=None) for n in net["nodes"]}
    edges = []
    nxt = max(nodes) + 1
    fixed = {i for i, n in nodes.items() if n["kind"] == "fixed"}
    for el in net["elements"]:
        ends = []
        for key in ("from", "to"):
            i = el[key]
            if i in fixed:
                gid = nxt
                nxt += 1
                nodes[gid] = {"id": gid, "kind": "fixed", "parts": nodes[i]["parts"], "ground_of": i}
                ends.append(gid)
            else:
                ends.append(i)
        edges.append({"el": el, "a": ends[0], "b": ends[1]})
    # a fixed node touched by no element (only possible if unused) is dropped
    used = {e["a"] for e in edges} | {e["b"] for e in edges}
    nodes = {i: n for i, n in nodes.items() if i in used or n["kind"] != "fixed"}
    for i in list(nodes):
        if nodes[i]["kind"] == "fixed" and nodes[i]["ground_of"] is None:
            del nodes[i]
    return nodes, edges


def has_cycle(nodes, edges):
    parent = {i: i for i in nodes}

    def find(a):
        while parent[a] != a:
            parent[a] = parent[parent[a]]
            a = parent[a]
        return a
    for e in edges:
        ra, rb = find(e["a"]), find(e["b"])
        if ra == rb:
            return True
        parent[ra] = rb
    return False


def layout_graphviz(nodes, edges, ring):
    if os.environ.get("CIRCULATION_NO_GRAPHVIZ"):      # to test the built-in layout
        return None
    engine = "circo" if ring else "dot"
    exe = shutil.which(engine) or shutil.which(engine, path="/opt/homebrew/bin:/usr/local/bin")
    if not exe:
        return None
    dot = ["graph G {", " node [shape=point];"]
    if not ring:
        dot.append(" rankdir=LR; nodesep=0.6; ranksep=1.0;")
    for e in edges:
        dot.append(' n%d -- n%d;' % (e["a"], e["b"]))
    for i in nodes:
        dot.append(" n%d;" % i)
    dot.append("}")
    try:
        out = subprocess.run([exe, "-Tplain"], input="\n".join(dot), capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    pos = {}
    for l in out.stdout.splitlines():
        p = l.split()
        if p and p[0] == "node":
            pos[int(p[1][1:])] = (float(p[2]) * 72.0, -float(p[3]) * 72.0)
    return pos if len(pos) == len(nodes) else None


def layout_simple(nodes, edges, ring):
    adj = {i: [] for i in nodes}
    for e in edges:
        adj[e["a"]].append(e["b"])
        adj[e["b"]].append(e["a"])
    start = min(nodes, key=lambda i: (len(adj[i]) != 1, i))
    order, seen, stack = [], set(), [start]
    while stack:
        i = stack.pop()
        if i in seen:
            continue
        seen.add(i)
        order.append(i)
        stack.extend(sorted(adj[i], reverse=True))
    order += [i for i in nodes if i not in seen]
    n = len(order)
    pos = {}
    for k, i in enumerate(order):
        if ring:
            a = 2 * math.pi * k / n
            pos[i] = (100.0 * n / (2 * math.pi) * math.cos(a), 100.0 * n / (2 * math.pi) * math.sin(a))
        else:
            pos[i] = (130.0 * k, 0.0)
    return pos


# ---------------------------------------------------------------- drawing

class Canvas:
    def __init__(self):
        self.items = []
        self.x0 = self.y0 = 1e9
        self.x1 = self.y1 = -1e9

    def track(self, x, y, pad=0):
        self.x0, self.y0 = min(self.x0, x - pad), min(self.y0, y - pad)
        self.x1, self.y1 = max(self.x1, x + pad), max(self.y1, y + pad)

    def add(self, s):
        self.items.append(s)

    def group(self, shapes, x, y, angle_deg, cls="sym"):
        self.add('<g class="%s" transform="translate(%.1f,%.1f) rotate(%.1f)">%s</g>' % (
            cls, x, y, angle_deg, "".join(shapes)))


def strip_shared_prefix(net):
    """If every element and part is inside one module (names 'heart.LV', 'heart.AV'
    ...) drop that prefix from the labels, which would otherwise repeat it."""
    names = [e["name"] for e in net["elements"]]
    firsts = {n.split(".", 1)[0] for n in names if "." in n}
    if len(firsts) == 1 and all("." in n for n in names):
        pre = firsts.pop() + "."
        for e in net["elements"]:
            e["name"] = e["name"][len(pre):]
        for n in net["nodes"]:
            for part in n["parts"]:
                if part["name"].startswith(pre):
                    part["name"] = part["name"][len(pre):]
    return net


def draw(net, layout="auto"):
    net = strip_shared_prefix(net)
    nodes, edges = build_graph(net)
    ring = (layout == "ring") or (layout == "auto" and has_cycle(nodes, edges))
    pos = layout_graphviz(nodes, edges, ring) or layout_simple(nodes, edges, ring)

    # scale so that no wire is shorter than a symbol plus its leads
    shortest = min(math.hypot(pos[e["a"]][0] - pos[e["b"]][0], pos[e["a"]][1] - pos[e["b"]][1]) for e in edges)
    scale = max(1.0, MIN_EDGE / shortest) if shortest > 1e-6 else 1.0
    pos = {i: (x * scale, y * scale) for i, (x, y) in pos.items()}

    cx = sum(p[0] for p in pos.values()) / len(pos)
    cy = sum(p[1] for p in pos.values()) / len(pos)

    def outward(p):
        if not ring:
            return (0.0, 1.0)
        d = (p[0] - cx, p[1] - cy)
        n = math.hypot(*d)
        return (d[0] / n, d[1] / n) if n > 1e-6 else (0.0, 1.0)

    cv = Canvas()

    # ---- elements
    seen_pair = {}
    for e in edges:
        a, b = pos[e["a"]], pos[e["b"]]
        key = tuple(sorted((e["a"], e["b"])))
        k = seen_pair.get(key, 0)
        seen_pair[key] = k + 1
        dx, dy = b[0] - a[0], b[1] - a[1]
        length = math.hypot(dx, dy)
        ux, uy = dx / length, dy / length
        nx, ny = -uy, ux
        off = 34.0 * ((k + 1) // 2) * (1 if k % 2 else -1)
        a = (a[0] + nx * off, a[1] + ny * off)
        b = (b[0] + nx * off, b[1] + ny * off)
        mx, my = (a[0] + b[0]) / 2, (a[1] + b[1]) / 2
        s0 = (mx - ux * LSYM / 2, my - uy * LSYM / 2)
        s1 = (mx + ux * LSYM / 2, my + uy * LSYM / 2)
        cv.add(line(a[0], a[1], s0[0], s0[1], 'class="wire"'))
        cv.add(line(s1[0], s1[1], b[0], b[1], 'class="wire"'))
        cv.group(symbol_for(e["el"])(LSYM), s0[0], s0[1], math.degrees(math.atan2(uy, ux)))

        # label on the side facing away from the middle of the drawing
        out = (nx, ny)
        mid_out = outward((mx, my)) if ring else (0.0, -1.0)
        if out[0] * mid_out[0] + out[1] * mid_out[1] < 0:
            out = (-nx, -ny)
        name, vals = element_texts(e["el"])
        lx, ly = mx + out[0] * 26, my + out[1] * 26
        anchor = "middle" if abs(out[0]) < 0.5 else ("start" if out[0] > 0 else "end")
        lines = [(name, 11, "bold")] + [(v, 10, "normal") for v in vals]
        if out[1] < 0:
            y_start = ly - 13 * (len(lines) - 1) - 4
        else:
            y_start = ly + 8
        for t, (s, size, w) in enumerate(lines):
            cv.add(text(lx + (8 if anchor == "start" else -8 if anchor == "end" else 0), y_start + 13 * t, s, size, w, anchor,
                        STROKE if w == "bold" else "#57606a"))
            cv.track(lx + (60 if anchor != "end" else 0), y_start + 13 * t, 70)
        cv.track(a[0], a[1], 20)
        cv.track(b[0], b[1], 20)

    # ---- node decorations
    for i, nd in nodes.items():
        p = pos[i]
        d = outward(p)
        ang = math.degrees(math.atan2(d[1], d[0]))
        decor = []
        if nd["kind"] == "fixed":
            part = nd["parts"][0] if nd["parts"] else {"type": "ground"}
            if part["type"] == "ground":
                # ground symbol: pointing away from the wire that arrives at this node
                nb = [e for e in edges if i in (e["a"], e["b"])][0]
                other = pos[nb["b"] if nb["a"] == i else nb["a"]]
                vx, vy = p[0] - other[0], p[1] - other[1]
                vn = math.hypot(vx, vy)
                if vn > 1e-6 and ring:
                    ang = math.degrees(math.atan2(vy, vx))
                elif not ring:
                    ang = 90.0
                cv.group(sym_ground(0), p[0], p[1], ang)
                cv.track(p[0], p[1], 40)
            else:
                cv.add('<circle cx="%.1f" cy="%.1f" r="12" fill="#fff" class="sym"/>' % p)
                cv.add(text(p[0], p[1] + 4, "~", 14))
                cv.add(text(p[0], p[1] + 28, part["name"], 11, "bold"))
        else:
            n_dec = 0
            for part in sorted(nd["parts"], key=lambda q: q["role"] == "port"):
                da = ang + (0 if n_dec == 0 else 70 * (1 if n_dec % 2 else -1))
                n_dec += 1
                if part["role"] == "storage":
                    variable = part["type"] in ("elastanceChamber", "mixedChamber")
                    cv.group(sym_capacitor(variable), p[0], p[1], da)
                    nm, vals = node_texts(part)
                    ex, ey = math.cos(math.radians(da)), math.sin(math.radians(da))
                    # label beyond the ground symbol, clear of the wires of the loop
                    bx, by = p[0] + ex * 82, p[1] + ey * 82
                    anchor = "middle" if abs(ex) < 0.45 else ("start" if ex > 0 else "end")
                    lines = [(nm, 11, "bold")] + [(v, 10, "normal") for v in vals]
                    if ey > 0.45:
                        y0 = by + 8
                    elif ey < -0.45:
                        y0 = by - 6 - 13 * (len(lines) - 1)
                    else:
                        y0 = by + 4 - 6.5 * (len(lines) - 1)
                    for t, (txt, size, w) in enumerate(lines):
                        cv.add(text(bx + (6 if anchor == "start" else -6 if anchor == "end" else 0), y0 + 13 * t, txt, size, w,
                                    anchor, STROKE if w == "bold" else "#57606a"))
                    cv.track(bx + (90 if anchor == "start" else -90 if anchor == "end" else 0), by, 60)
                    cv.track(p[0] + ex * 70, p[1] + ey * 70, 30)
                elif part["role"] == "port":
                    ex, ey = math.cos(math.radians(da)), math.sin(math.radians(da))
                    nbrs = [pos[e["b"] if e["a"] == i else e["a"]] for e in edges if i in (e["a"], e["b"])]
                    if len(nbrs) == 1:
                        # continue the wire away from the circuit
                        vx, vy = p[0] - nbrs[0][0], p[1] - nbrs[0][1]
                        vn = math.hypot(vx, vy)
                        ex, ey = vx / vn, vy / vn
                    elif not ring:
                        ex, ey = (0.0, -1.0)
                    bx, by = p[0] + ex * 64, p[1] + ey * 64
                    inlet = part.get("direction") == "inlet"
                    cv.add(line(p[0], p[1], bx - ex * 18, by - ey * 18, 'class="wire"'))
                    # arrow: flow enters the circuit at an outlet port, leaves it at an inlet
                    tip = (p[0] + ex * 14, p[1] + ey * 14) if not inlet else (bx - ex * 20, by - ey * 20)
                    base = (tip[0] + ex * 10 * (1 if not inlet else -1), tip[1] + ey * 10 * (1 if not inlet else -1))
                    if not inlet:
                        tip, base = (p[0] + ex * 14, p[1] + ey * 14), (p[0] + ex * 24, p[1] + ey * 24)
                    px, py = -ey * 4.5, ex * 4.5
                    cv.add('<polygon points="%.1f,%.1f %.1f,%.1f %.1f,%.1f" fill="%s"/>' % (
                        tip[0], tip[1], base[0] + px, base[1] + py, base[0] - px, base[1] - py, STROKE))
                    cv.add('<rect x="%.1f" y="%.1f" width="104" height="38" rx="7" fill="#dbeafe" stroke="#2563eb" stroke-width="1.6"/>' % (
                        bx - 52, by - 19))
                    cv.add(text(bx, by - 3, "CFD " + part.get("direction", "port"), 11, "bold"))
                    cv.add(text(bx, by + 11, "patch " + part.get("patch", ""), 10, "normal", "middle", "#1e3a8a"))
                    cv.track(bx, by, 70)
        cv.track(p[0], p[1], 30)

    # node dots
    deg = {i: 0 for i in nodes}
    for e in edges:
        deg[e["a"]] += 1
        deg[e["b"]] += 1
    for i, nd in nodes.items():
        if nd["kind"] != "fixed" and (deg[i] != 2 or nd["parts"]):
            cv.add('<circle cx="%.1f" cy="%.1f" r="3.6" fill="%s"/>' % (pos[i][0], pos[i][1], STROKE))

    return cv, ring


def legend(cv, x, y):
    items = [("resistor", sym_resistor, "resistor R"), ("inductor", sym_inductor, "inductor L"),
             ("diode", sym_diode, "valve"), ("source", sym_source, "flow source")]
    cv.add(text(x, y - 14, "Symbols", 11, "bold", "start"))
    for k, (_, fn, label) in enumerate(items):
        yy = y + 24 * k
        cv.group(fn(52), x, yy, 0)
        cv.add(text(x + 66, yy + 4, label, 10, "normal", "start", "#57606a"))
    y2 = y + 24 * len(items) + 14
    cv.group(sym_capacitor(False), x, y2, 0)
    cv.add(text(x + 90, y2 + 4, "compliance C: stores volume, to ground", 10, "normal", "start", "#57606a"))
    cv.group(sym_capacitor(True), x, y2 + 30, 0)
    cv.add(text(x + 90, y2 + 34, "heart chamber: elastance varies in time", 10, "normal", "start", "#57606a"))
    cv.add(text(x, y2 + 62, "Arrows: flow is positive in the direction a valve or source points.", 10, "normal", "start", "#57606a"))
    cv.track(x + 300, y2 + 70, 10)
    cv.track(x, y - 20, 10)


def render(net, layout="auto"):
    cv, ring = draw(net, layout)
    # legend below the drawing
    legend(cv, cv.x0 + 20, cv.y1 + 36)
    pad = 40
    w, h = cv.x1 - cv.x0 + 2 * pad, cv.y1 - cv.y0 + 2 * pad
    head = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="%.0f %.0f %.0f %.0f" width="%.0f" height="%.0f" '
            'font-family="%s">\n<style>.sym *, .wire {stroke:%s; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round}'
            ' .sym polygon, .sym circle, .sym rect {stroke-width:1.8} svg {background:#fff}</style>\n'
            '<rect x="%.0f" y="%.0f" width="%.0f" height="%.0f" fill="#fff"/>\n') % (
        cv.x0 - pad, cv.y0 - pad, w, h, w, h, FONT, STROKE, cv.x0 - pad, cv.y0 - pad, w, h)
    return head + "\n".join(cv.items) + "\n</svg>\n"


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    layout = "auto"
    for a in sys.argv[1:]:
        if a.startswith("--layout="):
            layout = a.split("=", 1)[1]
    if not args:
        print(__doc__)
        sys.exit(1)
    with open(args[0]) as f:
        net = json.load(f)
    out = args[1] if len(args) > 1 else os.path.splitext(args[0])[0] + ".svg"
    if not net["elements"]:
        sys.exit("the circuit has no two-terminal elements to draw")
    with open(out, "w") as f:
        f.write(render(net, layout))
    print("wrote", out)


if __name__ == "__main__":
    main()
