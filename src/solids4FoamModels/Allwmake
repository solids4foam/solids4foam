#!/bin/bash
cd "${0%/*}" || exit  # Run from this directory

# Parse arguments for library compilation
if [ -f "$WM_PROJECT_DIR"/wmake/scripts/AllwmakeParseArguments ]
then
    . "$WM_PROJECT_DIR"/wmake/scripts/AllwmakeParseArguments
fi

if [ "$WM_PROJECT" = "foam" ]
then
    if [[ ! -f Make/files ]]
    then
        echo "Linking Make/files.foamextend to Make/files"
        (cd Make && ln -s files.foamextend files)
    elif [ "$(readlink Make/files)" != "files.foamextend" ]
    then
        echo "Updating Make/files link to Make/files.foamextend"
        (cd Make && ln -sf files.foamextend files)
    fi
else
    if [[ ! -f Make/files ]]
    then
        echo "Linking Make/files.openfoam to Make/files"
        (cd Make && ln -sf files.openfoam files)
    elif [ "$(readlink Make/files)" != "files.openfoam" ]
    then
        echo "Updating Make/files link to Make/files.openfoam"
        (cd Make && ln -sf files.openfoam files)
    fi

    # OpenFOAM.org does not allow C-style comments in Make files
    if [[ $WM_PROJECT_VERSION != v* ]]
    then
        echo "Removing C-style comments from Make/files"
        awk '
            {
                # Remove inline /* ... */ comments
                gsub(/\/\*.*\*\//, "")
            }
            /\/\*/ { in_comment = 1 }
            !in_comment
            /\*\// { in_comment = 0 }
        ' Make/files.openfoam > tmpfile && mv tmpfile Make/files.openfoam
    fi
fi

# Validate PETSc and detect if its configuration has changed since the last
# build. Reusing objects compiled with different PETSc headers can cause a
# silent ABI mismatch, so clean before rebuilding when the state changes.
PETSC_STATE_FILE="Make/${WM_OPTIONS}/.petsc_state"
if ! CURRENT_PETSC_STATE="$(../../etc/check-petsc.sh)"
then
    exit 1
fi
CACHED_PETSC_STATE="$(cat "${PETSC_STATE_FILE}" 2>/dev/null || true)"
if [[ "${CURRENT_PETSC_STATE}" != "${CACHED_PETSC_STATE}" && -n "${CACHED_PETSC_STATE}" ]]; then
    echo "PETSc configuration changed since the last build."
    echo "Cleaning build to avoid stale object files..."
    wclean
fi

wmake $targetType libso

# Cache the current PETSC state for future incremental builds
if [[ -d "Make/${WM_OPTIONS}" ]]; then
    echo "${CURRENT_PETSC_STATE}" > "Make/${WM_OPTIONS}/.petsc_state"
fi
