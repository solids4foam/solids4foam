# Script
#     Allclean
#
# Description
#     Cleans tutorial directories by removing generated files,
#     log files, backup files, and other temporary artifacts.
#     Adapted from OpenFOAM tutorial cleaning utilities.
#
#------------------------------------------------------------------------------


echo "Cleaning backup and test files"

find . -type f \( -name "*~" -o -name "*.bak" \) -delete
find . -type f \( -name 'core' -o -name 'core.[1-9]*' \) -delete
find . -type f \( -name '*.pvs' -o -name '*.foam' \) -delete

find . -depth -type d -name regressionTests -exec rm -rf {} +

rm -f logs testLoopReport

echo ""

foamCleanTutorials -self

