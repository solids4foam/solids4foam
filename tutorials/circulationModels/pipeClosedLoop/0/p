FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 12;

boundaryField
{
    inlet
    {
        // Coupling scheme and order are chosen in constant/circulationProperties
        type            circulationPressure;
        value           uniform 12;
    }
    outlet
    {
        type            circulationPressure;
        value           uniform 12;
    }
    wall
    {
        type            zeroGradient;
    }
}
