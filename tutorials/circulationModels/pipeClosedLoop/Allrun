#!/bin/bash
# Demo: a CFD pipe in a closed circulation loop (both ends coupled).
# Runs on numberOfSubdomains ranks of system/decomposeParDict (1: serial, slow).
# Then:  python3 plotter.py
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source solids4Foam scripts (on macOS, this keeps the OpenFOAM libraries findable)
source solids4FoamScripts.sh

# The circulation models are currently only built for OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

np=$(solids4Foam::getNumberOfProcessors system/decomposeParDict)

solids4Foam::runApplication blockMesh || exit 1

solids4Foam::runApplication -s check circulationFoam -check || exit 1
echo "--- the circuit, as the program understood it ---"
sed -n '/ODE states/,/^Result/p' log.circulationFoam.check

echo "--- pimpleFoam on $np rank(s) (progress: tail -f log.pimpleFoam) ---"
if [ "$np" -gt 1 ]; then
    solids4Foam::runApplication decomposePar || exit 1
    solids4Foam::runParallel pimpleFoam || exit 1
else
    solids4Foam::runApplication pimpleFoam || exit 1
fi

echo "done: postProcessing/circulationCoupling/0/coupling.dat  (python3 plotter.py to plot)"
