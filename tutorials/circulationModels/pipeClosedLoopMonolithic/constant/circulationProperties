FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      circulationProperties;
}

// The closed-loop pipe circuit with the 3D pipe replaced by its rigid
// Poiseuille R-L surrogate, solved as one monolithic system. It has no
// partitioned-coupling error, so it is the reference the CFD-coupled
// ../pipeClosedLoop is judged against (the same role the exact solution plays
// for the Windkessel). Same circuit file as ../pipeClosedLoop, with the two
// coupling ports replaced by Rpipe and Lpipe.
//
//   C1 -R1-L1- C2 -R2- C3 -R3- atrium -mitral- ventricle -aortic(+R4)- C4 -pipe- C1

units       SI;
Tcycle      0.8;

components
{
    // ---- Arterial side, from the pipe outlet ------------------------------
    C1      { type compliance; C 1.500e-10; initialPressure 12720; }
    R1      { type resistor;   R 6.666e6; }
    L1      { type inductor;   L 5.333e5; }
    C2      { type compliance; C 1.500e-9; initialPressure 12720; }
    R2      { type resistor;   R 6.667e8; }
    C3      { type compliance; C 7.501e-9; initialPressure 12720; }
    R3      { type resistor;   R 1.200e7; }

    // ---- Heart ---------------------------------------------------------------
    atrium
    {
        type    mixedChamber;
        V0      1.000e-6;
        active  { E1 9.800e8; }
        passive { P0 22.66; K 4.840e5; }
        activation { type sineSquared; offset 0.544; duration 0.24; }
        initialVolume 1.4082870749878583e-05;
    }
    mitral  { type orificeValve; Rhat 5.333e10; }
    ventricle
    {
        type    mixedChamber;
        V0      4.000e-6;
        active  { E1 2.467e9; E2 -5.600e12; }
        passive { P0 120; K 6.200e4; }
        activation { type sineSquared; offset 0; duration 0.40; }
        initialVolume 7.9368207007450098e-05;
    }
    aortic  { type orificeValve; Rhat 5.333e9; R 1.200e7; }     // orifice in series with R4

    // ---- Pipe inlet side, and the pipe itself ----------------------------------
    C4      { type compliance; C 7.501e-10; initialPressure 12720; }
    Rpipe   { type resistor;   R 19098.5931424; }               // 8 mu L / (pi r^4)
    Lpipe   { type inductor;   L 253056.359516; }               // rho L / A
}

connections
(
    (C1 R1 L1 C2 R2 C3 R3 atrium mitral ventricle aortic C4 Rpipe Lpipe C1)
);

solver { type RKDP45; absTol 1e-20; relTol 1e-13; }
