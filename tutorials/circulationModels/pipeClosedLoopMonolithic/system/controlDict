FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     circulationFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2.4;            // three cardiac cycles
deltaT          1e-4;           // output interval; the ODE solver sub-steps

writeControl    runTime;
writeInterval   0.8;
