FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        // The coupling algorithm (explicit/implicit, order) is chosen in
        // constant/circulationProperties, not here.
        type            circulationPressure;
        value           uniform 0;
    }
    wall
    {
        type            zeroGradient;
    }
}

