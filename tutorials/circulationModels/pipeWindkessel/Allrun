#!/bin/bash
# Run one coupled case (pipe + Windkessel, implicit order 2, deltaT 0.05, serial, about a minute)
# and compare it with the exact solution.
# For other schemes, orders and time steps use ./runLadder (see README.md).
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source solids4Foam scripts (on macOS, this keeps the OpenFOAM libraries findable)
source solids4FoamScripts.sh

./runLadder "implicit" "2" "0.05" 1 || exit 1
python3 analyse.py
