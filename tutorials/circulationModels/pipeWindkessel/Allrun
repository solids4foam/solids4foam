#!/bin/bash
# A CFD pipe coupled to a Windkessel (explicit coupling, order 2, deltaT 0.05, serial, about a minute).
# Then, if python3 is available, compare with the exact solution.
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source solids4Foam scripts (on macOS, this keeps the OpenFOAM libraries findable)
source solids4FoamScripts.sh

# The circulation models are currently only built for OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

blockMesh > log.blockMesh 2>&1 || { echo "blockMesh failed, see log.blockMesh"; exit 1; }
pimpleFoam > log.pimpleFoam 2>&1 || { echo "pimpleFoam failed, see log.pimpleFoam"; exit 1; }
echo "done: postProcessing/circulationCoupling/0/coupling.dat"

if command -v python3 > /dev/null; then
    python3 analyse.py
else
    echo "python3 not found: skipping the comparison with the exact solution (analyse.py)"
fi
