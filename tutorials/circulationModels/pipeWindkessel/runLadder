#!/bin/bash
# Run a ladder of coupled pipe-Windkessel cases in parallel.
#   ./runLadder "<schemes>" "<orders>" "<dts>" [parallel jobs]
#   ./runLadder "explicit implicit" "1 2" "0.1 0.05 0.02 0.01 0.005" 8
# Each case is runs/<scheme>/<order>/<dt>: blockMesh, then pimpleFoam (serial).
cd "$(dirname "$0")" || exit 1
schemes=${1:-"explicit implicit"}; orders=${2:-"1 2"}; dts=${3:-"0.1 0.05 0.02 0.01"}; jobs=${4:-6}

. /Volumes/OpenFOAM/OpenFOAM-v2412/etc/bashrc >/dev/null 2>&1 || true

one() {
    dir=$(./makeCase "$1" "$2" "$3") || exit 1
    ( cd "$dir" && blockMesh > log.bm 2>&1 && pimpleFoam > log.run 2>&1 )
    echo "$dir exit=$?"
}
export -f one

for s in $schemes; do for o in $orders; do for d in $dts; do echo "$s $o $d"; done; done; done \
  | xargs -P "$jobs" -L 1 bash -c 'one $0 $1 $2'
