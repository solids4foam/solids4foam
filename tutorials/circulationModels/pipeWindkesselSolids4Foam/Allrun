#!/bin/bash
# The pipe of pipeWindkessel, solved by solids4Foam with the pimpleFluid fluid
# model instead of pimpleFoam, coupled to the same Windkessel.
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source solids4Foam scripts (on macOS, this keeps the OpenFOAM libraries findable)
source solids4FoamScripts.sh

# The circulation models are currently only built for OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

solids4Foam::runApplication blockMesh || exit 1
solids4Foam::runApplication solids4Foam || exit 1

echo "done: postProcessing/circulationCoupling/0/coupling.dat"

# The comparison with the exact solution, by the script of pipeWindkessel
analyse=../pipeWindkessel/analyse.py
if command -v python3 > /dev/null && [ -f "$analyse" ]; then
    python3 "$analyse" .
else
    echo "python3 or $analyse not found: skipping the comparison with the exact solution"
fi
