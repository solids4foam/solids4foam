# Nonlinear solver
-snes_type newtonls
-snes_linesearch_type l2
-snes_rtol 1e-4
-snes_stol 1e-4
-snes_monitor
-snes_converged_reason

# Calculate the Jacobian using matrix-free finite differencing
-snes_mf_operator

# Linear solver
-ksp_type lgmres
-ksp_gmres_restart 200
-ksp_rtol 1e-6
-ksp_converged_reason
-ksp_max_it 500

# Preconditioner - redundant LU (gathers to one proc for factoring)
-pc_type redundant
-redundant_pc_type lu
