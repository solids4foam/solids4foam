# Nonlinear solver
-snes_type newtonls
-snes_linesearch_type l2
-snes_rtol 1e-4
-snes_stol 1e-4
-snes_monitor
-snes_converged_reason

# Matrix-free Jacobian
-snes_mf_operator

# Linear solver with many iterations
-ksp_type lgmres
-ksp_gmres_restart 500
-ksp_rtol 1e-4
-ksp_converged_reason
-ksp_max_it 2000

# Jacobi preconditioner (works with MatNest directly, no conversion needed)
-pc_type jacobi
