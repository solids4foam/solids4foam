--- a/src/solids4FoamModels/fluidModels/pimpleFluid/pimpleFluid.esi.C
+++ b/src/solids4FoamModels/fluidModels/pimpleFluid/pimpleFluid.esi.C
@@ -360,6 +360,54 @@ tmp<vectorField> pimpleFluid::patchViscousForce(const label patchID) const
           & (-turbulence_->devReff()().boundaryField()[patchID])
         );
 
+    // TEMPORARY DIAGNOSTIC (3dTube platform investigation)
+    if (getenv("S4F_DEBUG_TRACTION"))
+    {
+        const tmp<volTensorField> tgU(fvc::grad(U()));
+        const tmp<volSymmTensorField> tdR(turbulence_->devReff());
+        const tmp<volScalarField> tnu(turbulence_->nuEff());
+        const vectorField nf(mesh().boundary()[patchID].nf());
+        const labelUList& fc = mesh().boundary()[patchID].faceCells();
+        // Same expression on a fresh devReff, held in a named variable
+        const symmTensorField dRb(tdR().boundaryField()[patchID]);
+        const vectorField again(rho_.value()*(nf & (-dRb)));
+        // Hand-written loop
+        vectorField byHand(nf.size());
+        forAll(byHand, i)
+        {
+            const vector& n = nf[i];
+            const symmTensor& d = dRb[i];
+            byHand[i] = -rho_.value()*vector
+            (
+                n.x()*d.xx() + n.y()*d.xy() + n.z()*d.xz(),
+                n.x()*d.xy() + n.y()*d.yy() + n.z()*d.yz(),
+                n.x()*d.xz() + n.y()*d.yz() + n.z()*d.zz()
+            );
+        }
+        Sout.precision(17);
+        Sout<< "DBGVF sums: native " << gSum(tvF()*mesh().boundary()[patchID].magSf())
+            << " again " << gSum(again*mesh().boundary()[patchID].magSf())
+            << " byHand " << gSum(byHand*mesh().boundary()[patchID].magSf())
+            << " max|native-byHand| " << gMax(mag(tvF() - byHand))
+            << " max|again-byHand| " << gMax(mag(again - byHand)) << nl;
+        for (label i = 0; i < min(3, nf.size()); ++i)
+        {
+            Sout<< "DBGVF face " << i << " cell " << fc[i]
+                << " nf " << nf[i] << nl
+                << "DBGVF   gradU_b " << tgU().boundaryField()[patchID][i] << nl
+                << "DBGVF   gradU_P " << tgU()[fc[i]] << nl
+                << "DBGVF   U_b " << U().boundaryField()[patchID][i]
+                << " U_P " << U()[fc[i]] << nl
+                << "DBGVF   snGrad " << U().boundaryField()[patchID].snGrad()()[i]
+                << nl
+                << "DBGVF   nuEff_b " << tnu().boundaryField()[patchID][i] << nl
+                << "DBGVF   devReff_b " << tdR().boundaryField()[patchID][i] << nl
+                << "DBGVF   devReff_P " << tdR()[fc[i]] << nl
+                << "DBGVF   vF " << tvF()[i] << nl;
+        }
+        Sout.precision(6);
+    }
+
     return tvF;
 }
 
