FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;
//startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20;

adjustTimeStep  yes;
logTimeStepAdjustments no;
//timeStepLogFile "timeStepLog.dat";

deltaT          0.001;
minDeltaT       1e-5;
maxDeltaT       0.1;

writeControl    runTime;

writeInterval   0.01;

//purgeWrite      100;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

#include "./system/functions"

