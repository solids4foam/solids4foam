FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     solids4Foam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2;
deltaT          1e-3;
writeControl    timeStep;
writeInterval   100000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   8;
runTimeModifiable no;
adjustTimeStep  no;

functions
{
    pointDisp
    {
        type    solidPointDisplacement;
        point   (0.6 0.2 0.0075);
    }
}
