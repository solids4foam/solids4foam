#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Example usage:
# ./Allrun                     -> partitioned (IQNILS), serial
# ./Allrun aitken              -> partitioned (Aitken), serial
# ./Allrun monolithic          -> monolithic (Newton/PETSc), serial
# ./Allrun monolithic parallel -> monolithic (Newton/PETSc), parallel
# ./Allrun aitken parallel     -> partitioned (Aitken), parallel

coupling=iqnils
runMode=serial
fvSolutionSuffix=""
SOLVER="partitioned"

for arg in "$@"
do
    case "$arg" in
        aitken|Aitken)
            coupling=aitken
            SOLVER="partitioned"
            ;;
        iqnils|IQNILS)
            coupling=iqnils
            SOLVER="partitioned"
            ;;
        monolithic)
            SOLVER="monolithic"
            ;;
        parallel)
            runMode=parallel
            ;;
        *)
            echo "Unknown option: $arg"
            echo "Usage: ./Allrun [aitken|iqnils|monolithic] [parallel]"
            exit 1
            ;;
    esac
done

# Source solids4Foam scripts
source solids4FoamScripts.sh

if [[ "$SOLVER" == "monolithic" ]]; then
    solids4Foam::caseDoesNotRunWithFoamExtend
    echo "Using the monolithic Newton/PETSc approach"
    solids4Foam::convertCaseFormat .
    for file in $(find ./0 ./constant ./system -name '*.monolithic')
    do
        ln -vnsf ${file##*/} ${file%.*}
    done
else
    # Dirichlet-Neumann partitioned approach
    if [[ -n "${FOAMEXTEND:-}" || "${WM_PROJECT_VERSION:-}" == "4.1" ]]; then
        fvSolutionSuffix=".foamextend"
    elif [[ "${WM_PROJECT_VERSION:-}" != *"v"* ]]; then
        fvSolutionSuffix=".openfoamorg"
    fi

    echo "Using ${coupling} coupling setup"

    ln -vnsf "fsiProperties.${coupling}" constant/fsiProperties
    ln -vnsf "solidProperties.${coupling}" constant/solid/solidProperties
    ln -vnsf "controlDict.${coupling}" system/controlDict
    ln -vnsf "fvSolution.${coupling}${fvSolutionSuffix}" system/fluid/fvSolution

    solids4Foam::convertCaseFormat .
fi

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Run solver
if [[ "$runMode" == "parallel" ]]; then
    # Run parallel
    solids4Foam::runApplication -s fluid decomposePar -region fluid
    solids4Foam::runApplication -s solid decomposePar -region solid
    solids4Foam::runParallel solids4Foam
    solids4Foam::runApplication -s fluid reconstructPar -region fluid
    solids4Foam::runApplication -s solid reconstructPar -region solid
else
    # Run serial
    solids4Foam::runApplication solids4Foam
fi

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating deflection.pdf using gnuplot"
    gnuplot deflection.gnuplot &> /dev/null
    if [ $(find . -name forces.dat | wc -l) -eq 1 ]
    then
        echo "Generating force.pdf using gnuplot"
        gnuplot force.gnuplot &> /dev/null
    fi
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
