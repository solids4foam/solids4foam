FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh dynamicMotionSolverFvMesh;

// Displacement-based mesh motion: the mesh for a given interface position does
// not depend on how the interface got there
"solver|motionSolver" displacementLaplacian;

diffusivity quadratic inverseDistance (interface);

