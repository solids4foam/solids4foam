FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh dynamicMotionSolverFvMesh;

// Mesh motion by a solids4foam solid model, solved on the static reference
// copy of the fluid mesh in the fluidMeshMotion region
"solver|motionSolver" solids4foamSolidModel;

regionName fluidMeshMotion;

// Stiffness scale factor for the diffusionElastic and diffusionHyperElastic
// laws: the mesh is stiffer near the interface
diffusivity quadratic inverseDistance (interface);

// ************************************************************************* //
