FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Small strain mesh motion with the diffusionElastic law
solidModel     meshMotionTotalDisplacement;

meshMotionTotalDisplacementCoeffs
{
    // Maximum number of momentum correctors
    nCorrectors     1000;

    // Relative residual tolerance for each mesh motion solve. Tolerances of
    // 1e-6, 1e-4 and 1e-3 give the same beam response to six significant
    // figures; 1e-4 retains an order of magnitude of margin and costs about
    // 25% less than 1e-6
    rTol            1e-04;

    // Write frequency for the residuals
    infoFrequency   100;
}

