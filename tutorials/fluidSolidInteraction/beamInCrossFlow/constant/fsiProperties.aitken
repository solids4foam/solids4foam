FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//fluidSolidInterface    fixedRelaxation;
fluidSolidInterface    Aitken;
//fluidSolidInterface    IQNILS;

"fixedRelaxationCoeffs|AitkenCoeffs|IQNILSCoeffs"
{
    // Interface patches
    solidPatch interface;
    fluidPatch interface;

    // Predictors at the start of a new time step
    predictor            yes;
    predictSolid         yes;

    // Under-relaxation factor for passing the solid interface
    // displacement/velocity to the fluid interface
    // The first iteration of each time-step is not relaxed with predictor
    // yes, the default
    // For fixedRelaxation, this value is used for all other iterations
    // For Aitken, this value is used for the second iteration each
    // time-step, then it adaptively changes
    // For IQNILS, this value is used for the second iteration each
    // time-step, then the IQNILS procedure is used
    relaxationFactor 0.1;

    // Tolerance for the FSI loop within each time-step. Both normalized
    // interface residual measures must fall below it
    // (requireAllResidualMeasures). Near the steady state the relative
    // measure can no longer be reduced below about 1e-6, so 1e-5 is used; the
    // verification study (verification/README.md, finding 5) shows that
    // tolerances from 1e-4 to 1e-6 change u_x(A) and F_x by at most 2e-6
    outerCorrTolerance 1e-5;

    // Maximum number of outer FSI loop correctors within each time-step
    nOuterCorr 30;

    // Continue with a warning, instead of stopping, if a time-step reaches
    // nOuterCorr; such steps are reported in the log
    allowUnconvergedCoupling yes;

    // Require both normalized interface residual measures to converge.  The
    // legacy minimum test can accept a small update relative to the total
    // displacement while the current-step residual is still unresolved.
    requireAllResidualMeasures yes;

    // Enable/disable coupling from the start
    coupled yes;

    // Method for transferring information between the interfaces
    interfaceTransferMethod directMap;

    // Write fsi residuals to file
    writeResidualsToFile yes;
}

// ************************************************************************* //
