FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            zeroGradient;
        //type            fixedGradientCorrected;
        //gradient        uniform 0;
    }

    right
    {
        type            fixedValue;
        // type            fixedValueCorrected;
        value           uniform 0;
    }

    up
    {
        type            zeroGradient;
        //type            fixedGradientCorrected;
        //gradient        uniform 0;
    }

    cylinder
    {
        type            zeroGradient;
        //type            fixedGradientCorrected;
        //gradient        uniform 0;
    }

    down
    {
        type            symmetryPlane;
    }

    frontAndBack
    {
        type            empty;
    }

    defaultFaces
    {
        type            empty;
    }
}

