FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    IQNILS;

"fixedRelaxationCoeffs|AitkenCoeffs|IQNILSCoeffs"
{
    // Solid interface patch list
    solidPatch      interface;

    // Fluid interface patch list
    fluidPatch      interface;

    // Under-relaxation factor for the first two iterations of each time step,
    // after which the IQN-ILS update is used
    relaxationFactor 0.05;

    // Tolerance for the FSI loop within each time step
    outerCorrTolerance 1e-6;

    // Maximum number of outer FSI loop correctors within each time step
    nOuterCorr      100;

    // Enable coupling from the start
    coupled         yes;

    // Method for transferring information between the interfaces
    interfaceTransferMethod directMap;

    // Extrapolate the interface motion and the solid solution at the start
    // of each time step; without the predictor, the first IQN-ILS iterate
    // sees an added-mass spike, as the solid and fluid densities are equal
    predictor       yes;
    predictSolid    yes;

    // Move the fluid interface onto the solid interface at the end of each
    // time step, so that interface position errors do not accumulate
    additionalMeshCorrection yes;

    // Write FSI residuals to file
    writeResidualsToFile yes;
}

