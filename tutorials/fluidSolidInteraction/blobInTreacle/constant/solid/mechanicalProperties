FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
(
    rubber
    {
        // Neo-Hookean with the small-strain Lame constants of Liu et al.
        // (2014), lambda = 500 Pa and mu = 50 Pa, i.e.
        // E = mu*(3*lambda + 2*mu)/(lambda + mu) and
        // nu = lambda/(2*(lambda + mu)) in plane strain. St Venant-Kirchhoff
        // is not used: it softens in compression, and the half cylinder
        // collapses under the flow at t = 1.8 s
        type            neoHookeanElastic;
        rho             rho [1 -3 0 0 0 0 0] 1;
        E               E [1 -1 -2 0 0 0 0] 145.45454545;
        nu              nu [0 0 0 0 0 0 0] 0.45454545;
    }
);

