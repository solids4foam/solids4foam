FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The case uses a finite-strain solid: Liu et al. (2014) use a small-strain
// linear elastic solid, but the deformation is large, and a small-strain solid
// integrates the fluid traction over its undeformed surface, so it receives
// about 12% less force than the fluid exerts. The neo-Hookean law with the same
// Lame constants reduces to their model for small strains
solidModel      nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Maximum number of momentum correctors
    nCorrectors     1000;

    // Solution tolerance for displacement
    solutionTolerance 1e-9;

    // Alternative solution tolerance for displacement
    alternativeTolerance 1e-9;
}

