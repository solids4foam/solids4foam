FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p|pFinal"
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0;
        minIter         1;
        maxIter         1000;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        scaleCorrection true;
        directSolveCoarsest false;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    cellMotionU
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0;
        minIter         1;
        maxIter         100;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        scaleCorrection true;
        directSolveCoarsest false;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "U|UFinal"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0;
        minIter         1;
    }
}

PIMPLE
{
    // A few under-relaxed outer correctors per FSI iteration keep the fluid
    // response consistent between FSI iterations. With a single corrector,
    // the IQN-ILS coupling stagnates on the refined meshes of the
    // verification study, where the viscous number nu*deltaT/dx^2 is large.
    momentumPredictor   on;
    nOuterCorrectors    5;
    nCorrectors         3;
    nNonOrthogonalCorrectors 1;

    residualControl
    {
        "U|p"
        {
            tolerance   1e-7;
            relTol      0;
        }
    }
}

relaxationFactors
{
    fields
    {
        p       0.5;
        pFinal  1;
    }
    equations
    {
        U       0.9;
        UFinal  1;
    }
}

