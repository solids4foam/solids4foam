FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    tail
    {
        // Set by the monolithic coupling
        type            fixedValue;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    inlet
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0        (0.315 1e-4 0))
            (0.1      (0.315 1e-4 0))
            (0.100001 (0.315 0 0))
            (10       (0.315 0 0))
        );
    }
    rigidBlock
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            slip;
    }
    top
    {
        type            slip;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
}

// ************************************************************************* //
