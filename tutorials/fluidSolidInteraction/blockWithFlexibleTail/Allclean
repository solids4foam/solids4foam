#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase
cleanCase fluid
cleanCase solid
rm -rf case.foam residuals deflection.pdf postProcessing

# Restore the stored case format and partitioned variant.
solids4Foam::restoreCaseFormat .
solids4Foam::restoreCaseVariant .

ln -vnsf fsiProperties.iqnils constant/fsiProperties
ln -vnsf U.dirichletNeumann 0/fluid/U
ln -vnsf p.dirichletNeumann 0/fluid/p
