FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/solid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver petsc;

        options
        {
            // Nonlinear solver
            snes_type newtonls;
            snes_linesearch_type basic;
            // Resolve solid corrections below the FSI coupling tolerance
            snes_rtol "1e-8";
            snes_atol "1e-12";
            snes_stol "1e-9";
            snes_max_it "100";
            snes_divergence_tolerance "1e12";
            snes_monitor;
            snes_converged_reason;

            // Matrix-free finite-difference Jacobian, preconditioned by the
            // assembled Jacobian of the least-squares reconstruction
            snes_mf_operator;

            // Linear solver
            ksp_type lgmres;
            ksp_gmres_restart "100";
            ksp_rtol "1e-4";
            ksp_max_it "1000";
            ksp_converged_reason;

            // Rebuild the partition-local LU preconditioner as the highly
            // flexible tail changes configuration
            pc_type bjacobi;
            sub_pc_type lu;
        }
    }
}

// ************************************************************************* //
