FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Keep this top-level processor count consistent with the region
// decomposeParDicts because the parallel tutorial wrapper uses it to choose
// the MPI size for the monolithic run.

numberOfSubdomains 4;

