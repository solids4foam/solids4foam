FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "Outlet[1-4]"
    {
        type        fixedValue;
        value       uniform 0;
    }
    "Inlet[1-2]"
    {
        type        zeroGradient;
    }
    "Wall"
    {
        // Dirichlet-Neumann approach
        // type        movingWallPressure;
        // value       uniform 0;

        // Robin-Neumann condition approach
        type        elasticWallPressure;
        constantHs  3e-4;
        value       uniform 0;
    }
}

