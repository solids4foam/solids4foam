FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
  processor
    {
      type processor;
    }

    "Inlet[1-2]"
    {
      type              fixedValue;//slip;//fixedValue;
        value           uniform (0 0 0);
    }
    "Outlet[1-4]"
    {
      type              fixedValue;//slip;//fixedValue;
        value           uniform (0 0 0);
    }
    innerWall
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    outerWall
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}

