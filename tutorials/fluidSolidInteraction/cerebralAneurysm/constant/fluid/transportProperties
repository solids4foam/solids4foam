FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      flowProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// CIBM: incompressible Newtonian blood, rho=1050 kg/m3 and mu=0.0035 Pa s.
nu              nu [0 2 -1 0 0 0 0] 3.333333333e-6;
rho             rho [1 -3 0 0 0 0 0] 1050;

// The dynamic viscosity is used only for sonicLiquidFluid
mu              mu [1 -1 -1 0 0 0 0] 3.5e-3;

// For piso/transientSimple
transportModel  Newtonian;

BirdCarreauCoeffs
{
    nu0   0.000151;
    nuInf 3.3e-6;
    k     8.2;
    n     0.2128;
    a     0.64;
}

