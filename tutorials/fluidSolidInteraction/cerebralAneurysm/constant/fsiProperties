FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    fixedRelaxation;

fixedRelaxationCoeffs
{
    // Solid interface patch
    solidPatch             innerWall;

    // Fluid interface patch
    fluidPatch             wall;

    // Interface relaxation factor
    // Note: it is often fine to keep this at 1.0 when using the Robin condition
    // for 0/fluid/p, where the Robin acceleration can be controlled via the
    // `constantHs` parameter there
    relaxationFactor       1.0;

    // FSI outer loop tolerance
    outerCorrTolerance     5e-5;

    // Robin residual tolerances. Convergence of the Robin-Neumann coupling
    // also requires the normalised interface-pressure change and the
    // interface leakage to fall below these tolerances. The default for both
    // is 10*outerCorrTolerance, i.e. 5e-4 here. 1e-3 is loosened slightly
    // further because the leakage residual is the measure that blocks the
    // last corrector once the flow has settled: over the first 2000 time
    // steps it needs 2.48 FSI correctors per time step against 2.87 with the
    // defaults, and over the full cardiac cycle it averages 1.3 (77% of the
    // steps converge in a single corrector), while the interface
    // displacement and force stay within the regression tolerances
    robinPressureTolerance 1e-3;
    robinFluxTolerance     1e-3;

    // Maximum FSI correctors per time step
    nOuterCorr             30;

    // Write FSI residuals to file
    writeResidualsToFile   yes;
}


