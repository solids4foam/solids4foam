FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    fixedRelaxation;

fixedRelaxationCoeffs
{
    // Solid interface patch
    solidPatch             innerWall;

    // Fluid interface patch
    fluidPatch             wall;

    // Interface relaxation factor
    // Note: it is often fine to keep this at 1.0 when using the Robin condition
    // for 0/fluid/p, where the Robin acceleration can be controlled via the
    // `constantHs` parameter there
    relaxationFactor       1.0;

    // FSI outer loop tolerance
    outerCorrTolerance     5e-5;

    // Maximum FSI correctors per time step
    nOuterCorr             30;

    // Write FSI residuals to file
    writeResidualsToFile   yes;
}


