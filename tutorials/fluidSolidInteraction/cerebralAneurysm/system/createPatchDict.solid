FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name outerWall;
        patchInfo
        {
            type wall;
        }
        constructFrom patches;
        patches (Wall);
    }
);

