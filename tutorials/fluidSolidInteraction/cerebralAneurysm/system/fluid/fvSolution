FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p|pFinal|pcorr|pcorrFinal"
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          1e-03;
        minIter         1;
        maxIter         1000;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        scaleCorrection true;
        directSolveCoarsest false;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    cellMotionU
    {
        solver          GAMG;
        tolerance       1e-09;
        relTol          0.001;
        minIter         1;
        maxIter         100;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        scaleCorrection true;
        directSolveCoarsest false;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "U|UFinal"
    {
      solver           smoothSolver;//PBiCG;
      smoother         symGaussSeidel;
      //preconditioner   DILU;
        tolerance       1e-06;
        relTol          0.001;
        minIter         1;
    }

        "(kt|omega|kl)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-04;
        relTol          0.1;
    }

              omegaFinal
      {
        solver          smoothSolver;
        smoother        symGaussSeidel;
	tolerance       1e-04;
          relTol          0;
      }

	  klFinal
	  {
        solver          smoothSolver;
        smoother        symGaussSeidel;
	tolerance       1e-04;
          relTol          0;
      }

     ktFinal
     {
        solver          smoothSolver;
        smoother        symGaussSeidel;
	tolerance       1e-04;
          relTol          0;
      }

    // In sonicLiquidFluid, the continuity equation is solved explicitly and
    // corrected in each time-step, so the choice of solver here is actually
    // irrelevant, it is only needed so some OpenFOAM variants do not complain
    "rho|rhoFinal"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors            20;
    nCorrectors                 3;
    nNonOrthogonalCorrectors    1;

    residualControl
    {
        U
        {
            relTol    1e-4;
            tolerance 1e-4;
        }
    }
}

