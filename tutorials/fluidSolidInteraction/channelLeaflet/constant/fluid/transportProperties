FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Re = U a / nu = 200 with a mean velocity U = 1 m/s (at the minimum flux)
// and channel height a = 1 m
transportModel  Newtonian;

nu              nu [0 2 -1 0 0 0 0] 0.005;

rho             rho [1 -3 0 0 0 0 0] 1;

