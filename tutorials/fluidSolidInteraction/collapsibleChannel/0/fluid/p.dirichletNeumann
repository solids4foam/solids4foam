FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Allrun sets this to the kinematic pressure of the steady Poiseuille flow,
// 12 nu (25 - x), with the inlet pressure 12 nu L that drives it, using the
// setPoiseuilleFlow utility
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 6;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    walls
    {
        type            zeroGradient;
    }
    interface
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

