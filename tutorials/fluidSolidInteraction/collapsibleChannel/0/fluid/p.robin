FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Kinematic pressure of the steady Poiseuille flow, 12 nu (25 - x), with the
// inlet pressure 12 nu L that drives it
internalField   #codeStream
{
    codeInclude
    #{
        #include "fvCFD.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude
    #};

    codeLibs
    #{
        -lmeshTools \
        -lfiniteVolume
    #};

    code
    #{
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());
        scalarField p(mesh.nCells(), 0.0);
        forAll(p, cellI)
        {
            p[cellI] = 0.24*(25.0 - mesh.C()[cellI].x());
        }
        p.writeEntry("", os);
    #};
};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 6;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    walls
    {
        type            zeroGradient;
    }
    interface
    {
        // Robin condition; the coefficient rho_s*hs uses the default
        // secant model, which needs a nonzero wall density
        type            elasticWallPressure;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
