#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Example usage
# ./Allrun            # IQN-ILS coupling, high-order solid (cubic)
# ./Allrun linear     # second-order solid: linear reconstruction
# ./Allrun robin      # Robin-Neumann coupling
# ./Allrun robin linear
# ./Allrun monolithic # quasi-monolithic Newton coupling (OpenFOAM.com only),
#                     # with its own velocity-based solid (the linear option
#                     # does not apply)
# The case runs in serial: see the README

# PETSc is required for this case
solids4Foam::requirePetscOrExitSilently

solidVariant=highOrder
coupling=iqnils
interfaceCondition=dirichletNeumann

for arg in "$@"
do
    case "$arg" in
        linear)
            solidVariant="$arg"
            ;;
        robin)
            coupling=robin
            interfaceCondition=robin
            ;;
        monolithic|Monolithic)
            coupling=monolithic
            interfaceCondition=dirichletNeumann
            ;;
        *)
            echo "Unknown option: $arg"
            echo "Usage: ./Allrun [linear] [robin|monolithic]"
            exit 1
            ;;
    esac
done

if [[ "${coupling}" == "monolithic" ]]; then
    # The quasi-monolithic Newton approach requires PETSc and is only
    # implemented for OpenFOAM.com; its files are stored as *.monolithic
    # variants
    solids4Foam::caseDoesNotRunWithFoamExtend
    solids4Foam::caseDoesNotRunWithOpenFOAMOrg
fi

# Start from the stored case
solids4Foam::restoreCaseVariant .

ln -vnsf "solidProperties.${solidVariant}" constant/solid/solidProperties
ln -vnsf "fvSolution.${solidVariant}" system/solid/fvSolution
rm -f 0/fluid/U 0/fluid/p
if [[ "${coupling}" == "monolithic" ]]; then
    # Replaces the solid, fsiProperties and solver settings links made above
    solids4Foam::selectCaseVariant . monolithic
    fluidVelocity=monolithic
    fluidPressure=monolithic
else
    ln -vnsf "fsiProperties.${coupling}" constant/fsiProperties
    fluidVelocity="${interfaceCondition}"
    fluidPressure="${interfaceCondition}"
fi
# Copied rather than linked, as setPoiseuilleFlow writes the initial fields
rm -f 0/fluid/U 0/fluid/p
cp "0/fluid/U.${fluidVelocity}" 0/fluid/U
cp "0/fluid/p.${fluidPressure}" 0/fluid/p

# Build the utility that sets the initial Poiseuille flow; stop if it does
# not build, rather than running the solver without the initial flow (set
# SOLIDS4FOAM_ROOT when the case is copied outside the solids4foam tree)
if ! wmake setPoiseuilleFlow
then
    echo "ERROR: setPoiseuilleFlow did not build; set SOLIDS4FOAM_ROOT" 1>&2
    exit 1
fi

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Start the fluid from the steady Poiseuille flow
solids4Foam::runApplication setPoiseuilleFlow -region fluid

# Run solver
solids4Foam::runApplication solids4Foam

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating deflection.pdf using gnuplot"
    gnuplot deflection.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
