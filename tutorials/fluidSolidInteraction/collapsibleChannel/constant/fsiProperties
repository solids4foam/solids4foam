FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    IQNILS;

IQNILSCoeffs
{
    // Interface patches
    solidPatch interface;
    fluidPatch interface;

    // Extrapolate the interface at the start of each time step: without the
    // predictor the first iterate of each time step carries an added-mass
    // spike
    predictor            yes;

    // Do not solve the solid with the old fluid load before the first fluid
    // solve: the wall is massless, so that solid solution jumps straight to
    // the new external pressure, and passing it to the fluid unrelaxed gives
    // an added-mass pressure some thirty times the external pressure
    predictSolid         no;

    // Under-relaxation factor for the first two iterations of each time step.
    // The massless wall is only held back by the added mass of the fluid, so
    // the factor must be small: roughly the ratio of the wall stiffness to the
    // added mass over the time step squared
    relaxationFactor 0.005;

    // Tolerance for the FSI loop within each time-step: the interface
    // residual relative to the largest interface displacement, 1e-4 of which
    // is about 2e-5 m. Much tighter tolerances reach the round-off floor of the
    // solid residual on the smaller time steps
    outerCorrTolerance 1e-4;

    // Maximum number of outer FSI loop correctors within each time-step
    nOuterCorr 100;

    // Enable coupling from the start
    coupled yes;

    // The fluid and solid interface faces match
    interfaceTransferMethod directMap;

    // Drop secant modes that are small relative to the newest one: with the
    // strong added-mass effect the older modes of a time step are nearly
    // parallel, and keeping them lets round-off in the fluid and solid
    // solutions blow up the least-squares update
    relMinSignificant 1e-2;

    // Re-use the secant modes of the previous three time steps
    couplingReuse 3;

    // Write fsi residuals to file
    writeResidualsToFile yes;
}

