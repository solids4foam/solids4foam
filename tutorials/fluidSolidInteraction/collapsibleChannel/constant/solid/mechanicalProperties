FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

// St Venant-Kirchhoff wall: the second Piola-Kirchhoff stress is linear in
// the Green strain, as in the reference Kirchhoff-Love beam. In plane strain
// the wall's axial and bending stiffness follow from E/(1 - nu^2) = 5e8 Pa
mechanical
(
    wall
    {
        type            StVenantKirchhoffElastic;
        rho             rho [1 -3 0 0 0 0 0] 1;
        E               E [1 -1 -2 0 0 0 0] 4.55e8;
        nu              nu [0 0 0 0 0 0 0] 0.3;
    }
);

