FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Jacobian-free Newton-Krylov solution with PETSc SNES (options in
    // system/solid/fvSolution)
    solutionAlgorithm PETScSNES;

    // The massless (steady-state) wall cannot use the solid predictor; the
    // FSI predictor in fsiProperties extrapolates the interface instead
    predictor no;

    // Linear least-squares reconstruction of the residual: the same
    // high-order machinery as solidProperties.highOrder at polynomial order 1,
    // i.e. a second-order finite-volume discretisation
    highOrderCoeffs
    {
        highOrderResidual true;

        // Precondition with the assembled high-order Jacobian: the compact
        // approximation is too poor a preconditioner for the thin wall
        highOrderJacobian true;
        displacement
        {
            polynomialOrder 1;
            faceStencilExtraCells 15;
            weightFunctionCoeffs
            {
                type radiallySymmetricExponential;
                k 6;
            }
            calcConditionNumber false;
        }
    }

    stabilisation
    {
        momentum
        {
            type        alpha;
            scaleFactor 0.1;
        }
    }
}

// ************************************************************************* //
