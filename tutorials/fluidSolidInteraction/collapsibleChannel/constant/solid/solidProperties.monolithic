FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Velocity-based total-Lagrangian solid for the quasi-monolithic coupling,
// with the same St Venant-Kirchhoff wall as the partitioned set-up. The
// high-order residual of the partitioned solid is not available here
solidModel      nonLinearGeometryTotalLagrangianVelocity;

nonLinearGeometryTotalLagrangianVelocityCoeffs
{

    // Stabilisation
    stabilisation
    {
        momentum
        {
            type            diffStencilLaplacian;
            scaleFactor     0.1;
        }
    }
}

// ************************************************************************* //
