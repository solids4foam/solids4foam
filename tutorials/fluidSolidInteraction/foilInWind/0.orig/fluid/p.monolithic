FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    flag
    {
        // The normal gradient is set by the coupling from the normal
        // momentum equation at the moving wall
        type            fixedGradient;
        gradient        uniform 0;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    inlet
    {
        type         zeroGradient;
    }
    walls
    {
        type         zeroGradient;
    }
    block
    {
        type         zeroGradient;
    }
}

// ************************************************************************* //
