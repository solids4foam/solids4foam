#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase0
if [[ $WM_PROJECT = "foam" ]]; then
    foamClearPolyMesh -region fluid
    foamClearPolyMesh -region solid
elif [[ $WM_PROJECT_VERSION == v* ]]; then
    foamCleanPolyMesh -region fluid
    foamCleanPolyMesh -region solid
fi

rm -rf case.foam force.pdf deflection.pdf postProcessing \
    constant/fluid/polyMesh/sets

# Restore the stored case format and the default (IQNILS) variant
solids4Foam::restoreCaseFormat .
solids4Foam::restoreCaseVariant .

# Remove the empty mesh directories left by foamCleanPolyMesh
rmdir constant/fluid/polyMesh constant/solid/polyMesh 2> /dev/null || true
