FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// X locations
x2 6;
x3 10;

// Y locations
y2 5.47;
y3 5.53;

// Z locations (4 planes)
z1 4;
z2 7;

// Mesh parameters
// Number of cells
nx3 32;
ny3 6;
nz2 24;

// All dimensions are in cm
scale 0.01;

vertices
(
    ($x2 $y2 $z1)
    ($x3 $y2 $z1)
    ($x3 $y3 $z1)
    ($x2 $y3 $z1)

    ($x2 $y2 $z2)
    ($x3 $y2 $z2)
    ($x3 $y3 $z2)
    ($x2 $y3 $z2)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx3 $ny3 $nz2) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    interface
    {
        type patch;
        faces
        (
            (3 2 1 0)
            (4 5 6 7)
            (0 1 5 4)
            (2 3 7 6)
            (1 2 6 5)
        );
    }

    fixed
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
);

mergePatchPairs
(
);

