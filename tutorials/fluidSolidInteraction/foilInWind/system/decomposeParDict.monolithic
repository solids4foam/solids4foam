FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 4;

method          scotch;

monolithicCoeffs
{
    regions (fluid solid);

    // Optional per-region cell weights
    // DOF-based: fluid has 4 DOFs/cell (p,Ux,Uy,Uz), solid has 3 (Dx,Dy,Dz)
    regionWeights
    {
        fluid   4;
        solid   3;
    }

    interfaces
    (
        {
            regionA     fluid;
            patchA      flag;
            regionB     solid;
            patchB      interface;
        }
    );
}

// ************************************************************************* //
