FoamFile
{
    version     2.0;
    format      ascii;
    class       uniformDimensionedVectorField;
    location    "constant";
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The fluid is solved without gravity: the hydrostatic pressure rho_f*g.x is
// absorbed into the (kinematic) pressure, as in the change of variables of
// Hessenthaler, Roehrle and Nordsletten (2017), and the resulting buoyancy of
// the flap is applied to the solid instead (see constant/solid/g)
dimensions      [0 1 -2 0 0 0 0];
value           (0 0 0);

