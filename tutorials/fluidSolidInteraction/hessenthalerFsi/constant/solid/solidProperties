FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Total Lagrangian form with the standard (second-order) discretisation
// (see README.md)
solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Solution algorithm
    solutionAlgorithm PETScSNES;

    // Predictor D at the start of a new time step using U and A
    predictor yes;

    // A small stabilisation: the stabilisation scales with the (nearly
    // incompressible) bulk modulus, so the default scaleFactor stiffens the
    // bending of the thin flap; 0.01 changes the calibrated shear modulus by
    // 4 % against 0.001 (see README.md)
    stabilisation
    {
        momentum
        {
            type        diffStencilLaplacian;
            scaleFactor 0.01;
        }
    }
}

