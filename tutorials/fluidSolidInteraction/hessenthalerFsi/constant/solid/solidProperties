FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Updated Lagrangian form: the flap rotates by up to about 35 degrees, and
// the compact Jacobian assembled on the current configuration remains a good
// preconditioner for such rotations, unlike the total Lagrangian forms
// (see README.md)
solidModel     nonLinearGeometryUpdatedLagrangian;

nonLinearGeometryUpdatedLagrangianCoeffs
{
    // Solution algorithm
    solutionAlgorithm PETScSNES;

    // Predictor DD at the start of a new time step using U and A
    predictor yes;

    // A small stabilisation: the default scaleFactor 0.5 stiffens the
    // bending of the thin flap, as the stabilisation scales with the
    // (nearly incompressible) bulk modulus
    stabilisation
    {
        momentum
        {
            type        diffStencilLaplacian;
            scaleFactor 0.05;
        }
    }
}

