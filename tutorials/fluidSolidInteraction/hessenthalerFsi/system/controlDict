FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.002;

writeControl    adjustable;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           5;

functions
{
    #include "gravityRamp"

    // Deflection of the centre of the flap tip
    flapTip
    {
        type            solidPointDisplacement;
        region          solid;
        point           (0 0 0.065);
    }

    // Displacement of points on the centreline x = y = 0 of the flap; the
    // deformed centreline is (0, D_y, z + D_z)
    #include "flapCentreline"
}

