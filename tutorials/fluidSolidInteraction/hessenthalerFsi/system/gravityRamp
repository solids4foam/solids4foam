FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      gravityRamp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Ramp the net buoyancy of the flap (constant/solid/g) in smoothly from zero
// over rampTime, starting from the straight flap:
//     g(t) = g_final*(3*s^2 - 2*s^3), s = min(t/rampTime, 1)
// The value is set before each time step is solved.
gravityRamp
{
    type            coded;
    libs            (utilityFunctionObjects);
    name            gravityRamp;
    region          solid;

    codeInclude
    #{
        #include "uniformDimensionedFields.H"
    #};

    codeData
    #{
        vector gFinal_{Zero};
        scalar rampTime_{0.5};
    #};

    localCode
    #{
        static void setGravity
        (
            const fvMesh& mesh,
            const vector& gFinal,
            const scalar rampTime
        )
        {
            // Time of the step about to be solved
            const scalar t = mesh.time().value() + mesh.time().deltaTValue();
            scalar s = 1.0;
            if (rampTime > SMALL)
            {
                s = min(max(t/rampTime, 0.0), 1.0);
            }

            uniformDimensionedVectorField& g =
                const_cast<uniformDimensionedVectorField&>
                (
                    mesh.lookupObject<uniformDimensionedVectorField>("g")
                );
            g.value() = s*s*(3.0 - 2.0*s)*gFinal;
        }
    #};

    codeRead
    #{
        // The final value is read from constant/solid/g on disk, not from
        // the registered field, which holds the ramped value
        const uniformDimensionedVectorField gFile
        (
            IOobject
            (
                "g",
                mesh().time().constant(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::NO_WRITE,
                false
            )
        );
        gFinal_ = gFile.value();
        setGravity(mesh(), gFinal_, rampTime_);
    #};

    codeExecute
    #{
        setGravity(mesh(), gFinal_, rampTime_);
    #};
}

