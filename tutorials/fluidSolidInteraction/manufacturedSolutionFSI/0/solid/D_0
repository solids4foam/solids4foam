FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/solid";
    object      D_0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/mmsFsiOldTimeCode"

// The exact displacement one time step before the start, read by the
// second-order (backward) time scheme
mmsFsiOldTimeLevel 1;

dimensions      [0 1 0 0 0 0 0];

internalField   #codeStream
{
    codeInclude     $mmsFsiOldTimeCodeInclude;
    codeOptions     $mmsFsiOldTimeCodeOptions;
    codeLibs        $mmsFsiOldTimeCodeLibs;
    code            $mmsFsiOldTimeDisplacement;
};

boundaryField
{
    interface
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $mmsFsiOldTimeCodeInclude;
            codeOptions     $mmsFsiOldTimeCodeOptions;
            codeLibs        $mmsFsiOldTimeCodeLibs;
            code            $mmsFsiOldTimeDisplacement;
        };
    }

    top
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $mmsFsiOldTimeCodeInclude;
            codeOptions     $mmsFsiOldTimeCodeOptions;
            codeLibs        $mmsFsiOldTimeCodeLibs;
            code            $mmsFsiOldTimeDisplacement;
        };
    }

    left
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $mmsFsiOldTimeCodeInclude;
            codeOptions     $mmsFsiOldTimeCodeOptions;
            codeLibs        $mmsFsiOldTimeCodeLibs;
            code            $mmsFsiOldTimeDisplacement;
        };
    }

    right
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $mmsFsiOldTimeCodeInclude;
            codeOptions     $mmsFsiOldTimeCodeOptions;
            codeLibs        $mmsFsiOldTimeCodeLibs;
            code            $mmsFsiOldTimeDisplacement;
        };
    }

    frontAndBack
    {
        type            empty;
    }
}

