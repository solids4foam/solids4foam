FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Robin-Neumann coupling: the fluid interface uses the elasticWallVelocity
// and elasticWallPressure conditions (0/fluid/U.robinNeumann and
// 0/fluid/p.robinNeumann)
fluidSolidInterface fixedRelaxation;

fixedRelaxationCoeffs
{
    // Solid and fluid interface patches
    solidPatch          interface;
    fluidPatch          interface;

    // Tolerance and maximum number of the outer FSI correctors per time step
    outerCorrTolerance  1e-6;
    nOuterCorr          200;

    interfaceTransferMethod directMap;
    coupled             yes;
    predictor           yes;
    writeResidualsToFile yes;

    relaxationFactor    1;
    predictSolid        yes;
    robinPressureTolerance 1e-6;
    robinFluxTolerance  1e-5;
}

// ************************************************************************* //
