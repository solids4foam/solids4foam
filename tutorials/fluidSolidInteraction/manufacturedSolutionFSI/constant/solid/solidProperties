FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel      nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    solutionAlgorithm   PETScSNES;
    predictor           yes;

    // Second-order deformed area and normal on the interface (solidTraction)
    // faces. This entry is used from solids4foam PR #756 and is ignored
    // before it; without it, the solid displacement is first order
    tractionPatchSurfaceGradient yes;

    stabilisation
    {
        momentum
        {
            type            diffStencilLaplacian;
            scaleFactor     0.1;
        }
    }
}

