FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      caseParameters;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mesh and time step of the case: nCells cells along the interface, square
// cells, and a time step proportional to the cell size, deltaT = 0.32/nCells.
// verification/Allverify writes this file for each level of the study.
nCells          16;
nCellsFluidY    8;
nCellsSolidY    4;
deltaT          0.02;

