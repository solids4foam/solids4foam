FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1;

// Membrane thickness is 0.1 (5-4.9)
// Change 4.9 to adjust for membrane thicnness
vertices
(
    (45 4.99 -5)     //0
    (55 4.99 -5)     //1
    (55 5 -5)       //2
    (45 5 -5)       //3
    (45 4.99 5)      //4
    (55 4.99 5)      //5
    (55 5 5)        //6
    (45 5 5)        //7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (16 6 16) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    membrane-solid
    {
        type patch;
        faces
        (
            (7 6 2 3)
        );
    }

    bottom
    {
        type patch;
        faces
        (
           (4 0 1 5)
        );
    }

    sides
    {
        type patch;
        faces
        (
            (4 5 6 7)
            (4 7 3 0)
            (5 1 2 6)
            (3 2 1 0)
        );
    }
);

mergePatchPairs
(
);

