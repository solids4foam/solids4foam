FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Second-order, low-dissipation schemes in time and for convection: the
// first-order Euler scheme and a limited linearUpwind scheme damp out the
// oscillation of the roof
ddtSchemes
{
    default            backward;
}

gradSchemes
{
    default            leastSquares;
}

divSchemes
{
    default            none;
    div(phi,U)         Gauss LUST grad(U);
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
    div((nuEff*dev(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default Gauss linear corrected;
}

interpolationSchemes
{
    default            linear;
    interpolate(U)     skewCorrected linear;
}

snGradSchemes
{
    default            corrected;
}

fluxRequired
{
    default            no;
    p;
}

