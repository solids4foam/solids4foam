FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

set cellsToRefine;

coordinateSystem global;

directions
(
    normal
    tan1
    tan2
);

useHexTopology  true;

geometricCut    false;

writeMesh       false;

