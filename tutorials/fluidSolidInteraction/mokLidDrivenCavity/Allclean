#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase
if [[ $WM_PROJECT = "foam" ]]; then
    foamClearPolyMesh -region fluid
    foamClearPolyMesh -region solid
elif [[ $WM_PROJECT_VERSION == v* ]]; then
    foamCleanPolyMesh -region fluid
    foamCleanPolyMesh -region solid
fi

rm -rf case.foam residuals deflection.pdf postProcessing dynamicCode
(cd src && wclean libso)

# Restore the default variants that Allrun relinks
ln -nsf fsiProperties.iqnils constant/fsiProperties
ln -nsf solidProperties.highOrder constant/solid/solidProperties

# Restore the stored case format
solids4Foam::restoreCaseFormat .

# Remove the regression test cases, and the verification study cases and
# results, too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
    (cd verification && ./Allclean)
fi
