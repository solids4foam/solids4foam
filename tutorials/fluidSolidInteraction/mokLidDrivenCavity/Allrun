#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Example usage
# ./Allrun                      # default: IQNILS coupling, high-order solid
# ./Allrun standard             # standard second-order solid
# ./Allrun aitken               # Aitken coupling
# ./Allrun parallel             # run in parallel
# ./Allrun monolithic           # quasi-monolithic Newton coupling
# ./Allrun aitken standard parallel

# PETSc is required for this case
solids4Foam::requirePetscOrExitSilently

coupling=iqnils
solid=highOrder
variant=partitioned
runMode=serial

for arg in "$@"
do
    case "$arg" in
        aitken|Aitken)
            coupling=aitken
            ;;
        iqnils|IQNILS)
            coupling=iqnils
            ;;
        highOrder)
            solid=highOrder
            ;;
        standard)
            solid=standard
            ;;
        monolithic|Monolithic)
            variant=monolithic
            ;;
        parallel)
            runMode=parallel
            ;;
        *)
            echo "Unknown option: $arg"
            echo "Usage: ./Allrun [iqnils|aitken] [highOrder|standard] [monolithic] [parallel]"
            exit 1
            ;;
    esac
done

# Start from the stored (partitioned) case
solids4Foam::restoreCaseVariant .

ln -vnsf "fsiProperties.${coupling}" constant/fsiProperties
ln -vnsf "solidProperties.${solid}" constant/solid/solidProperties

if [[ "${variant}" == "monolithic" ]]; then
    # The quasi-monolithic Newton approach is only implemented for
    # OpenFOAM.com; its files are stored as *.monolithic variants, which
    # replace the coupling and solid selected above
    solids4Foam::caseDoesNotRunWithFoamExtend
    solids4Foam::caseDoesNotRunWithOpenFOAMOrg
    echo "Using quasi-monolithic Newton coupling"
    solids4Foam::selectCaseVariant . monolithic
else
    echo "Using ${coupling} coupling and the ${solid} solid discretisation"
fi

# Build the lid and inlet velocity boundary condition
(cd src && ./Allwmake) || exit 1

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Run solver
if [[ "$runMode" == "parallel" ]]; then
    solids4Foam::runApplication -s fluid decomposePar -region fluid
    solids4Foam::runApplication -s solid decomposePar -region solid
    solids4Foam::runParallel solids4Foam
    solids4Foam::runApplication -s fluid reconstructPar -region fluid
    solids4Foam::runApplication -s solid reconstructPar -region solid
else
    solids4Foam::runApplication solids4Foam
fi

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating deflection.pdf using gnuplot"
    gnuplot deflection.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
