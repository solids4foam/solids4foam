#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Example usage
# ./Allrun
# ./Allrun aitken
# ./Allrun iqnils
# ./Allrun parallel
# ./Allrun aitken parallel

# PETSc is required for this case
if [[ -z "${PETSC_DIR:-}" ]]
then
    echo; echo "Skipping this case as PETSc is not installed"
    echo "Please set the PETSC_DIR variable and rebuild solids4foam"; echo
    exit 0
fi

couplingMethod=IQNILS
runParallel=no

print_usage()
{
    cat <<'EOF'
Usage:
  ./Allrun              # default: IQNILS coupling
  ./Allrun aitken       # run the Aitken under-relaxation scheme
  ./Allrun iqnils       # run the IQNILS scheme
  ./Allrun parallel     # run the case in parallel
  ./Allrun aitken parallel
EOF
}

if ! command -v foamDictionary >/dev/null 2>&1
then
    echo; echo "The foamDictionary utility is required; please source an OpenFOAM environment"; echo
    exit 1
fi

restore_default()
{
    foamDictionary -entry fluidSolidInterface -set IQNILS constant/fsiProperties >/dev/null 2>&1 || true
}
trap restore_default EXIT

for arg in "$@"
do
    argLower=$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')
    case "$argLower" in
        aitken)
            couplingMethod=Aitken
            ;;
        iqnils)
            couplingMethod=IQNILS
            ;;
        parallel)
            runParallel=yes
            ;;
        help|-h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg"
            print_usage
            exit 1
            ;;
    esac
done

echo "Using ${couplingMethod} fluidSolidInterface coupling"
[[ "$runParallel" == "yes" ]] && echo "Running in parallel"

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

# Set the requested coupling method before running the solvers
if ! foamDictionary -entry fluidSolidInterface -set "${couplingMethod}" constant/fsiProperties >/dev/null 2>&1
then
    solids4Foam::err "Failed to set fluidSolidInterface to ${couplingMethod}"
fi

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Run solver
if [[ "$runParallel" == "yes" ]]
then
    # Run parallel
    solids4Foam::runApplication -s fluid decomposePar -region fluid
    solids4Foam::runApplication -s solid decomposePar -region solid
    solids4Foam::runParallel solids4Foam
    solids4Foam::runApplication -s fluid reconstructPar -region fluid
    solids4Foam::runApplication -s solid reconstructPar -region solid
else
    # Run serial
    solids4Foam::runApplication solids4Foam
fi
