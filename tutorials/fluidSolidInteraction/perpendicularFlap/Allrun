#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Example usage
# ./Allrun
# ./Allrun aitken
# ./Allrun iqnils
# ./Allrun parallel
# ./Allrun aitken parallel
# ./Allrun monolithic
# ./Allrun monolithic parallel

# PETSc is required for this case
solids4Foam::requirePetscOrExitSilently

couplingMethod=IQNILS
runParallel=no

print_usage()
{
    cat <<'EOF'
Usage:
  ./Allrun              # default: IQNILS coupling
  ./Allrun aitken       # run the Aitken under-relaxation scheme
  ./Allrun iqnils       # run the IQNILS scheme
  ./Allrun parallel     # run the case in parallel
  ./Allrun aitken parallel
  ./Allrun monolithic   # quasi-monolithic Newton coupling (OpenFOAM.com)
  ./Allrun monolithic parallel
EOF
}

restore_default()
{
    # The monolithic fsiProperties is a link to a variant file
    [[ "$couplingMethod" == "monolithic" ]] && return 0
    sed -i "s/^fluidSolidInterface .*/fluidSolidInterface IQNILS;/" constant/fsiProperties || true
}
trap restore_default EXIT

for arg in "$@"
do
    argLower=$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')
    case "$argLower" in
        aitken)
            couplingMethod=Aitken
            ;;
        iqnils)
            couplingMethod=IQNILS
            ;;
        monolithic)
            couplingMethod=monolithic
            ;;
        parallel)
            runParallel=yes
            ;;
        help|-h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg"
            print_usage
            exit 1
            ;;
    esac
done

echo "Using ${couplingMethod} fluidSolidInterface coupling"
[[ "$runParallel" == "yes" ]] && echo "Running in parallel"

if [[ "$couplingMethod" == "monolithic" ]]
then
    # The quasi-monolithic Newton approach is only implemented for
    # OpenFOAM.com; its files are stored as *.monolithic variants
    solids4Foam::caseDoesNotRunWithFoamExtend
    solids4Foam::caseDoesNotRunWithOpenFOAMOrg
    solids4Foam::selectCaseVariant . monolithic
else
    solids4Foam::restoreCaseVariant .
fi

# Check case version is correct
solids4Foam::convertCaseFormat .

# Set the requested coupling method before running the solvers
if [[ "$couplingMethod" != "monolithic" ]]
then
    sed -i "s/^fluidSolidInterface .*/fluidSolidInterface ${couplingMethod};/" constant/fsiProperties
fi

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Run solver
if [[ "$runParallel" == "yes" ]]
then
    # Run parallel
    solids4Foam::runApplication -s fluid decomposePar -region fluid
    solids4Foam::runApplication -s solid decomposePar -region solid
    solids4Foam::runParallel solids4Foam
    solids4Foam::runApplication -s fluid reconstructPar -region fluid
    solids4Foam::runApplication -s solid reconstructPar -region solid
else
    # Run serial
    solids4Foam::runApplication solids4Foam
fi
