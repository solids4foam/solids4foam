FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    "outlet.*"
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    inlet
    {
        type            flowRateInletVelocity;
        // One 0.86 s cardiac cycle of inlet flow rate [m^3/s], repeated
        volumetricFlowRate
        {
            type        tableFile;
            file        "<constant>/fluid/inletFlow/humanFlow";
            outOfBounds repeat;
        }
        value           uniform (0 0 0);
    }

    wall
    {
        // Robin-Neumann coupling, paired with elasticWallPressure on p
        type            elasticWallVelocity;
        value           uniform (0 0 0);
    }
}

