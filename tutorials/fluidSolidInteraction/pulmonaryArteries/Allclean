#!/bin/bash
#------------------------------------------------------------------------------
# Clean the pulmonary artery tutorial: this FSI case and the prestress case in
# prestress/. Case input dictionaries and the 0 directory are kept
#------------------------------------------------------------------------------

cd "$(cd "$(dirname "$0")" && pwd)" || exit 1

: "${WM_PROJECT_DIR:?OpenFOAM environment is not sourced}"

. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

# The prestress case
(cd prestress && ./Allclean)

# Time directories other than 0, processor directories and logs
cleanCase

# The fluid and solid meshes generated by Allmesh
rm -rf constant/polyMesh
rm -rf constant/fluid/polyMesh
rm -rf constant/solid/polyMesh

rm -rf postProcessing regressionTests
rm -f case.foam

# Dictionaries with every default written out, by solids4Foam
rm -f constant/*/*.withDefaultValues

# The prestress written by prestress/Allrun
rm -f 0/solid/Fpre

# The plot written by Allrun (plotInletVsPressure.gplt)
rm -f inletFlow_probeP.dat inletFlow_vs_probePressure.png

# Logs, e.g. ./Allrun > log.Allrun or a batch job
rm -f log.* *.log

#------------------------------------------------------------------------------
