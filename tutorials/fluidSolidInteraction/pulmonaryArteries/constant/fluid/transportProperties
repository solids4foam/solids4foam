FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

rho             rho [1 -3 0 0 0 0 0] 1060;

// Carreau-Yasuda blood model (kinematic viscosities, mu/rho):
//     mu0 = 0.16 Pa s, muInf = 3.5e-3 Pa s, lambda = 8.2 s, n = 0.2128,
//     a = 0.64
transportModel  BirdCarreau;

BirdCarreauCoeffs
{
    nu0     1.509e-4;
    nuInf   3.3e-6;
    k       8.2;
    n       0.2128;
    a       0.64;
}

