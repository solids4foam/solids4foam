FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    fixedRelaxation;

fixedRelaxationCoeffs
{
    // Solid interface patch
    solidPatch             innerWall;

    // Fluid interface patch
    fluidPatch             wall;

    // Interface relaxation factor: no under-relaxation, as the Robin
    // condition on 0/fluid/p provides the stability
    relaxationFactor       1.0;

    // FSI outer loop tolerance
    outerCorrTolerance     1e-5;

    // Robin residual tolerances: the normalised interface-pressure change
    // and the interface leakage must also fall below these
    robinPressureTolerance 1e-2;
    robinFluxTolerance     1e-2;

    // Maximum FSI correctors per time step
    nOuterCorr             30;

    // Write FSI residuals to file
    writeResidualsToFile   yes;
}


