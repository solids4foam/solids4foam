FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

// Set to "no" by prestress/Allrun for its first pass
prestress       yes;

mechanical
(
    artery
    {
        // c and a fitted to the membrane Fung law of the pulmonary artery
        // (c = 15 kPa, ctt = czz = 6, ctz = 1.8; see README) under plane
        // stress and incompressibility: biaxial stretch ratios 1:1, 1:0.75
        // and 0.75:1 up to lambda = 1.3, RMS stress error < 1%
        type            isotropicFungElastic;
        rho             rho [1 -3 0 0 0 0 0] 1200;
        c               c [1 -1 -2 0 0 0 0] 7.87e3;
        a               7.05;
        bulkModulus     bulkModulus [1 -1 -2 0 0 0 0] 1e6;
    }
);

