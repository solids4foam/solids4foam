FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Five cardiac cycles of the 0.86 s inlet waveform
endTime         4.3;

deltaT          2.5e-4;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

fileHandler     uncollated;

functions
{
    // Pressure in the main pulmonary artery, every time step
    pressureProbe
    {
        type            probes;
        libs            (sampling);
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        fields          (p);
        probeLocations
        (
            (0.04 -0.008 0.065)
        );
    }

    // Minimum and maximum inner-wall displacement components, every time
    // step, in postProcessing/0/solidDisplacementsinnerWall.dat
    innerWallDisplacement
    {
        type            solidDisplacements;
        historyPatch    innerWall;
    }

    // Number of FSI iterations per time step
    fsiConvData
    {
        type            fsiConvergenceData;
        region          fluid;
    }

    // Wall shear stress on the fluid wall, at each write time
    wallShearStress1
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        region          fluid;
        patches         (wall);
        writeFields     yes;
        writePrecision  10;
        writeControl    writeTime;
        writeInterval   -1;
    }
}

