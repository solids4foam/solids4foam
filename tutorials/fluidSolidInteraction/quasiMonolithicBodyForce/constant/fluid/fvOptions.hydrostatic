FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Uniform body force per unit mass (the fluid pressure is kinematic)
bodyForce
{
    type            vectorSemiImplicitSource;
    selectionMode   all;
    volumeMode      specific;
    sources
    {
        U
        {
            explicit    (0 -10 0);
            implicit    0;
        }
    }
}

// ************************************************************************* //
