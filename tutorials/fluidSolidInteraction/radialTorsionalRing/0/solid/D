FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
dimensions      [0 1 0 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    inner
    {
        type            fixedRotation;
        rotationAngleSeries
        {
            file            "$FOAM_CASE/constant/timeVsAngle";
            outOfBounds     clamp;
        }
        rotationAxis    (0 0 1);
        rotationOrigin  (0 0 0);
        value           uniform (0 0 0);
    }
    interface
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    frontAndBack
    {
        type            empty;
    }
}
