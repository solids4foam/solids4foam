FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    IQNILS;
IQNILSCoeffs
{
    solidPatch interface;
    fluidPatch interface;
    predictor            yes;
    predictSolid         yes;
    relaxationFactor     0.05;
    outerCorrTolerance   1e-06;
    // Absolute interface point-mismatch tolerance (m). The C-inf ramp starts
    // with signals at round-off level, where the relative residual cannot
    // reach outerCorrTolerance; 1e-12 m is 1e-11 of the expected interface
    // displacement
    outerCorrAbsoluteTolerance 1e-12;
    nOuterCorr           100;
    couplingReuse        5;
    coupled              yes;
    interfaceTransferMethod directMap;
    writeResidualsToFile yes;
}

