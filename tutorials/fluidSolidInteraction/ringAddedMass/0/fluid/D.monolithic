FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    interface
    {
        type            fixedDisplacement;
        // Do not update pointD from D, as the pointD interface field has
        // already been set from the solid side
        enforcePointPatchField no;
        value           uniform (0 0 0);
    }
    outerWall
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            symmetry;
    }
    left
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
