FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Replaced by setInitialVelocity.py in the 0/solid/U copy made by Allrun
internalField   uniform (0 0 0);

boundaryField
{
    interface
    {
        type            zeroGradient;
    }
    inside
    {
        type            zeroGradient;
    }
    bottom
    {
        type            symmetry;
    }
    left
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
