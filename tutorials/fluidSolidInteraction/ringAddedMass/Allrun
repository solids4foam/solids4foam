#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Example usage
# ./Allrun            # default behaviour is IQNILS coupling
# ./Allrun robin      # Robin-Neumann coupling
# ./Allrun standard   # standard (second-order) solid residual
# ./Allrun robin standard parallel
# ./Allrun monolithic # quasi-monolithic Newton coupling (OpenFOAM.com)

# PETSc is required for this case
solids4Foam::requirePetscOrExitSilently

# python3 is required to set the initial velocity
if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required for the ringAddedMass tutorial." >&2
    exit 2
fi

coupling=iqnils
interfaceCondition=dirichletNeumann
runMode=serial
solidModel=highOrder
monolithic=no

for arg in "$@"
do
    case "$arg" in
        iqnils|IQNILS)
            coupling=iqnils
            interfaceCondition=dirichletNeumann
            ;;
        robin|Robin)
            coupling=robin
            interfaceCondition=robin
            ;;
        monolithic|Monolithic)
            monolithic=yes
            ;;
        standard)
            solidModel=standard
            ;;
        highOrder)
            solidModel=highOrder
            ;;
        parallel)
            runMode=parallel
            ;;
        *)
            echo "Unknown option: $arg"
            echo "Usage: ./Allrun [iqnils|robin|monolithic] [highOrder|standard] [parallel]"
            exit 1
            ;;
    esac
done

if [[ "${monolithic}" == "yes" ]]; then
    # The quasi-monolithic Newton approach is only implemented for
    # OpenFOAM.com; its files are stored as *.monolithic variants. Its
    # velocity solid model has the standard second-order residual only, so
    # the coupling and solid set-up options do not apply
    solids4Foam::caseDoesNotRunWithFoamExtend
    solids4Foam::caseDoesNotRunWithOpenFOAMOrg
    echo "Using monolithic coupling setup"
else
    echo "Using ${coupling} coupling setup"
fi

solverArgs=()
if [[ "$WM_PROJECT" == "foam" ]]; then
    # Permit foam-extend's round-off-level closed-domain flux imbalance
    solverArgs=(-Tolerances closedDomainTol=1e-5)
fi

# Undo a previous variant selection before setting the links below, and
# remove the solid U generated for it
solids4Foam::restoreCaseVariant .
rm -f 0/solid/U

ln -vnsf "fsiProperties.${coupling}" constant/fsiProperties
ln -vnsf "solidProperties.${solidModel}" constant/solid/solidProperties
ln -vnsf "U.${interfaceCondition}" 0/fluid/U
ln -vnsf "p.${interfaceCondition}" 0/fluid/p

if [[ "${monolithic}" == "yes" ]]; then
    solids4Foam::selectCaseVariant . monolithic

    # Set the solid U from the current mesh description, in a copy of the
    # stored U.monolithic, which Allclean removes
    rm -f 0/solid/U
    cp 0/solid/U.monolithic 0/solid/U
    python3 setInitialVelocity.py \
        system/solid/blockMeshDict system/controlDict 0/solid velocity || exit 1
else
    # Set D_0 and D_0_0 from the current mesh description and time-step
    python3 setInitialVelocity.py \
        system/solid/blockMeshDict system/controlDict 0/solid || exit 1
fi

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create meshes
solids4Foam::runApplication -s solid blockMesh -region solid
solids4Foam::runApplication -s fluid blockMesh -region fluid

# Run solver
if [[ "$runMode" == "parallel" ]]; then
    # Run parallel
    solids4Foam::runApplication -s fluid decomposePar -region fluid
    solids4Foam::runApplication -s solid decomposePar -region solid
    solids4Foam::runParallel solids4Foam "${solverArgs[@]}"
    solids4Foam::runApplication -s fluid reconstructPar -region fluid
    solids4Foam::runApplication -s solid reconstructPar -region solid
else
    # Run serial
    solids4Foam::runApplication solids4Foam "${solverArgs[@]}"
fi

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating displacement.pdf using gnuplot"
    gnuplot displacement.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
