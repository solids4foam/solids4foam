FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         14;

deltaT          0.035;

writeControl    timeStep;

writeInterval   40;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

functions
{
    // Radial displacement of the ring's outer surface on the x axis
    // (theta = 0), and on the y axis (theta = 90 deg)
    pointDispX
    {
        type                solidPointDisplacement;
        point               (1.05 0 0);
    }
    pointDispY
    {
        type                solidPointDisplacement;
        point               (0 1.05 0);
    }
}

