FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/womersleyCode"

dimensions      [0 2 -2 0 0 0 0];

internalField   #codeStream
{
    codeInclude     $womersleyCodeInclude;
    codeOptions     $womersleyCodeOptions;
    codeLibs        $womersleyCodeLibs;
    code            $womersleyInitialPressure;
};

boundaryField
{
    "inlet|outlet"
    {
        type            codedFixedValue;
        value           uniform 0;
        name            womersleyPressure;
        codeInclude     $womersleyCodeInclude;
        code            $womersleyPressure;
    }
    interface
    {
        type            elasticWallPressure;
        value           uniform 0;
    }
    "front|back"
    {
        type            wedge;
    }
    axis
    {
        type            empty;
    }
}

// ************************************************************************* //
