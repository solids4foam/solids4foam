FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D_0_0_0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/womersleyCode"

dimensions      [0 1 0 0 0 0 0];

// The exact solution 3 time-steps before the start
womersleyTimeLevel 3;

internalField   #codeStream
{
    codeInclude     $womersleyCodeInclude;
    codeOptions     $womersleyCodeOptions;
    codeLibs        $womersleyCodeLibs;
    code            $womersleyInitialDisplacement;
};

boundaryField
{
    inlet
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $womersleyCodeInclude;
            codeOptions     $womersleyCodeOptions;
            codeLibs        $womersleyCodeLibs;
            code            $womersleyPatchDisplacement;
        };
    }
    outlet
    {
        type            calculated;
        value #codeStream
        {
            codeInclude     $womersleyCodeInclude;
            codeOptions     $womersleyCodeOptions;
            codeLibs        $womersleyCodeLibs;
            code            $womersleyPatchDisplacement;
        };
    }
    interface
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value #codeStream
        {
            codeInclude     $womersleyCodeInclude;
            codeOptions     $womersleyCodeOptions;
            codeLibs        $womersleyCodeLibs;
            code            $womersleyPatchDisplacement;
        };
    }
    outer
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value #codeStream
        {
            codeInclude     $womersleyCodeInclude;
            codeOptions     $womersleyCodeOptions;
            codeLibs        $womersleyCodeLibs;
            code            $womersleyPatchDisplacement;
        };
    }
    "front|back"
    {
        type            solidWedge;
        patchType       wedge;
        value           uniform (0 0 0);
    }
}

