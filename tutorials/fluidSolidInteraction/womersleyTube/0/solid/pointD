FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/womersleyCode"

dimensions      [0 1 0 0 0 0 0];

internalField   #codeStream
{
    codeInclude     $womersleyCodeInclude;
    codeOptions     $womersleyCodeOptions;
    codeLibs        $womersleyCodeLibs;
    code            $womersleyInitialPointDisplacement;
};

boundaryField
{
    "inlet|outlet|interface|outer"
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    "front|back"
    {
        type            wedge;
    }
}

