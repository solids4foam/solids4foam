FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Velocity-based solid for the quasi-monolithic coupling, with the same
// linear elastic wall as the partitioned set-up
solidModel      linearGeometryVelocity;

linearGeometryVelocityCoeffs
{
    // Initialise the kinematics from the exact displacement at t = 0
    restart         yes;

    // Stabilisation
    stabilisation
    {
        momentum
        {
            type            diffStencilLaplacian;
            scaleFactor     0.5;
        }
    }
}

// ************************************************************************* //
