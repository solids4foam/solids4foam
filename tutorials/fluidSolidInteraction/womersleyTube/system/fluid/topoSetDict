FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Faces on the plane x = L/2, through which the flow rate is measured
actions
(
    {
        name    midPlaneFaces;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     (7.49 -1 -1) (7.51 2 1);
    }
    {
        name    midPlane;
        type    faceZoneSet;
        action  new;
        source  setToFaceZone;
        faceSet midPlaneFaces;
    }
);

