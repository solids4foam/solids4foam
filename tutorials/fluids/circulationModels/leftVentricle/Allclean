#!/bin/bash
# Remove everything Allrun made
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source tutorial clean functions
. "$WM_PROJECT_DIR"/bin/tools/CleanFunctions

cleanCase

# The mesh made by cartesianMesh
rm -rf constant/polyMesh

# The volume record and the plots
rm -f volumeConservation.dat interface.png volumeConservation.png

# Remove the regression test cases too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
fi
