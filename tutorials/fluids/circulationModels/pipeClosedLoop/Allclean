#!/bin/bash
# Remove everything Allrun (both the CFD case and the 0D reference) and
# plotter.py made
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

# Source tutorial clean functions
. "$WM_PROJECT_DIR"/bin/tools/CleanFunctions

cleanCase

# The 0D reference of ./Allrun 0D
(cd reference0D && cleanCase)

# Remove the plots of plotter.py
rm -rf plots

# Remove the regression test cases too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
fi
