#!/bin/bash
# Demo: a CFD pipe in a closed circulation loop (both ends coupled).
# Runs on numberOfSubdomains ranks of system/decomposeParDict (1: serial, slow).
# Then:  python3 plotter.py
#
#   ./Allrun              the coupled CFD case, the pipe solved by solids4Foam
#                         (pimpleFluid)
#   ./Allrun pimpleFoam   the pipe solved by stock pimpleFoam
#   ./Allrun 0D           the 0D reference in reference0D: the same circuit with
#                         the pipe replaced by its R-L surrogate (circulationFoam)
cd "$(dirname "$0")" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"

mode=CFD
solver=solids4Foam

print_usage()
{
    cat <<'USAGE'
Usage:
  ./Allrun              # default: the CFD pipe coupled to the circuit (solids4Foam)
  ./Allrun solids4Foam  # the same
  ./Allrun pimpleFoam   # the pipe solved by stock pimpleFoam
  ./Allrun 0D           # the 0D reference, no mesh (circulationFoam in reference0D)
USAGE
}

for arg in "$@"
do
    case "$arg" in
        pimpleFoam|solids4Foam)
            solver=$arg
            ;;
        0D)
            mode=0D
            ;;
        help|-h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg"
            print_usage
            exit 1
            ;;
    esac
done

# Source solids4Foam scripts (on macOS, this keeps the OpenFOAM libraries findable)
source solids4FoamScripts.sh

# The circulation models are currently only built for OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

if [ "$mode" = "0D" ]; then
    # The whole loop as one circuit (no mesh): check the set-up, then solve it
    cd reference0D || exit 1
    solids4Foam::runApplication -s check circulationFoam -check || exit 1
    grep '^Result' log.circulationFoam.check
    solids4Foam::runApplication circulationFoam || exit 1
    echo "done: reference0D/postProcessing/circulation/0/circulation.dat"
    exit 0
fi

np=$(solids4Foam::getNumberOfProcessors system/decomposeParDict)

solids4Foam::runApplication blockMesh || exit 1
solids4Foam::runApplication -s check circulationFoam -check || exit 1
echo "--- the circuit, as the program understood it ---"
sed -n '/ODE states/,/^Result/p' log.circulationFoam.check

echo "--- ${solver} on $np rank(s) (progress: tail -f log.${solver}) ---"
if [ "$np" -gt 1 ]; then
    solids4Foam::runApplication decomposePar || exit 1
    solids4Foam::runParallel "${solver}" || exit 1
else
    solids4Foam::runApplication "${solver}" || exit 1
fi
echo "done: postProcessing/circulationCoupling/0/coupling.dat  (python3 plotter.py to plot)"
