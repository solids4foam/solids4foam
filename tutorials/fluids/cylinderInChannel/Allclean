#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase
rm -rf processor* force.pdf case.foam constant/polyMesh

# Restore the initial fields if ./Allrun shortOutlet stopped while they were
# moved aside
if [ -d 0.subsetMesh ] && [ ! -d 0 ]
then
    \mv 0.subsetMesh 0
fi
rm -rf 0.subsetMesh

# Restore the stored case format and the default case variant
solids4Foam::restoreCaseFormat .
solids4Foam::restoreCaseVariant .

# Reset the fluid model selected by ./Allrun <fluidModel>
solids4Foam::requireGnuSed
"${SOLIDS4FOAM_SED}" -i "s/^fluidModel .*/fluidModel pimpleFluid;/" \
    constant/fluidProperties

# Remove the regression test cases too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
fi
