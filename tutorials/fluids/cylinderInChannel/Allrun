#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Example usage
# ./Allrun
# ./Allrun newtonIcoFluid
# ./Allrun pimpleFluid
# ./Allrun shortOutlet newtonIcoFluid

fluidModel=pimpleFluid
shortOutlet=false

print_usage()
{
    cat <<'EOF'
Usage:
  ./Allrun                    # default: pimpleFluid
  ./Allrun pimpleFluid        # run with pimpleFluid
  ./Allrun newtonIcoFluid     # run with newtonIcoFluid
  ./Allrun shortOutlet [...]  # cut the channel 4 D behind the cylinder, with
                              # a backflow-stabilised outlet
EOF
}

for arg in "$@"
do
    case "$arg" in
        pimpleFluid|newtonIcoFluid)
            fluidModel=$arg
            ;;
        shortOutlet)
            shortOutlet=true
            ;;
        help|-h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg"
            print_usage
            exit 1
            ;;
    esac
done

echo "Using ${fluidModel} fluid model"

# Source solids4Foam scripts
source solids4FoamScripts.sh

# newtonIcoFluid uses the PETSc SNES solver
if [[ "${fluidModel}" == "newtonIcoFluid" ]]
then
    solids4Foam::requirePetscOrExitSilently
fi

# Use the short-outlet initial velocity, keeping the default as 0/U.default,
# or restore the default
if [[ "${shortOutlet}" == "true" ]]
then
    if [[ ! -f 0/U.default ]]
    then
        \cp 0/U 0/U.default
    fi
    \cp 0/U.shortOutlet 0/U
elif [[ -f 0/U.default ]]
then
    \mv 0/U.default 0/U
fi

# Check case version is correct
solids4Foam::convertCaseFormat .

# GNU sed, for the in-place edit below
solids4Foam::requireGnuSed

# Set the requested fluid model before running the solver
"${SOLIDS4FOAM_SED}" -i "s/^fluidModel .*/fluidModel ${fluidModel};/" \
    constant/fluidProperties

# Create the mesh
solids4Foam::runApplication fluentMeshToFoam cylinderInChannel.msh || exit 1
solids4Foam::runApplication changeDictionary || exit 1

# Keep the cells up to 4 D behind the cylinder, so that the starting wake
# crosses the outlet. The initial fields are uniform, so they are moved aside
# rather than subset
if [[ "${shortOutlet}" == "true" ]]
then
    solids4Foam::runApplication setSet -batch setSet.shortOutlet.batch \
        || exit 1
    \mv 0 0.subsetMesh
    rc=0
    solids4Foam::runApplication subsetMesh -overwrite keepCells \
        -patch outlet || rc=$?
    # foam-extend also writes a 0/setSubset file
    \rm -rf 0
    \mv 0.subsetMesh 0
    [[ ${rc} -eq 0 ]] || exit 1
fi

# Run the solver
solids4Foam::runApplication solids4Foam || exit 1

# Create plots
if command -v gnuplot &> /dev/null
then
    if [ $(find . -name forces.dat | wc -l) -eq 1 ]
    then
        echo "Generating force.pdf using gnuplot"
        gnuplot force.gnuplot &> /dev/null
    fi
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
