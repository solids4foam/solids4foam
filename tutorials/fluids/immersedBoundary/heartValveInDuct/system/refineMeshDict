FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Refinement of the cell set written by immersedBodyRefinementCells, in the
// three directions
set             refineCells;

coordinateSystem global;

globalCoeffs
{
    tan1        (1 0 0);
    tan2        (0 1 0);
}

directions      (tan1 tan2 normal);

useHexTopology  yes;

geometricCut    no;

writeMesh       no;

