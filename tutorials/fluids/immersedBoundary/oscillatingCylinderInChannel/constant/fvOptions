FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Immersed oscillating cylinder, see src/immersedBoundary/README.md
immersedBoundary
{
    type            immersedBoundaryForce;

    couplingCoeff   0.8;

    bodies
    {
        cylinder
        {
            // Diameter 0.1 m, centred at (1.1, 0.2) m at t = 0, extending
            // beyond the mesh in the z direction
            surface     "cylinder.stl";

            // x = 1.1 + 0.25 sin(2 pi t/4) m
            motion
            {
                type        sinusoidalTranslation;
                amplitude   0.25;
                period      4;
                direction   (1 0 0);
            }
        }
    }
}

