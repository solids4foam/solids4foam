#!/bin/bash
cd "${0%/*}" || exit  # Run from this directory

usage() {
cat <<'USAGE'
Usage:
  ./Allrun [method]

Where [method] is the forcing method of immersedBoundaryForce, one of:
  cutLink           (the default in constant/fvOptions)
  ghostCell
  penalty
  incremental

With a method, constant/fvOptions is linked to constant/fvOptions.<method>;
without one, the case is run with the current constant/fvOptions. The mesh
density is set by MESH_LEVEL (default 1).

Examples:
  ./Allrun
  ./Allrun ghostCell
  MESH_LEVEL=2 ./Allrun penalty
USAGE
}

# Parse the method
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    ""|cutLink|ghostCell|penalty|incremental)
        METHOD="${1:-}"
        ;;
    *)
        echo "Error: Unknown method '$1'"
        usage
        exit 1
        ;;
esac

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# The immersed boundary library is only built with OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

# Select the forcing method
if [ -n "$METHOD" ]
then
    ln -vnsf "fvOptions.$METHOD" constant/fvOptions
fi
echo "Using the $(sed -n 's/^ *method *\([A-Za-z]*\);.*/\1/p' \
    constant/fvOptions | head -n 1) method"

# Create the mesh; the mesh density is set by MESH_LEVEL (default 1)
solids4Foam::runApplication blockMesh

# Run the solver
solids4Foam::runApplication solids4Foam

# Plot the force coefficients
if command -v gnuplot &> /dev/null
then
    echo "Generating forceCoeffs.pdf using gnuplot"
    gnuplot forceCoeffs.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
