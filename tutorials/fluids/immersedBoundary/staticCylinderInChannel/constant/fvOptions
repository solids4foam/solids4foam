FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Immersed cylinder, see src/immersedBoundary/README.md
immersedBoundary
{
    type            immersedBoundaryForce;

    // Sharp penalisation with a linear reconstruction of the velocity next
    // to the surface, for static bodies; the implicit volume penalisation
    // (the default, for moving bodies) is available with
    //     method          penalty;
    // and the direct forcing of openHFDIB-DEM, for comparison, with
    //     method          incremental;
    //     couplingCoeff   0.8;
    // and "occupancy vertexFraction;" for the body
    method          ghostCell;

    bodies
    {
        cylinder
        {
            // Diameter 0.1 m, centred at (0.2, 0.2) m, extending beyond the
            // mesh in the z direction
            surface     "cylinder.stl";
        }
    }
}

