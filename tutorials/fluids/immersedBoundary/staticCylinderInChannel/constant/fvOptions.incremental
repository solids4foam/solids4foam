FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Immersed cylinder, see src/immersedBoundary/README.md
immersedBoundary
{
    type            immersedBoundaryForce;

    // Incremental direct forcing of the pimpleHFDIBFoam solver from which
    // the option is derived
    method          incremental;
    couplingCoeff   0.8;

    bodies
    {
        cylinder
        {
            // Diameter 0.1 m, centred at (0.2, 0.2) m, extending beyond the
            // mesh in the z direction
            surface     "cylinder.stl";

            // Solid volume fraction from the fraction of the cell vertices
            // inside the surface
            occupancy   vertexFraction;
        }
    }
}

// ************************************************************************* //
