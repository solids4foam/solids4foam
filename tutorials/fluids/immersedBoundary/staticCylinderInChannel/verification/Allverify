#!/usr/bin/env bash
# Opt-in verification driver for the staticCylinderInChannel tutorial: the
# four immersedBoundaryForce methods on the four mesh levels. See README.md.
#
#     ./Allverify generate                 # all methods, levels 1-4
#     ./Allverify submit                   # resource summary only
#     ./Allverify submit --yes             # submit through SLURM
#     ./Allverify analyse                  # CSV of the completed cases
set -euo pipefail

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 -u "${SCRIPT_DIR}/scripts/static_cylinder_verification.py" "$@"
