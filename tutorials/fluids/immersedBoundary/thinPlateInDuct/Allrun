#!/bin/bash
cd "${0%/*}" || exit 1

# Source solids4Foam scripts
source solids4FoamScripts.sh

# The immersed boundary library is only built with OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

# Plate of 0.43 cells (4.3 mm, h = 10 mm) in a slip-wall duct, with and
# without thinBodyBlocking: a plate spanning the duct must transmit exactly
# the volume flux w*A (w = 0.1 m/s, A = 0.2*0.01 m2). Other thicknesses and
# no-slip walls: RATIOS="0.5 1 3" WALLS="slip noSlip" ./Allrun
for walls in ${WALLS:-slip}
do
    for ratio in ${RATIOS:-0.43}
    do
        for mode in off crossedFaces
        do
            ./runCase $ratio $walls $mode
        done
    done
done

# slip walls, 0.43 cells: off leaks (about 0.77), crossedFaces is exact
if [ -z "$RATIOS$WALLS" ]
then
    python3 checkFlux.py run_slip_0.43_off 0.5 0.95 || exit 1
    python3 checkFlux.py run_slip_0.43_crossedFaces 0.999 1.001 || exit 1
fi
