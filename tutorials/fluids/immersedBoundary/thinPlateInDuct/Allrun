#!/bin/bash
cd "${0%/*}" || exit 1

# Plate of 0.43 cells (4.3 mm, h = 10 mm) in a slip-wall duct, with and
# without thinBodyBlocking: a plate spanning the duct must transmit exactly
# the volume flux w*A (w = 0.1 m/s, A = 0.2*0.01 m2)
for mode in off crossedFaces
do
    rm -rf run_$mode; mkdir run_$mode
    cp -r 0 constant system run_$mode/
    python3 makePlateStl.py 0.43 > run_$mode/constant/triSurface/plate.stl
    sed -i "s/thinBodyBlocking .*;/thinBodyBlocking $mode;/" run_$mode/constant/fvOptions
    ( cd run_$mode && blockMesh > log.blockMesh 2>&1 \
      && topoSet > log.topoSet 2>&1 && solids4Foam > log.solids4Foam 2>&1 )
done

# off: the plate leaks (about 0.67 here); crossedFaces: exact
python3 checkFlux.py run_off 0.5 0.95 || exit 1
python3 checkFlux.py run_crossedFaces 0.999 1.001 || exit 1
