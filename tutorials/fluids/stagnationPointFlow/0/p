FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    // Exact pressure
    outlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            expression;
            variables
            (
                "a = 1 + 0.5*sin(2*pi()*arg())"
                "dadt = pi()*cos(2*pi()*arg())"
            );
            expression
            #{
                -0.5*(a*a + dadt)*sqr(pos().x())
              - 0.5*(a*a - dadt)*sqr(pos().y())
            #};
        }
        value           $internalField;
    }

    "left|bottom"
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

