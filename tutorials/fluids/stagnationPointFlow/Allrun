#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# fluxConsistentPatches is only implemented in the OpenFOAM.com pimpleFluid,
# and the case uses the OpenFOAM.com expression boundary conditions
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create the mesh
solids4Foam::runApplication blockMesh

# Set the exact solution at t = 0
solids4Foam::runApplication -s initial \
    setExprFields -dict system/setExprFieldsDict.initial

# Run the solver
solids4Foam::runApplication solids4Foam

# Write the error fields at the final time, UError = |U - U_exact| and
# pError = p - p_exact. setExprFields takes time() from the first time it
# reads, so it is run for one time only
solids4Foam::runApplication -s error \
    setExprFields -dict system/setExprFieldsDict.error -latestTime
