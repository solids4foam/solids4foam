FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setExprFieldsDict.initial;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initial fields: the exact solution at t = 0
//
// Exact solution: u = a x, v = -a y and
// p = -(a^2 + da/dt) x^2/2 - (a^2 - da/dt) y^2/2, with a = 1 + sin(2 pi t)/2

_exact
{
    variables
    (
        "a = 1 + 0.5*sin(2*pi()*time())"
        "dadt = pi()*cos(2*pi()*time())"
        "Uexact = vector(a*pos().x(), -a*pos().y(), 0)"
        "pExact = -0.5*(a*a + dadt)*sqr(pos().x()) - 0.5*(a*a - dadt)*sqr(pos().y())"
    );
}

expressions
(
    U
    {
        field       U;
        $_exact;
        expression  #{ Uexact #};
    }

    p
    {
        field       p;
        $_exact;
        expression  #{ pExact #};
    }
);

// ************************************************************************* //
