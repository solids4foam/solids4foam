FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    location    "0";
    object      M;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    outer
    {
        type            clampedMoment;
        // Used only by segregated solver; coupled needs no under-relaxation
        relaxationFactor 0.01;
        value           uniform 0;
    }

    inner
    {
        type            freeEdgeMoment;
        // Used only by segregated solver; coupled needs no under-relaxation
        relaxationFactor 0.5;
        value           uniform 0;
    }
}

// ************************************************************************* //
