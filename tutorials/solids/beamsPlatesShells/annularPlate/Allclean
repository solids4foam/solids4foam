#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase
\rm -f constant/polyMesh/boundary case.foam log.writeCosineLoad
\rm -rf system/*Subset constant/faMesh/faBoundary constant/faMesh/faceLabels

# Restore the stored case format
solids4Foam::restoreCaseFormat .

# Link the fields back to the default configuration
for field in M w
do
    ln -vnsf "${field}.clampedInner" "0/finite-area/${field}"
done
ln -vnsf p.uniform 0/finite-area/p

# Remove the regression test cases, and the verification study cases and
# results, too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
    (cd verification && ./Allclean)
fi
