FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress        no;

mechanical
(
    steel
    {
        type            linearElastic;

        // The density is set to zero so that the single time step gives the
        // static solution: with a non-zero density the solver's inertia term
        // adds rho*h*w/deltaT^2 to the load, which is about 2% of p here
        rho             rho [1 -3 0 0 0 0 0] 0;

        E               E [1 -1 -2 0 0 0 0] 2e+11;
        nu              nu [0 0 0 0 0 0 0] 0.3;
    }
);

