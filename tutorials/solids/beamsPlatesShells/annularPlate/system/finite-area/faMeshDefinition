FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/finite-area";
    object      faMeshDefinition;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

polyMeshPatches  1( front );

boundary
{
    inner
    {
        type                patch;
        ownerPolyPatch      front;
        neighbourPolyPatch  inner;
    }

    outer
    {
        type                patch;
        ownerPolyPatch      front;
        neighbourPolyPatch  outer;
    }
}

