#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

solids4Foam::caseDoesNotRunWithOpenFOAMOrg
solids4Foam::caseDoesNotRunWithFoamExtend

# The beam models are only built when Eigen is available
if ! command -v createBeamMesh > /dev/null 2>&1
then
    echo; echo "createBeamMesh: command not found, which is required for this case"
    echo "It is built with the beam models when Eigen is available"; echo
    exit 0
fi

# Create the beam mesh
solids4Foam::runApplication createBeamMesh

# Rotate the beam from the x-axis into its vertical starting position
solids4Foam::runApplication setInitialPositionBeam \
    -cellZone beam_0 -translate '(0 0 0)' -rotateAngle '((0 -1 0) 90)'

# Run solver
solids4Foam::runApplication solids4Foam
