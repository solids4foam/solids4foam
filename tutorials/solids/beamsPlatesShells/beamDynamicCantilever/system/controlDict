FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

libs            ("libS4FBeamSolid.so");

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          0.001;//0.002;

writeControl    timeStep;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
{
   beamDisplacements1
   {
       type    beamDisplacements;
       historyPatch    right;
   }

   beamConvergenceData
   {
       type    beamConvergenceData;
   }

   beamForcesMoments2
   {
       type    beamForcesMoments;
       historyPatch    left;
   }

   beamEnergyData
   {
       type    beamEnergyData;
   }
}

