FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Template for the manufactured load: Allrun runs writeManufacturedSolution.py,
// which writes the load p = D laplacian(laplacian(w)) of the manufactured
// deflection into 0/finite-area/p in the order of the finite area faces

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    right
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
