FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inside
    {
        type tractionPressureDisplacement;
        traction uniform (0 0 0);
        // pressure        uniform 0;

        pressureSeries
        {
            "file|fileName" "$FOAM_CASE/constant/timeVsPressure";
            outOfBounds clamp;
        }

        value uniform (0 0 0);
    }

    outside
    {
        type		tractionPressureDisplacement;
        traction	uniform (0 0 0);
        pressure	uniform 0;
        value		uniform (0 0 0);
    }

    "(symm.*)"
    {
        // type            solidSymmetry;
        // type            blockSymmPlane;
        // patchType       symmetryPlane;

        type            symmetryPlane;
        value           uniform (0 0 0);
    }

    frontAndBack
    {
        type            empty;
    }
}


