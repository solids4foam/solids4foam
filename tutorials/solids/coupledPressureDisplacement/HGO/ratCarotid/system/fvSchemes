FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default            steadyState;
}

ddtSchemes
{
    default            steadyState;
}

gradSchemes
{
    default none;
    grad(Dp) updatedLagGauss linear;
    grad(DD) stabLeastSquares;

    grad(psi0) Gauss linear;
    grad(psi1) Gauss linear;
}

divSchemes
{
    default Gauss linear;
}

laplacianSchemes
{
    default            Gauss linear corrected;
    // laplacian(DD,D)    Gauss linear skewCorrected 1;
    // laplacian(DDD,DD)  Gauss linear skewCorrected 1;
}

snGradSchemes
{
    default            none;
    snGrad(D)          corrected;
    snGrad(DD)         corrected;
}

interpolationSchemes
{
   default            linear;
}

