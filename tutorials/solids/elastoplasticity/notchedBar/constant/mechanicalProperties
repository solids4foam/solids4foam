FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
(
    aluminium
    {
        type            logStrain;
        rho             rho [1 -3 0 0 0 0 0] 2700;

        mechanicalLaw
        {
            type            linearElasticMisesPlastic;
            E               E [1 -1 -2 0 0 0 0] 69e9;
            nu              nu [0 0 0 0 0 0 0] 0.3;
            file            "$FOAM_CASE/constant/plasticStrainVsYieldStress";
            outOfBounds     clamp;
        }
    }
);

