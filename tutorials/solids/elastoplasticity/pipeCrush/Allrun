#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

# Use extendedLeastSquares for foam extend
if [[ $WM_PROJECT = "foam" ]]
then
    echo "Switching the gradScheme to extendedLeastSquares"; echo
    sed -i "s/ leastSquaresS4f;/ extendedLeastSquares 0;/g" system/fvSchemes
elif [[ $WM_PROJECT == "OpenFOAM" && $WM_PROJECT_VERSION != v* ]]
then
    echo "Switching the gradScheme to pointCellsLeastSquares"; echo
    sed -i "s/ leastSquaresS4f;/ pointCellsLeastSquares;/g" system/fvSchemes
fi

# Create the mesh
solids4Foam::runApplication blockMesh

# Run the solver
solids4Foam::runApplication solids4Foam


