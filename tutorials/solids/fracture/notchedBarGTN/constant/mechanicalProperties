FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
(
    aluminium
    {
        type            logStrain;
        rho             rho [1 -3 0 0 0 0 0] 2700;

        mechanicalLaw
        {
            type            linearElasticGTNPlastic;
            E               E [1 -1 -2 0 0 0 0] 69e9;
            nu              nu [0 0 0 0 0 0 0] 0.3;
            file            "$FOAM_CASE/constant/plasticStrainVsYieldStress";
            outOfBounds     clamp;

            // Tvergaard parameters
            q1              1.5;
            q2              1;
            q3              2.25;

            // Initial void fraction, and strain-controlled nucleation
            f0              0.002;
            fN              0.2;
            sN              0.08;
            epsilonN        0.15;
        }
    }
);

