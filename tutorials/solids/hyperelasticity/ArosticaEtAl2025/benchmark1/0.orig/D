FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Gamma_top: J T F^-T N + alpha_top u + beta_top du/dt = 0
    base
    {
        type            solidSpringDashpot;
        kNormal         uniform 1e5;    // alpha_top [Pa/m], Table 1
        kTangential     uniform 1e5;
        cNormal         uniform 5e3;    // beta_top  [Pa s/m], Table 1
        cTangential     uniform 5e3;
        value           uniform (0 0 0);
    }

    // Gamma_epi: normal spring-dashpot, tangentially traction free
    //     J T F^-T N . N + alpha_epi u.N + beta_epi du/dt.N = 0
    epi
    {
        type            solidSpringDashpot;
        kNormal         uniform 1e8;    // alpha_epi [Pa/m], Table 1
        kTangential     uniform 0;
        cNormal         uniform 5e3;    // beta_epi  [Pa s/m], Table 1
        cTangential     uniform 0;
        value           uniform (0 0 0);
    }

    // Gamma_endo: follower cavity pressure p(t), eq. (7), applied on the
    // deformed area along the deformed normal
    endo
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressureSeries
        {
            "file|fileName" "$FOAM_CASE/constant/timeVsPressure";
            outOfBounds clamp;
        }
        value           uniform (0 0 0);
    }
}

