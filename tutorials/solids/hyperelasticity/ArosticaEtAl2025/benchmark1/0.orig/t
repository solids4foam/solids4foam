FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      t;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Transmural coordinate: 0 on the endocardium, 1 on the epicardium, solved
// by setFibreField (method ellipsoid) (Arostica et al. 2025, eq. 13)

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.5;

boundaryField
{
    base
    {
        type            zeroGradient;
    }
    endo
    {
        type            fixedValue;
        value           uniform 0;
    }
    epi
    {
        type            fixedValue;
        value           uniform 1;
    }
}

