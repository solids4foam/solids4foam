#!/bin/bash
#------------------------------------------------------------------------------
# Arostica et al. (2025) benchmark 1: elastodynamics of an idealised left
# ventricle with visco-active Holzapfel-Ogden myocardium, a follower cavity
# pressure and spring-dashpot (pericardium/base) boundary conditions.
#
# Usage:
#     ./Allrun [step] [pressure|displacement] [parallel]
#
# where step is one of
#     step0A   active response only (zero pressure)       Section 3.3.1
#     step0B   passive response only (no active stress)   Section 3.3.2
#     step1    active and passive response (default)      Section 3.4
#     step2A   blinded parameter variation, case A        Section 3.5, Table 5
#     step2B   blinded parameter variation, case B
#     step2C   blinded parameter variation, case C
#
# The mesh density is set with MESH_NUMBER, 1 (coarsest) to 4 (finest),
# default 2. The all-hexahedral mesh, with an O-grid at the apex, and the time
# series of the active stress and the cavity pressure are generated by the
# Python scripts in ../scripts, which need only python3. e.g.
#     MESH_NUMBER=3 ./Allrun step1 displacement parallel
#
# Created by Claude Opus 5.5, supervised by Chanikya Valeti, UCD.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# Source solids4Foam scripts
source solids4FoamScripts.sh

# The case is solved with PETSc SNES
solids4Foam::requirePetscOrExitSilently

# The case has only been run with OpenFOAM.com
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::caseDoesNotRunWithOpenFOAMOrg

# The mesh and the time series are generated with python3
solids4Foam::requirePythonOrExitSilently

# The Python scripts are shared by both benchmarks, in ../scripts, or where
# ARO_SCRIPTS_DIR points (the regression test runs a copy of this case
# elsewhere)
SCRIPTS="${ARO_SCRIPTS_DIR:-../scripts}"
if [[ ! -f "$SCRIPTS/makeTimeSeries.py" ]]
then
    echo "The ArosticaEtAl2025 scripts were not found in $SCRIPTS"
    exit 1
fi

# Mesh level
MESH_NUMBER="${MESH_NUMBER:-2}"
if [[ ! "$MESH_NUMBER" =~ ^[1-4]$ ]]
then
    echo "MESH_NUMBER must be 1, 2, 3 or 4, not '$MESH_NUMBER'"
    exit 1
fi

# Select the benchmark step and the formulation
STEP="step1"
FORMULATION="pressure"
PARALLEL="no"
for arg in "$@"
do
    case "$arg" in
        step0A|step0B|step1|step2A|step2B|step2C) STEP="$arg" ;;
        pressure|displacement) FORMULATION="$arg" ;;
        parallel) PARALLEL="yes" ;;
        *) echo "Unknown argument: $arg"; exit 1 ;;
    esac
done

echo "Benchmark step: $STEP, mesh level: $MESH_NUMBER"

# Material parameters of the selected step
ln -vnsf "benchmarkParameters.$STEP" constant/benchmarkParameters

# Active stress tau(t) and cavity pressure p(t): ODEs in time only, tabulated
# once here
SIGMA0=$(awk '/^activeStressSigma0/ {gsub(";", "", $2); print $2}' \
    "constant/benchmarkParameters.$STEP")
PRESSURE=$(awk '/^pressureTable/ {gsub(";", "", $2); print $2}' \
    "constant/benchmarkParameters.$STEP")

if [[ "$SIGMA0" == "0" ]]
then
    ACTIVE_ARGS=(--zero)
else
    ACTIVE_ARGS=(--sigma0 "$SIGMA0")
fi
if [[ "$PRESSURE" == "zero" ]]
then
    PRESSURE_ARGS=(--zero)
else
    PRESSURE_ARGS=(--pressure "$PRESSURE")
fi

{
    python3 "$SCRIPTS/makeTimeSeries.py" --which active "${ACTIVE_ARGS[@]}" \
        --out constant/activeStress \
 && python3 "$SCRIPTS/makeTimeSeries.py" --which pressure \
        "${PRESSURE_ARGS[@]}" --out constant/timeVsPressure
} > log.makeTimeSeries 2>&1 \
    || { echo "makeTimeSeries.py failed: see log.makeTimeSeries"; exit 1; }

# Solid formulation: "pressure" (default), the mixed displacement-pressure
# formulation, or "displacement", with the bulk modulus as a penalty in the
# momentum equation. The selected fvSolution and solidProperties variants are
# linked into place, as in LandEtAl2015/problem3
echo "Formulation: $FORMULATION"

# The mixed formulation's Jacobian has no processor-boundary (coupled patch)
# coupling of the pressure to the displacement
# (foamPetscSnesHelper::InsertFvmDivUIntoPETScMatrix: "patch.coupled(): D-in-p
# not implemented"), so it only runs in serial
if [[ "$FORMULATION" == "pressure" && "$PARALLEL" == "yes" ]]
then
    echo "The pressure formulation cannot currently run in parallel:"
    echo "run it in serial, or use the displacement formulation in parallel."
    exit 1
fi
for file in system/fvSolution.$FORMULATION constant/solidProperties.$FORMULATION
do
    ln -vnsf "${file##*/}" "${file%.*}"
done

# Restore 0 directory from 0.orig
restore0Dir

# All-hexahedral mesh with an O-grid at the apex, written directly as
# constant/polyMesh
rm -rf constant/polyMesh
python3 "$SCRIPTS/makeOGridMesh.py" "$MESH_NUMBER" > log.makeOGridMesh 2>&1 \
    || { echo "makeOGridMesh.py failed: see log.makeOGridMesh"; exit 1; }
runApplication checkMesh

# Transmural coordinate t, fibres f0, sheets s0 and sheet-normals n0
# (system/setFibreFieldDict selects the ellipsoid method)
runApplication setFibreField

# Run the solver
if [[ "$PARALLEL" == "yes" ]]
then
    runApplication decomposePar
    runParallel solids4Foam
    runApplication reconstructPar
else
    runApplication solids4Foam
fi

# Compare with the benchmark participants, if numpy is available (and
# matplotlib, for the plot)
if python3 -c "import numpy" > /dev/null 2>&1
then
    python3 "$SCRIPTS/compareWithReference.py" "$STEP" \
        | tee log.compareWithReference
fi

#------------------------------------------------------------------------------
