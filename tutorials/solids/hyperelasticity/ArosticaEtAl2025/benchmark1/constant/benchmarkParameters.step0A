FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      benchmarkParameters;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Step 0, case A: active response only (zero endocardial pressure), Tables 1-3

matA    59.0;
matAf   18472.0;
matAs   2481.0;
matAfs  216.0;

// Active stress table: constant/timeSeries/activeStress.sigma0_1.5e5
// Pressure table:      constant/timeSeries/timeVsPressure.zero
activeStressTable  sigma0_1.5e5;
pressureTable      zero;

