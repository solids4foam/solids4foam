FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      benchmarkParameters;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Step 0, case B: passive response only (no active stress), Tables 1, 2, 4

matA    59.0;
matAf   18472.0;
matAs   2481.0;
matAfs  216.0;

// Active stress table: constant/timeSeries/activeStress.zero
// Pressure table:      constant/timeSeries/timeVsPressure.benchmark1
activeStressTable  zero;
pressureTable      benchmark1;

