FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Material of Arostica et al. (2025), Section 2.2 and Tables 1-3.
// The parameters that change between the benchmark steps are in
// benchmarkParameters, which Allrun links to benchmarkParameters.<step>
#include "benchmarkParameters"

planeStress     no;

mechanical
(
    heartTissue
    {
        type            viscoActiveHolzapfelOgden;

        // Table 1
        rho             rho [1 -3 0 0 0 0 0] 1000;
        eta             eta [1 -1 -1 0 0 0 0] 100;
        bulkModulus     bulkModulus [1 -1 -2 0 0 0 0] 1e6;   // kappa

        // Table 2 (a, af, as, afs vary in step 2, Table 5)
        a               a [1 -1 -2 0 0 0 0] $matA;
        b               8.023;
        af              af [1 -1 -2 0 0 0 0] $matAf;
        bf              16.026;
        as              as [1 -1 -2 0 0 0 0] $matAs;
        bs              11.12;
        afs             afs [1 -1 -2 0 0 0 0] $matAfs;
        bfs             11.436;

        // Fibre compression switch chi(x) = 1/(1 + exp(-k (x - 1))), k = 100
        fibreSwitch     smooth;
        k               100;

        // Fibres and sheets from 0/f0 and 0/s0, written by
        // setEllipsoidFibreField
        uniformFibreField no;

        // Active stress tau(t), the solution of eq. (5) with Table 3 (and
        // sigma_0 of Table 5 in step 2), tabulated by scripts/makeTimeSeries.py
        activeStressSeries
        {
            "file|fileName" "$FOAM_CASE/constant/activeStress";
            outOfBounds clamp;
        }
    }
);

