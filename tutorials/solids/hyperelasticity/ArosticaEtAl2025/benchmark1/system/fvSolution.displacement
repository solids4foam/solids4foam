FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    t
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-12;
        relTol          0.0;
        maxIter         1000;
    }

    D
    {
        solver    petsc;

        options
        {
            snes_type newtonls;
            snes_linesearch_type bt;   // backtracking: robust through the rapid relaxation after t = 0.5 s
            snes_rtol "1e-6";
            // Absolute tolerance: steps that start converged (e.g. step0A, where
            // nothing loads the wall at first) must not chase round-off
            snes_atol "1e-10";
            snes_monitor;
            snes_converged_reason;
            snes_max_linear_solve_fail "100000";

            snes_mf;
            snes_mf_operator;

            ksp_type lgmres;
            ksp_gmres_restart "200";
            ksp_rtol "1e-4";
            ksp_converged_reason;
            ksp_max_it "300";

            // Preconditioner: HYPRE BoomerAMG
            pc_type hypre;
            pc_hypre_type boomeramg;
            pc_hypre_boomeramg_max_iter "1";
            pc_hypre_boomeramg_strong_threshold "0.6";
            pc_hypre_boomeramg_grid_sweeps_up "1";
            pc_hypre_boomeramg_grid_sweeps_down "1";
            pc_hypre_boomeramg_agg_nl "1";
            pc_hypre_boomeramg_agg_num_paths "1";
            pc_hypre_boomeramg_max_levels "25";
            pc_hypre_boomeramg_coarsen_type HMIS;
            pc_hypre_boomeramg_interp_type ext+i;
            pc_hypre_boomeramg_P_max "1";
            pc_hypre_boomeramg_truncfactor "0.3";
        }
    }
}

// ************************************************************************* //
