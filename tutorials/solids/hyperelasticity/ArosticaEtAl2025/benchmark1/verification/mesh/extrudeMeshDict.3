FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Generated by scripts/makeMeshDicts.py: 128 cells around the long axis

constructFrom patch;

sourceCase ".";
sourcePatches (top);

exposedPatchName top;

flipNormals true;

extrudeModel        sector;

nLayers             128;

expansionRatio      1;

sectorCoeffs
{
    point       (0 0 0);
    axis        (1 0 0);
    angle       360;
}

mergeFaces true;

mergeTol 1e-9;

// ************************************************************************* //
