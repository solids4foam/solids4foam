FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Gamma_top: J T F^-T N + alpha_top u + beta_top du/dt = 0 (Table 7)
    base
    {
        type            solidSpringDashpot;
        stiffness       1e6;    // alpha_top [Pa/m]
        damping         5e3;    // beta_top  [Pa s/m]
        normalOnly      no;
        value           uniform (0 0 0);
    }

    // Gamma_epi: normal spring-dashpot (pericardium), tangentially free
    epi
    {
        type            solidSpringDashpot;
        stiffness       1e8;    // alpha_epi [Pa/m]
        damping         5e3;    // beta_epi  [Pa s/m]
        normalOnly      yes;
        value           uniform (0 0 0);
    }

    // Gamma_endo-lv and Gamma_endo-rv: follower cavity pressures p_lv(t),
    // p_rv(t), eq. (7) with Table 9
    endo_lv
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressureSeries
        {
            "file|fileName" "$FOAM_CASE/constant/timeSeries/pressureLV";
            outOfBounds clamp;
        }
        value           uniform (0 0 0);
    }

    endo_rv
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressureSeries
        {
            "file|fileName" "$FOAM_CASE/constant/timeSeries/pressureRV";
            outOfBounds clamp;
        }
        value           uniform (0 0 0);
    }
}

