#!/bin/bash
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial clean functions
. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

cleanCase0

# The time-series utility shared by both benchmarks
wclean "${ARO_DIR:-..}/makeArosticaTimeSeries" > /dev/null 2>&1

# Remove the formulation links created by Allrun
rm -f system/fvSolution constant/solidProperties

# Remove the mesh, the downloaded mesh archive and the time series generated
# by Allrun
rm -rf constant/polyMesh data
rm -f constant/activeStress constant/pressureLV constant/pressureRV
rm -f verification/coarse.pdf verification/fine.pdf

