FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Material of Arostica et al. (2025), Sections 2.2 and 4.4, Tables 2, 7 and 8.

planeStress     no;

mechanical
(
    heartTissue
    {
        type            viscoActiveHolzapfelOgden;

        // Table 7 (rho, eta, kappa as in Table 1)
        rho             rho [1 -3 0 0 0 0 0] 1000;
        eta             eta [1 -1 -1 0 0 0 0] 100;
        bulkModulus     bulkModulus [1 -1 -2 0 0 0 0] 1e6;   // kappa

        // Table 2
        a               a [1 -1 -2 0 0 0 0] 59.0;
        b               8.023;
        af              af [1 -1 -2 0 0 0 0] 18472;
        bf              16.026;
        as              as [1 -1 -2 0 0 0 0] 2481;
        bs              11.12;
        afs             afs [1 -1 -2 0 0 0 0] 216;
        bfs             11.436;

        // Fibre compression switch chi(x) = 1/(1 + exp(-k (x - 1))), k = 100
        fibreSwitch     smooth;
        k               100;

        // Fibres and sheets from 0/f0 and 0/s0: the rule-based (BT-LDRB)
        // fibres distributed with the benchmark, see ../scripts/convertBiVMesh.py
        uniformFibreField no;

        // Active stress tau(t), the solution of eq. (5) with Table 8,
        // tabulated by ../scripts/makeTimeSeries.py
        activeStressSeries
        {
            "file|fileName" "$FOAM_CASE/constant/activeStress";
            outOfBounds clamp;
        }
    }
);

