FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Dp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions			[1 -1 -2 0 0 0 0];

internalField		uniform 0;

boundaryField
{
    left
    {
        type zeroGradient;
        value uniform 0;

        // type extrapolated;
        // zeroGradient true;
        // value uniform 0;
    }

    right
    {
        type		pressureTraction;
        value		uniform 0;
    }

    top
    {
        type		pressureTraction;
        value		uniform 0;
    }

    bottom
    {
        type		pressureTraction;
        value		uniform 0;
    }

    front
    {
        type		pressureTraction;
        value		uniform 0;
    }

    back
    {
        type		pressureTraction;
        value		uniform 0;
    }
}

