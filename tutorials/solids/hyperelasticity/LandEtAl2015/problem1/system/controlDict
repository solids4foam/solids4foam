FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// libs ("libztSolids4FoamModels.so");

application     solids4Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          0.0001; //0.0001;

writeControl    timeStep;

writeInterval   10;

purgeWrite      10;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
(
    tipPointDisp
    {
        type          solidPointDisplacement;
        point         (0.01 0.0005 0.0005);
    }
    tipPointDisp-1
    {
        type          solidPointDisplacement;
        point         (0.01 0.0005 0.001);
    }
    traction
    {
        type          solidTractions;
    }
);

