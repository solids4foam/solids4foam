FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Dp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions			[1 -1 -2 0 0 0 0];

internalField		uniform 0;

boundaryField
{
    wall_outer
    {
        type		pressureTraction;
        value		uniform 0;
    }

    wall_inner
    {
        type		pressureTraction;
        value		uniform 0;
    }

    top
    {
        type zeroGradient;
        value uniform 0;
    }

    symmetry_1
    {
        type		symmetry;
        value		uniform 0;
    }

    symmetry_2
    {
        type		symmetry;
        value		uniform 0;
    }

}

