#
# Radius diagram
#

reset
set output 'tipPointDisplacement.eps'
set term postscript color

set size 0.5,0.5

set style line 1 linecolor rgb 'black' linetype 7 linewidth 2 ps 0.5
set style line 2 linecolor rgb 'black' linetype 8 linewidth 2 ps 0.7

set grid
set xlabel 'Time (s)'
set ylabel 'Dz (m)'
#set title 'Radial displacement vs. radius of the tube'
set key right bottom

#set xrange [8:16]
#set yrange [0.04:0.17]
#set ytics 0.04
#set xtics 2
#set samples 800, 800

path_to_directory = "postProcessing/0"
path_to_file_0 = path_to_directory . "/solidPointDisplacement_tip_endo.dat"
path_to_file_1 = path_to_directory . "/solidPointDisplacement_tip_epi.dat"
path_to_file_1fem = "./epicard_apex.txt"


plot \
path_to_file_0 u 1:5 w l ls 2 title 'tip, inside', \
path_to_file_1 u 1:5 w l ls 3 title 'tip, outside', \
path_to_file_1fem u 1:($2/1000) w p ls 5 ps 0.25  title 'tip, outside, fem'



#path_to_file u 1:(-0.017+$4) w l ls 2 title 'Euler + dumping'

#path_to_file_1 u 1:($4) w l ls 3 title 'Euler + dumping'

#path_to_file_1 u 1:($4) w l ls 2 title 'Euler + dumping'

set output
