FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

"linearGeometryTotalDisplacementCoeffs|nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs"
{
    // Solution algorithm
    solutionAlgorithm PETScSNES;

    // Predictor D at the start of a new time step using U and A
    //predictor yes;

    // Solve pressure as an additional unknown (mixed formulation)
    //solvePressure true;

    stabilisation
    {
        momentum
        {
            type        diffStencilLaplacian;
            scaleFactor 1;
        }

        pressure
        {
            type                RhieChow;
            scaleFactor         1;
            scaleFactorJacobian 1;
        }
    }


}

// ************************************************************************* //
