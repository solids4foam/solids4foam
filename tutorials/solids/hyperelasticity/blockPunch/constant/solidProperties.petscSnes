FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryUpdatedLagrangian;

"nonLinearGeometryUpdatedLagrangianCoeffs"
{
    // Solution algorithm
    solutionAlgorithm    PETScSNES;

    // Continue after SNES failure for diagnosis
    stopOnPetscError     false;

    stabilisation
    {
        momentum
        {
            type        RhieChow;
            scaleFactor 0.1;
        }
    }
}

// ************************************************************************* //
