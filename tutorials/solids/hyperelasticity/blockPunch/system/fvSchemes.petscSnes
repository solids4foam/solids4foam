FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default                 steadyState;
}

ddtSchemes
{
    default                 steadyState;
}

gradSchemes
{
    default                 leastSquaresS4f;
}

divSchemes
{
    default                 Gauss linear;
}

laplacianSchemes
{
    default                 Gauss linear corrected;
}

snGradSchemes
{
    default                 corrected;
}

interpolationSchemes
{
    default                 linear;
}

// ************************************************************************* //
