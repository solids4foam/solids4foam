FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver          petsc;

        options
        {
            snes_type newtonls;
            snes_monitor;
            snes_converged_reason;
            snes_mf;
            snes_mf_operator;
            snes_max_it "100";

            ksp_type lgmres;
            ksp_gmres_restart "100";
            ksp_converged_reason;
            ksp_rtol "1e-5";

            pc_type bjacobi;
            sub_pc_type lu;
            snes_lag_preconditioner_persists true;
            snes_lag_preconditioner "-2";
        }
    }
}

// ************************************************************************* //
