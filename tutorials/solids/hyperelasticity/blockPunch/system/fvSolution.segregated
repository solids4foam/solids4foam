FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver                  PCG;
        preconditioner          FDIC;

        minIter                 0;
        maxIter                 500;

        tolerance               1e-9;
        relTol                  1e-2;
    }
}

relaxationFactors
{
    fields
    {
         "D|DD"         0.5;
    }

    equations
    {
         "D|DD"         0.99;
    }
}

// ************************************************************************* //
