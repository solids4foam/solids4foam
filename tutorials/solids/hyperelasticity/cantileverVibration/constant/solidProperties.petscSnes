FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

"nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs"
{
    // Solve the momentum equation monolithically using a Jacobian-free
    // Newton-Krylov method via PETSc SNES; the PETSc options are specified in
    // system/fvSolution
    solutionAlgorithm   PETScSNES;

    // Predict D at the start of each time step using the velocity and
    // acceleration from the previous time step
    predictor           yes;
}

// ************************************************************************* //
