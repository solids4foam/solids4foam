FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// One full oscillation of the tip (Abaqus reference period is approx. 0.65 s)
endTime         0.65;

deltaT          0.005;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

functions
{
    // Displacement of the vertex at the centre of the free-end face,
    // written to postProcessing/0/solidPointDisplacement_pointDisp.dat
    pointDisp
    {
        type        solidPointDisplacement;
        point       (0.1 0.1 2);
    }
}

