FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Third-order BDF time integration (BDF3): not recommended for this case.
// BDF3 amplifies undamped modes for finite time steps (see the README)
d2dt2Schemes
{
    default         BDF 3;
}

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         corrected;
}

interpolationSchemes
{
    default         linear;
}

// ************************************************************************* //
