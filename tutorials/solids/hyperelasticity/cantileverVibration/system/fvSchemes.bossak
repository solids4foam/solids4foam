FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Bossak-Newmark: alphaM = -0.1, beta = (1-alphaM)^2/4, gamma = 0.5-alphaM
d2dt2Schemes
{
    default         NewmarkBeta 0.3025 0.6 -0.1;
}

// Optional: the linear predictor then uses the Newmark acceleration too. The
// coefficients must match d2dt2Schemes, otherwise the run stops with a fatal
// error. The first derivative still uses backward; NewmarkBeta is a d2dt2
// scheme only.
ddtSchemes
{
    default         backward;
    "d2dt2\(.*\)"   NewmarkBeta 0.3025 0.6 -0.1;
}

gradSchemes
{
    default         leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         corrected;
}

interpolationSchemes
{
    default         linear;
}

// ************************************************************************* //
