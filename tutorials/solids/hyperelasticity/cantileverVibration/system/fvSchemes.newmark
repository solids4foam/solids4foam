FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Trapezoidal Newmark: beta = 0.25, gamma = 0.5, alphaM = 0
d2dt2Schemes
{
    default         NewmarkBeta;
}

// Only d2dt2Schemes selects NewmarkBeta: the linear predictor's acceleration
// then uses backward, from ddtSchemes (see fvSchemes.bossak for the optional
// matching ddtSchemes entry). NewmarkBeta is a d2dt2 scheme only.
ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         corrected;
}

interpolationSchemes
{
    default         linear;
}

// ************************************************************************* //
