FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          petsc;

        options
        {
            snes_type                       newtonls;
            snes_monitor;
            snes_converged_reason;

            // Jacobian-free: the action of the Jacobian is approximated by
            // finite differences, while the compact-stencil approximate
            // Jacobian is used as the preconditioning matrix
            snes_mf;
            snes_mf_operator;

            ksp_type                        lgmres;
            ksp_converged_reason;

            pc_type                         bjacobi;
            sub_pc_type                     lu;

            // Construct the preconditioner once and reuse it
            snes_lag_preconditioner_persists true;
            snes_lag_preconditioner         "-2";
        }
    }
}

relaxationFactors
{}

// ************************************************************************* //
