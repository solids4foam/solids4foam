#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

usage() {
cat <<'USAGE'
Usage:
  ./Allrun [contact] [mesh]

Where [contact] is one of:
  frictionless      (default) frictionless contact between the spheres
  friction          Coulomb friction (mu = 0.5) between the spheres

Where [mesh] is one of:
  coarse            (default) 682 cells, shipped with the tutorial
  medium            2 122 cells, downloaded from the solids4foam website
  fine              4 042 cells, downloaded from the solids4foam website

Examples:
  ./Allrun
  ./Allrun frictionless
  ./Allrun friction
  ./Allrun friction fine
USAGE
}

if [[ "${1:-}" =~ ^(-h|--help)$ ]]
then
    usage
    exit 0
fi

CONTACT=frictionless
MESH=coarse

for arg in "$@"
do
    case "$arg" in
        frictionless|friction)
            CONTACT="$arg"
            ;;
        coarse|medium|fine)
            MESH="$arg"
            ;;
        *)
            echo "Error: Unknown argument '$arg'"
            usage
            exit 1
            ;;
    esac
done

# Check version
solids4Foam::caseOnlyRunsWithFoamExtend

link_files_for_suffix() {
    local suffix="$1"
    local found=0

    while IFS= read -r -d '' f
    do
        found=1
        rm -f "${f%.*}"
        ln -vnsf "$(basename "$f")" "${f%.*}"
    done < <(find ./0 ./constant ./system -type f -name "*.${suffix}" -print0 2>/dev/null || true)

    if (( !found ))
    then
        echo "Warning: No *.${suffix} files found under ./0 ./constant ./system."
    fi
}

echo "Using the ${CONTACT} contact settings"
link_files_for_suffix "${CONTACT}"

# Check case version is correct
solids4Foam::convertCaseFormat .

# Extract the quarter-symmetry mesh
rm -rf constant/polyMesh
if [[ "$MESH" == "coarse" ]]
then
    # The coarse mesh is stored with dimensions in m
    echo "Extracting the mesh from coarseMesh.tar.xz"
    tar -xJf coarseMesh.tar.xz -C constant
else
    # The finer meshes are stored on the solids4foam website, with dimensions
    # in mm
    ARCHIVE="compressedSpheres-${MESH}Mesh.tar.xz"
    URL="https://www.solids4foam.com/tutorials/archive/${ARCHIVE}"
    if [[ ! -f "${ARCHIVE}" ]]
    then
        echo "Downloading ${URL}"
        if command -v curl &> /dev/null
        then
            curl -fsSL -o "${ARCHIVE}" "${URL}" || rm -f "${ARCHIVE}"
        elif command -v wget &> /dev/null
        then
            wget -q -O "${ARCHIVE}" "${URL}" || rm -f "${ARCHIVE}"
        fi
    fi
    if [[ ! -f "${ARCHIVE}" ]]
    then
        echo "Error: could not download ${URL}"
        echo "Download it manually into this directory and run Allrun again"
        exit 1
    fi
    echo "Extracting the mesh from ${ARCHIVE}"
    tar -xJf "${ARCHIVE}" -C constant
    solids4Foam::runApplication transformPoints -scale "(0.001 0.001 0.001)"
fi

# Run solver
solids4Foam::runApplication solids4Foam

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating force-displacement.png using gnuplot"
    gnuplot -e "contact='${CONTACT}'" plot.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
