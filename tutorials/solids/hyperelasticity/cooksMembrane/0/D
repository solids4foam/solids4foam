FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    right
    {
        // Shear traction ramped linearly from 0 to 62.5 kPa (1/16 N/mm^2);
        // see constant/timeVsTraction
        type            solidTraction;
        tractionSeries
        {
            "fileName|file" "$FOAM_CASE/constant/timeVsTraction";
            outOfBounds     clamp;
        }
        pressure        uniform 0;

        // Apply the traction per unit undeformed area (dead load)
        useUndeformedArea true;

        value           uniform (0 0 0);
    }
    topAndBottom
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    frontAndBack
    {
        type            empty;
    }
}

