FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Maximum number of momentum correctors
    nCorrectors     10000;

    // Relative residual tolerance for the outer (momentum corrector) loop
    // in each load increment. Tolerances of 1e-4, 1e-5 and 1e-6 all give the
    // same reference point displacement to six significant figures; 1e-5
    // retains an order of magnitude of margin
    rTol            1e-05;

    // Disable the step-norm convergence check so that convergence is
    // controlled by rTol only
    sTol            0;

    // Write frequency for the residuals
    infoFrequency   100;

    // Predict the displacement at the start of each load increment
    predictor       yes;
}

// ************************************************************************* //
