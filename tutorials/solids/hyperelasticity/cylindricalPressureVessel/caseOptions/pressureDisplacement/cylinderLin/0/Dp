FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Dp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0; //-3.333333e6;

boundaryField
{
    outside
    {
        type pressureTraction;
        value $internalField; //-3.333333e6;
    }

    inside
    {
        type pressureTraction;
        value $internalField; //-3.333333e6;

        // blockCoupled true;
    }

    "(symm.*)"
    {
        type    symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

