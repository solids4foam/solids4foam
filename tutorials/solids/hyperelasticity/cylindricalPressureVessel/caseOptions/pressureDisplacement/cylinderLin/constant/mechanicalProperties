FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress no;

mechanical
(
    rubber
    {
        type neoHookeanElastic;
        pressureDisplacement yes;
        E E [ 1 -1 -2 0 0 0 0 ] 1000e6;
        rho rho [ 1 -3  0 0 0 0 0 ] 1000;
        nu nu [ 0 0 0 0 0 0 0 ] 0.5;
    }
);

// neoHookean true;

