FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

d2dt2Schemes
{
    default         steadyState;
}

gradSchemes
{
    default         none;
    grad(Dp) Gauss linear;
    grad(DD) stabLeastSquares;

    // grad(Dp) Gauss linear;
}

divSchemes
{
    default         none;
    div(sigma)      Gauss linear;
    div(D)          Gauss linear;
    div(DD)          Gauss linear;

    // implicit newGauss linear;
}

laplacianSchemes
{
    default none;

    laplacian(DD,D)  Gauss linear uncorrected;
    laplacian(DDD,DD)  Gauss linear uncorrected;

    laplacian(rAD,p) Gauss linear uncorrected;

 //   laplacian((1|A(U)),p) Gauss linear corrected newSkewCorrected 1.0;
}

snGradSchemes
{
    default         none;
    snGrad(D)       uncorrected;
    snGrad(DD)       uncorrected;
    snGrad(DD)ho       uncorrected;
    // snGrad(reconD)  uncorrected;
    // snGrad(p)       uncorrected;
    // snGrad(p_0)     uncorrected;
}

interpolationSchemes
{
    default         linear;
}



