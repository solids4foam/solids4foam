#
# Radius diagram
#

reset
set output 'solidEnergy.eps'
set term postscript color

set size 0.5,0.5

set style line 1 linecolor rgb 'red' linetype 8 linewidth 1 ps 0.7
set style line 2 linecolor rgb 'blue' linetype 8 linewidth 1 ps 0.7
set style line 3 linecolor rgb 'black' linetype 8 linewidth 1 ps 0.7

set grid
set xlabel 'Time (s)'
set ylabel 'Energy'
#set title 'x'
set key right bottom

#set xrange [8:16]
#set yrange [0.04:0.17]
#set ytics 0.04
#set xtics 2
#set samples 800, 800

path_to_directory = "./postProcessing/0/"
path_to_file = path_to_directory . "solidEnergy.dat"

plot path_to_file u 1:3 w l ls 1 title 'Elastic energy', \
path_to_file u 1:2 w l ls 2 title 'Kinetic energy', \
path_to_file u 1:4 w l ls 3 title 'Total energy'

set output
