#
# Radius diagram
#

reset
set output 'innerRadius.eps'
set term postscript color

set size 0.5,0.5

set style line 1 linecolor rgb 'black' linetype 7 linewidth 1 ps 0.5
set style line 2 linecolor rgb 'black' linetype 8 linewidth 1 ps 0.7

set grid
set xlabel 'Time (s)'
set ylabel 'Radius (m)'
#set title 'Radial displacement vs. radius of the tube'
set key right bottom

#set xrange [8:16]
#set yrange [0.04:0.17]
#set ytics 0.04
#set xtics 2
#set samples 800, 800

path_to_directory = "./postProcessing/0/"
path_to_file = path_to_directory . "solidPointDisplacement_innerMidPointDisp.dat"

plot path_to_file u 1:(8+sgn($2)*sqrt($2**2+$3**2)) w l ls 2 notitle

set output
