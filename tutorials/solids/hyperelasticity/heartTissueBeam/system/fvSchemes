gradSchemes
{
    default none;
    // default leastSquares;

    grad(Dp) updatedLagGauss linear;
    // grad(Dp) Gauss linear;

    grad(DD) stabLeastSquares;
}

divSchemes
{
    default none;
    div(DD) Gauss linear;
}

laplacianSchemes
{
    default none;
    laplacian(DDD,DD) Gauss linear corrected;
    laplacian(DD,D) Gauss linear corrected;
    // laplacian(rAD,p) Gauss linear corrected;
}

snGradSchemes
{
    default corrected;
    snGrad(DD) corrected;
    // snGrad(DD)ho fourthPade;
}

interpolationSchemes
{
    default linear;
}


