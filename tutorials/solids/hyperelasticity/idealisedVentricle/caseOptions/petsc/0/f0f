FoamFile
{
    version     2.0;
    format      ascii;
    class       surfaceVectorField;
    object      f0f;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 0 0 0 0 0 0];

internalField uniform (0 0 1); //za ventricle 001

boundaryField
{
    fixed
    {
        type		calculated;
        value		$internalField;
    }

    inside
    {
        type		calculated;
        value		$internalField;
    }

    outside
    {
        type		calculated;
        value		$internalField;
    }

}


