FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      f0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 0 0 0 0 0 0];

internalField uniform (0 0 1); //za ventricle 001

boundaryField
{
    top
    {
        type		calculated;
        value		$internalField;
    }

    wall_inner
    {
        type		calculated;
        value		$internalField;
    }

    wall_outer
    {
        type		calculated;
        value		$internalField;
    }

    symmetry_1
    {
        type		symmetryPlane;
        value		$internalField;
    }

    symmetry_2
    {
        type		symmetryPlane;
        value		$internalField;
    }

}

