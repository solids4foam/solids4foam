FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 1 0 0 0 0 0];

internalField uniform (0 0 0);

boundaryField
{
    top
    {
        type		fixedValue;
        value		uniform (0 0 0);
    }

    wall_inner
    {
        type calculated;
        value uniform (0 0 0);
    }

    wall_outer
    {
        type calculated;
        value uniform (0 0 0);
    }

    symmetry_1
    {
        type		symmetry;
        value		uniform (0 0 0);
    }

    symmetry_2
    {
        type		symmetry;
        value		uniform (0 0 0);
    }
}

