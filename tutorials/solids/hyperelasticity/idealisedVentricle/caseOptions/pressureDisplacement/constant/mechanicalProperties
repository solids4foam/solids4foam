FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress no;

mechanical
(
    rubber
    {
        type GuccioneElastic;

        k k [ 1 -1 -2 0 0 0 0 ] 10000;
        cf 1;
        ct 1;
        cfs 1;

        rho  rho    [ 1 -3  0 0 0 0 0 ] 1000;

        // The penalty on volume change. coupledPressureDisplacementSolid
        // solves the pressure itself and takes 1/bulkModulus as the
        // compressibility of the pressure equation, so a bulk modulus this
        // large makes the material fully incompressible, as nu = 0.5 did for
        // the former mechanicalModel
        bulkModulus bulkModulus [ 1 -1 -2 0 0 0 0 ] 1e15;
    }

    // rubber
    // {
    //     type incompressibleNeoHookeanElastic;
    //     E E [ 1 -1 -2 0 0 0 0 ] 22500;
    //     rho rho [ 1 -3  0 0 0 0 0 ] 1000;
    //     nu nu [ 0 0 0 0 0 0 0 ] 0.5;
    // }
);

