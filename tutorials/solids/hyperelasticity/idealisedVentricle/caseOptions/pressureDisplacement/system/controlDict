FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          0.01;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
(
    tip_endo
    {
        type          solidPointDisplacement;
        point         (0 0 -0.017);
    }

    tip_epi
    {
        type          solidPointDisplacement;
        point         (0 0 -0.02);
    }

    traction
    {
        type          solidTractions;
    }
);

