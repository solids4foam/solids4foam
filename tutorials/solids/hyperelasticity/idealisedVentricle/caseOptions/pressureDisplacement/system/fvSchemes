FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default            none;
}

ddtSchemes
{
    default            steadyState;
}

gradSchemes
{
    default none;

    grad(Dp) updatedLagGauss linear;
    grad(DD) stabLeastSquares;
}

divSchemes
{
    default none;
    div(DD) Gauss linear;
}

laplacianSchemes
{
    default none;
    laplacian(DDD,DD) Gauss linear corrected;
    laplacian(DD,D) Gauss linear corrected;
    // laplacian(rAD,p) Gauss linear corrected;
}

snGradSchemes
{
    default none;
    snGrad(DD) corrected;
}

interpolationSchemes
{
    default linear;
}


