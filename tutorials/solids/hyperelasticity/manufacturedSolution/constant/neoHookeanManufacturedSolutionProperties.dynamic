FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      neoHookeanManufacturedSolutionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parameters of the manufactured solution
//
//     u(X, t) = a*S(X)*T(t),  S(X) = sin(nx*pi*x/L)*sin(ny*pi*y/L)*sin(nz*pi*z/L)
//
// This file is also included by constant/mechanicalProperties so that the
// material parameters used by the solid model and by the manufactured body
// force are the same.

// Material parameters of the neo-Hookean law
E               1e6;
nu              0.3;
rho             1000;

// Amplitude vector a: the displacement peaks at 2*a*S(X) when
// omegaT*t = pi, where the Jacobian J = 1 + a & grad(S) lies within
// approximately 1 -/+ 0.34
a               (0.04 0.03 0.02);

// Side length of the cube domain [0, L]^3
L               1;

// Number of half waves in each direction; the displacement is zero on the
// boundary for integer values
nWaves          (1 1 1);

// Time function T(t)
//     ramp:          T = min(t/rampTime, 1), quasi-static load ramp
//     cosine:        T = 1 - cos(omegaT*t), dynamic, starting from rest with
//                    a nonzero initial acceleration
//     cosineSquared: T = 0.5*(1 - cos(omegaT*t))^2, dynamic, starting from
//                    rest with zero initial acceleration, consistent with
//                    the zero initial state of the time schemes
timeFunction    cosine;
// Period 0.1 s; the pressure wave speed is approximately 36.7 m/s, so the
// inertia and stiffness terms of the momentum equation are of similar size
omegaT          62.8318530717959;

// ************************************************************************* //
