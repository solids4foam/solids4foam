FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Solve the momentum equation monolithically using a Jacobian-free
    // Newton-Krylov method via PETSc SNES; the PETSc options are specified in
    // system/fvSolution
    solutionAlgorithm   PETScSNES;

    // High-order residual: cubic kExactLeastSquares reconstruction of the
    // displacement with face quadrature, and volume integration of the
    // manufactured body force
    highOrderCoeffs
    {
        highOrderJacobian false;
        highOrderResidual true;

        displacement
        {
            type kExactLeastSquares;

            // Polynomial order of displacement field
            polynomialOrder 3;

            // Extra cells in minimum size stencil
            faceStencilExtraCells 65;

            // Weight function for least square systems
            weightFunctionCoeffs
            {
                type radiallySymmetricExponential;
                k 6;
            }

            calcConditionNumber false;
        }
    }

    stabilisation
    {
        momentum
        {
            type        alpha;
            scaleFactor 0.1;
        }
    }

    // Predict D at the start of each time step
    predictor           yes;
}

