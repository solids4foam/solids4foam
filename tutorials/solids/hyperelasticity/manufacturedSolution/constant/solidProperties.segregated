FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    // Solve the momentum equation using the segregated (outer-iteration)
    // approach
    solutionAlgorithm   implicitSegregated;

    // Maximum number of momentum correctors per load increment
    nCorrectors         100000;

    // Tight relative residual tolerance so that the discretisation error
    // dominates the iteration error
    rTol                1e-9;

    // Disable the step-norm convergence check so that convergence is
    // controlled by rTol only
    sTol                0;

    // Write frequency for the residuals
    infoFrequency       100;

    // Predict D at the start of each load increment
    predictor           yes;
}

// ************************************************************************* //
