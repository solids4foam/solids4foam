FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          petsc;
        options
        {
            // Nonlinear solver: Jacobian-free Newton-Krylov
            snes_type                       newtonls;
            // Tight tolerances so that the discretisation error dominates
            snes_rtol                       "1e-10";
            snes_atol                       "1e-14";
            snes_stol                       "1e-12";
            snes_max_it                     "1000";
            snes_monitor;
            snes_converged_reason;
            snes_mf;
            snes_mf_operator;
            // Linear solver
            ksp_type                        lgmres;
            ksp_gmres_restart               "100";
            ksp_rtol                        "1e-6";
            ksp_converged_reason;
            // Preconditioner: block Jacobi with LU, constructed once and reused
            pc_type                         bjacobi;
            sub_pc_type                     lu;
            snes_lag_preconditioner_persists true;
            snes_lag_preconditioner         "-2";
        }
    }
}

relaxationFactors
{}

// ************************************************************************* //
