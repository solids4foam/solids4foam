FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The material parameters are shared with the manufactured solution
#include "neoHookeanMMSProperties"

planeStress     no;

mechanical
(
    rubber
    {
        type            neoHookeanElastic;
        rho             rho [1 -3 0 0 0 0 0] $rho;
        E               E [1 -1 -2 0 0 0 0] $E;
        nu              nu [0 0 0 0 0 0 0] $nu;
    }
);

