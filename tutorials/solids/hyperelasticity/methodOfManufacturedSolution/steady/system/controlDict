FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ("libneoHookeanMMS.so");

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// The load is ramped linearly over rampTime = 1 (constant/neoHookeanMMSProperties)
// in four increments; the errors reported at t = 1 are the ones of interest
endTime         1;

deltaT          0.25;

writeControl    timeStep;

writeInterval   4;

cycleWrite      0;

writeFormat     ascii;

writePrecision  12;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

functions
{
    mms
    {
        // Errors with respect to the manufactured solution
        type    neoHookeanMMS;
    }
}

