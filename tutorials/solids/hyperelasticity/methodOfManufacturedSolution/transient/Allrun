#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'

usage()
{
    cat <<'USAGE'
Usage: ./Allrun [approach] [timeScheme] [mesh]

approach:   segregated (default), petscSnes
timeScheme: backward (default), Euler, NewmarkBeta
mesh:       hex (default), distHex, tet
USAGE
}

if [[ "${1:-}" =~ ^(-h|--help)$ ]]; then
    usage
    exit 0
fi

APPROACH="${1:-segregated}"
TIME_SCHEME="${2:-backward}"
MESH="${3:-hex}"

case "$APPROACH" in
    segregated|petscSnes) ;;
    *)
        echo "Error: unknown approach '$APPROACH'"
        usage
        exit 1
        ;;
esac

case "$TIME_SCHEME" in
    backward|Euler|NewmarkBeta) ;;
    *)
        echo "Error: unknown time scheme '$TIME_SCHEME'"
        usage
        exit 1
        ;;
esac

case "$MESH" in
    hex|distHex|tet) ;;
    *)
        echo "Error: unknown mesh '$MESH'"
        usage
        exit 1
        ;;
esac

: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"
export DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-}"
: "${FOAM_LD_LIBRARY_PATH:=}"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
source solids4FoamScripts.sh

if [[ "$APPROACH" == "petscSnes" ]]; then
    solids4Foam::requirePetscOrExitSilently
fi

for file in constant/solidProperties."${APPROACH}" \
            system/fvSolution."${APPROACH}" \
            system/fvSchemes."${TIME_SCHEME}"
do
    ln -vnsf "${file##*/}" "${file%.*}"
done

if [[ "$WM_PROJECT" == "foam" || "$WM_PROJECT_VERSION" != v* ]]; then
    # Use the tutorial source model where fvOptions is unavailable
    rm -f constant/solidProperties
    sed 's/^solidModel .*/solidModel neoHookeanMMSSolid;/' \
        "constant/solidProperties.$APPROACH" > constant/solidProperties
fi

solids4Foam::convertCaseFormat .

echo
echo "Compiling tutorial library..."
(cd ../src && ./Allwmake -s)

case "$MESH" in
    hex|distHex)
        solids4Foam::runApplication blockMesh
        if [[ "$MESH" == "distHex" ]]; then
            solids4Foam::runApplication perturbMeshPoints
        fi
        ;;
    tet)
        if ! command -v gmsh >/dev/null 2>&1; then
            echo "Gmsh is required for the $MESH mesh"
            exit 1
        fi
        mv 0 0.tmp
        # The cell size is set in gmsh/meshSpacing.geo
        solids4Foam::runApplication gmsh -3 -format msh2 gmsh/tet-structured.geo
        solids4Foam::runApplication gmshToFoam gmsh/tet-structured.msh
        solids4Foam::runApplication createPatch -overwrite
        mv 0.tmp 0
        ;;
esac

solids4Foam::runApplication solids4Foam
