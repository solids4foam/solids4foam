FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Manufactured body force per unit reference volume (OpenFOAM.com). On
// OpenFOAM.org and foam-extend, Allrun selects the tutorial-local
// neoHookeanMMSSolid model, which adds the same source. The parameters are
// read from constant/neoHookeanMMSProperties.
momentumSource
{
    type            neoHookeanMMSSource;
    fields          (D);
}

