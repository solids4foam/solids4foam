FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      f0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 0 0 0 0 0 0];

internalField uniform (0 0 1);

boundaryField
{
    inside
    {
        type		calculated;
        value		$internalField;
    }

    outside
    {
        type		calculated;
        value		$internalField;
    }

    "(symm.*)"
    {
        type            symmetryPlane;
        value           uniform (0 0 0);
    }
}

