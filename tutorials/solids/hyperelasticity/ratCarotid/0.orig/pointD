FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inside
    {
        type calculated;
        value uniform (0 0 0);
    }

    outside
    {
        type calculated;
        value uniform (0 0 0);
    }

    "(symm.*)"
    {
        type symmetry;
        value uniform (0 0 0);
    }

    frontAndBack
    {
        type empty;
    }
}

