FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      psi0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions			[0 0 0 0 0 0 0];

internalField		uniform 0;

boundaryField
{
	inside
	{
		type		fixedValue;
		value		uniform 0;
	}
	outside
	{
		type		fixedValue;
		value		uniform 1;
	}

	"symm.*"
	{
		type		symmetry;
	}
}

