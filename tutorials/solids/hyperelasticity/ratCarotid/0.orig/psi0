internalField		uniform 0;

boundaryField
{
	inside
	{
		type		fixedValue;
		value		uniform 0;
	}
	outside
	{
		type		fixedValue;
		value		uniform 1;
	}

	"symm.*"
	{
		type		symmetryPlane;
	}
}


