#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

solids4Foam::caseOnlyRunsWithFoamExtend

if ! command -v calcLocCoordinates &> /dev/null
then
    echo; echo "Skipping this case as calcLocCoordinates is not installed"; echo
    exit 0
fi

# Create mesh
BLOCK_MESH_DICT_DIR=$(solids4Foam::blockMeshDictDir)
mkdir -p "${BLOCK_MESH_DICT_DIR}"
m4 -P system/blockMeshDict.m4 > "${BLOCK_MESH_DICT_DIR}"/blockMeshDict
runApplication blockMesh

# Create 0 folder
mkdir 0
cp -r 0.orig/Dp ./0
cp -r 0.orig/DD ./0
cp -r 0.orig/pointDD ./0
cp -r 0.orig/psi0 ./0
cp -r 0.orig/psi1 ./0

# Calculate local coordinate systems
runApplication calcLocCoordinates

# Run solver
runApplication solids4Foam


# ----------------------------------------------------------------- end-of-file
