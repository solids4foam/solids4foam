FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    DDDp
    {
        solver BiCGStab;
        preconditioner Cholesky;

        minIter         1;
        maxIter         500;

        tolerance       1e-13;
        relTol          1e-3;
    }

    "psi0|psi1"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 5;
}

relaxationFactors
{
    fields
    {
        Dp               0.98;
        DpFinal          0.98;
        DD               0.98;
        DDFinal          0.98;

        nonLinForceCorrection 1;
    }

    equations
    {
        DD               0.98;
        DDFinal          0.98;
    }
}

