#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'

# -------------------------------------------------------------------------
# solids4Foam Allrun script
# Allows selection of solution approach:
#   totalLagrangian (default), updatedLagrangian, totalLagrangianPetscSnes,
#   updatedLagrangianPetscSnes, highOrder, highOrderUpdatedLagrangian
# -------------------------------------------------------------------------

usage() {
cat <<'EOF'
Usage:
  ./Allrun [approach]

Where [approach] is one of:
  totalLagrangian       (default)
  updatedLagrangian
  totalLagrangianPetscSnes
  updatedLagrangianPetscSnes
  highOrder
  highOrderUpdatedLagrangian

Examples:
  ./Allrun
  ./Allrun totalLagrangian
  ./Allrun updatedLagrangian
  ./Allrun totalLagrangianPetscSnes
  ./Allrun updatedLagrangianPetscSnes
  ./Allrun highOrder
  ./Allrun highOrderUpdatedLagrangian
EOF
}

# -------------------------------------------------------------------------
# Environment setup
# -------------------------------------------------------------------------

export DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-}"
: "${FOAM_LD_LIBRARY_PATH:=}"

: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
source solids4FoamScripts.sh

# -------------------------------------------------------------------------
# Parse approach
# -------------------------------------------------------------------------

if [[ "${1:-}" =~ ^(-h|--help)$ ]]; then
    usage
    exit 0
fi

APPROACH="${1:-totalLagrangian}"

# Validate approach name
case "$APPROACH" in
    totalLagrangian|updatedLagrangian|totalLagrangianPetscSnes|updatedLagrangianPetscSnes|highOrder|highOrderUpdatedLagrangian) ;;
    *)
        echo "Error: Unknown approach '$APPROACH'"
        usage
        exit 1
        ;;
esac

# -------------------------------------------------------------------------
# Functions
# -------------------------------------------------------------------------

link_files_for_suffix() {
    # $1 = suffix (e.g. totalLagrangian)
    local suffix="$1"
    local found=0
    while IFS= read -r -d '' f; do
        found=1
        ln -vnsf "$(basename "$f")" "${f%.*}"
    done < <(find ./0 ./constant ./system -type f -name "*.${suffix}" -print0 2>/dev/null || true)

    if (( !found )); then
        echo "Warning: No *.${suffix} files found under ./0 ./constant ./system."
    fi
}

link_default_control_dict() {
    # link_files_for_suffix links system/controlDict.<approach> when the approach
    # provides one; otherwise the controlDict symlink may still point at the
    # variant used by a previous run, so reset it to the default here
    if [[ ! -f "system/controlDict.${APPROACH}" ]]; then
        ln -vnsf controlDict.default system/controlDict
    fi
}

require_petsc_or_exit_silently() {
    solids4Foam::requirePetscOrExitSilently
}

select_approach() {
    echo "Using the $APPROACH approach"
    case "$APPROACH" in
        totalLagrangian|totalLagrangianPetscSnes|highOrder)
            if [[ "$APPROACH" == *"PetscSnes" || "$APPROACH" == "highOrder" ]]; then
                require_petsc_or_exit_silently
            fi
            if [[ "$APPROACH" == highOrder* ]]; then
                solids4Foam::caseDoesNotRunWithFoamExtend
            fi
            link_files_for_suffix "$APPROACH"
            (cd 0 && rm -f D* && ln -s org/D .)
            ;;
        updatedLagrangian|updatedLagrangianPetscSnes|highOrderUpdatedLagrangian)
            if [[ "$APPROACH" == *"PetscSnes" || "$APPROACH" == highOrder* ]]; then
                require_petsc_or_exit_silently
            fi
            if [[ "$APPROACH" == highOrder* ]]; then
                solids4Foam::caseDoesNotRunWithFoamExtend
            fi
            link_files_for_suffix "$APPROACH"
            (cd 0 && rm -f D* && ln -s org/DD .)
            ;;
    esac

    link_default_control_dict
}

# -------------------------------------------------------------------------
# Main workflow
# -------------------------------------------------------------------------

select_approach

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create mesh
solids4Foam::runApplication blockMesh

# Run solver
solids4Foam::runApplication solids4Foam
