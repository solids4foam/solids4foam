FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// The prescribed rotation rate is 10 degrees per second, so this end time
// corresponds to 80 degrees of rigid rotation, rather than the 100 degrees used
// by the other approaches.
// The rotation is stopped short because the PETSc SNES Jacobian used by this
// approach diverges at approximately 90 degrees: the segregated approach and
// the high-order PETSc SNES approaches all complete the full 100 degrees. See
// the test coverage tracking issue for details.
endTime         8;

deltaT          0.2;

writeControl    runTime;

writeInterval   1;

cycleWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

// ************************************************************************* //
