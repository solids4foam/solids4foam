FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    foundationContact
    {
        type            solidContact;
        master          yes;
        rigidMaster     no;
        shadowPatch     slabContact;
        useNewPointDistanceMethod no;
        usePrevCandidateMasterNeighbors no;
        writePointDistanceFields false;
        // The contact traction relaxation factors (0.005 normal, 0.01
        // friction) are larger than in the original benchmark (0.0001), where
        // the momentum loop reached nCorrectors in almost every time step
        normalContactModel standardPenalty;
        standardPenaltyNormalModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.005;
        }
        frictionContactModel standardPenalty;
        standardPenaltyFrictionModelDict
        {
            relaxationFactor 0.01;
            penaltyScale     1;
            frictionLaw     coulomb;
            frictionLawDict
            {
                frictionCoeff   0.3;
            }
        }
        value           uniform (0 0 0);
    }

    slabContact
    {
        type            solidContact;
        shadowPatch     foundationContact;
        master          no;
        value           uniform (0 0 0);
    }

    zeroTraction
    {
        type            solidTraction;
        gradient        uniform ( 0 0 0 );
        traction        uniform ( 0 0 0 );
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    fixed
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }

    frontAndBack
    {
        type            empty;
    }

    displacement
    {
        type            fixedDisplacement;
        displacementSeries
        {
            "fileName|file"       "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds    clamp;
        }
        value           uniform (0 0 0);
    }
}


