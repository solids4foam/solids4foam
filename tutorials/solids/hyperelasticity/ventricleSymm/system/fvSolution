FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    DDDp
    {
        solver BiCGStab;

        // preconditioner Cholesky;

        preconditioner
        {
            preconditioner Cholesky;

            // cycle V-cycle;
            // nPreSweeps 2;
            // nPostSweeps 2;
            // nMaxLevels 100;
            // scale on;
            // coarseningType SAMG;
            // groupSize 2;
            // minCoarseEqns 4;
            // norm componentNorm;
            // normComponent 3;
            // smoother ILU;
        }


        // preconditioner //ILUCp; //Cholesky BlockAMG GaussSeidel ILUC0 ILUCp;
        // {
        //     preconditioner ILUC0;
        //     fillInLevel 1;
        // }

        minIter			1;
        maxIter			500;

        tolerance		1e-22;
        relTol			1e-4;
    }

    DDDp_
    {
        solver BiCGStab;
        preconditioner Cholesky;

        minIter			3;
        maxIter			5000;

        tolerance		1e-16;
        relTol			1e-2;
    }

    DDDp__
    {
        solver          AMG;
        cycle           V-cycle; // W-cycle;
        coarseningType  SAMG;
        norm            componentNorm;
        normComponent   3;

        minGroupSize    2;
        maxGroupSize    4;

        nPreSweeps      2;
        nPostSweeps     2;
        groupSize       2;
        minCoarseEqns   4;
        nMaxLevels      100;
        scale           on;
        smoother        ILUC0;

//        {
//            smoother    ILU;
//            fillInLevel 1;
//        }

        minIter         0;
        maxIter         300;
        tolerance       1e-20;
        relTol          1e-4;
    }
}

relaxationFactors
{
    fields
    {
        Dp 0.99;
        DD 0.99;
        // ".*Final" 1;

        nonLinForceCorrection 1;
    }

    equations
    {
        DD 0.99;
        DDFinal 0.99;
        // ".*Final" 0.99;
    }
}

