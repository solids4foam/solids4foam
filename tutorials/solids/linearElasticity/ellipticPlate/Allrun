#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'

# -------------------------------------------------------------------------
# solids4Foam Allrun script
# Allows selection of solution approach:
#   petscSnes (default), segregated, unsCoupled
# -------------------------------------------------------------------------

usage() {
cat <<'EOF'
Usage:
  ./Allrun [approach]

Where [approach] is one of:
  petscSnes       (default)
  segregated
  unsCoupled

Examples:
  ./Allrun
  ./Allrun segregated
  ./Allrun unsCoupled
EOF
}

# -------------------------------------------------------------------------
# Environment setup
# -------------------------------------------------------------------------

export DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-}"
: "${FOAM_LD_LIBRARY_PATH:=}"
: "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
source solids4FoamScripts.sh

# -------------------------------------------------------------------------
# Parse approach
# -------------------------------------------------------------------------

if [[ "${1:-}" =~ ^(-h|--help)$ ]]; then
    usage
    exit 0
fi

APPROACH="${1:-petscSnes}"

case "$APPROACH" in
    petscSnes|segregated|unsCoupled) ;;
    *)
        echo "Error: Unknown approach '$APPROACH'"
        usage
        exit 1
        ;;
esac

# -------------------------------------------------------------------------
# Functions
# -------------------------------------------------------------------------

link_files_for_suffix() {
    # $1 = suffix (e.g. petscSnes)
    local suffix="$1"
    local found=0
    while IFS= read -r -d '' f; do
        found=1
        rm -f "${f%.*}"
        ln -vnsf "$(basename "$f")" "${f%.*}"
    done < <(find ./0 ./constant ./system \( -type f -o -type l \) -name "*.${suffix}" -print0 2>/dev/null || true)

    if (( !found )); then
        echo "Warning: No *.${suffix} files found under ./0 ./constant ./system."
    fi
}

select_block_mesh_dict() {
    if [[ "${WM_PROJECT:-}" == "foam" ]]
    then
        echo "Using the foam-extend blockMeshDict"
        mkdir -p constant/polyMesh
        rm -f system/blockMeshDict
        ln -vnsf ../../system/blockMeshDict.foamextend constant/polyMesh/blockMeshDict
    else
        echo "Using the OpenFOAM blockMeshDict"
        rm -f constant/polyMesh/blockMeshDict
        ln -vnsf blockMeshDict.openfoam system/blockMeshDict
    fi
}

require_petsc_or_exit_silently() {
    if [[ "$APPROACH" == "petscSnes" && -z "${PETSC_DIR:-}" ]]
    then
        echo; echo "Skipping this case as PETSc is not installed"
        echo "Please set the PETSC_DIR variable"; echo
        exit 0
    fi
}

select_approach() {
    case "$APPROACH" in
        petscSnes)
            echo "Using the petscSnes approach"
            link_files_for_suffix "petscSnes"
            ;;
        segregated)
            echo "Using the segregated approach"
            link_files_for_suffix "segregated"
            ;;
        unsCoupled)
            echo "Using the unsCoupled approach"
            solids4Foam::caseOnlyRunsWithFoamExtend
            link_files_for_suffix "unsCoupled"
            ;;
    esac
}

# -------------------------------------------------------------------------
# Main workflow
# -------------------------------------------------------------------------

require_petsc_or_exit_silently

select_approach

# Check case version is correct
solids4Foam::convertCaseFormat .

select_block_mesh_dict

# Create mesh
solids4Foam::runApplication blockMesh

# Run solver
solids4Foam::runApplication solids4Foam
