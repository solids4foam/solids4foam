FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     linearGeometryTotalDisplacement;

linearGeometryTotalDisplacementCoeffs
{
    solutionAlgorithm PETScSNES;

    // Mixed displacement-pressure formulation: the pressure p is a separate
    // unknown, compression positive (sigma = dev(sigma) - p*I)
    solvePressure     yes;

    // Implicit stiffness of the mixed formulation: 2*mu, as declared by the
    // mechanical constitutive law (the default, deviatoric, is (4/3)*mu for
    // this linear elastic law)
    mixedImplicitStiffness twoMu;

    // Algebraic scaling of the mixed PETSc system: the pressure unknown is
    // stored as p/(2*mu) and the pressure rows are multiplied by 2*mu, with
    // 2*mu the volume average declared by the law. The converged solution is
    // unchanged; the linear solves are better conditioned
    scaleMixedPETScFields yes;

    // One representative stabilisation configuration. The pressure term is
    // the generalised even-order Laplacian with m = laplacianPower = 1 (the
    // bi-Laplacian), unnormalised. These coefficients verify the current
    // development implementation; they do not reproduce published results
    stabilisation
    {
        momentum
        {
            type        diffStencilLaplacian;
            scaleFactor 0.1;
        }

        pressure
        {
            type                generalisedEvenOrderLaplacian;
            laplacianPower      1;
            scaleFactor         0.125;
            scaleFactorJacobian 1.0;
        }
    }
}

