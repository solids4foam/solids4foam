FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ("libplateHoleAnalytical.so");

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
(
    // pointHistory
    // {
    //     type pointHistory;
    //     refHistoryPoint	( 0.2 0 0.005 );
    // }

    plateHoleAnalyticalSolution1
    {
        type plateHoleAnalyticalSolution;
        farFieldTractionX 1e6;
        holeRadius    1;
        pressureDisplacement yes;
        cellStress    no;
        pointStress   no;
        deriveMaterialProperties yes;
    }
);


