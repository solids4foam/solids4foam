ddtSchemes
{
	default		steadyState;
}

d2dt2Schemes
{
	default		steadyState;
}

gradSchemes
{
    default none; //Gauss linear;
    // default leastSquares;

    grad(p) Gauss linear;
    grad(Dp) Gauss linear;
    grad(D) stabLeastSquares;
    grad(DD) stabLeastSquares;
}

divSchemes
{
    default none;
    div(DD) Gauss linear;
}

laplacianSchemes
{
    default none;

    // laplacian(rAD,p) Gauss linear uncorr;

    laplacian(DD,D) Gauss linear skewCorrected 1;
    laplacian(DDD,DD) Gauss linear skewCorrected 1;
}

snGradSchemes
{
    default none;
    snGrad(D) skewCorrected 1;
    snGrad(DD) skewCorrected 1;
    snGrad(DD)ho skewCorrected 1;
}

