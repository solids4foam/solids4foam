FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress no;

mechanical
(
    rubber
    {
        // Although this law is named neoHookeanElastic, the
        // coupledPressureDisplacementSolid solidProperties set nonLinear false,
        // so this case follows the linear-geometry linear-elastic formulation.
        type neoHookeanElastic;
        pressureDisplacement yes;
        E    E      [ 1 -1 -2 0 0 0 0 ] 1e9;
        rho  rho    [ 1 -3  0 0 0 0 0 ] 1;
        nu   nu     [ 0 0 0 0 0 0 0 ]   0.5;
    }
);

