FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     linearGeometryTotalDisplacement;

linearGeometryTotalDisplacementCoeffs
{
    // Solution algorithm
    solutionAlgorithm    PETScSNES;

    // Solve the mixed displacement-pressure (u-p) form, where the
    // hydrostatic stress is carried by a separate pressure equation and the
    // implicit stiffness becomes the deviatoric tangent (4/3)*mu
    solvePressure        yes;
    useMechanicalConstitutiveLawManager yes;
}

