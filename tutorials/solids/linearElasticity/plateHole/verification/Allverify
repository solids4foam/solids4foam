#!/usr/bin/env bash
set -euo pipefail

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required for plateHole verification." >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set solids4foam library paths, including DYLD_LIBRARY_PATH on macOS.
source solids4FoamScripts.sh

exec python3 "${SCRIPT_DIR}/scripts/plate_hole_verification.py" "$@"
