#!/bin/bash
#
# Fourier verification of the pressure-stabilisation operators.
#
#   ./Allrun          16 cells per active axis: stabilisationFourierCheck
#                     (raw and spectrally normalised campaigns, with the
#                     analytical symbol sweep) and the parameter-validation
#                     checks
#   ./Allrun refine   the same for 16, 32 and 64 cells per active axis
#
# Both then write the fields of system/stabilisationFourierCheckDict.fields
# and check a 3-D level, 8^3 cells cyclic in x, y and z, with
# referenceNyquistDirections 3 (system/stabilisationFourierCheckDict.3D).
#
# stabilisationFourierCheck exits nonzero if a measured eigenvalue differs from
# its analytical symbol by more than the tolerance in
# system/stabilisationFourierCheckDict, so the run stops on a failed check. If
# gnuplot is available, plotSymbols.gnuplot plots the analytical cuts and the
# measured eigenvalues.
set -e
cd "${0%/*}" || exit 1

case "${1:-}" in
    "") levels="16" ;;
    refine) levels="16 32 64" ;;
    -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Usage: ./Allrun [refine]" >&2; exit 2 ;;
esac

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
source solids4FoamScripts.sh
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::convertCaseFormat .

for N in $levels; do
    # One blockMesh dictionary per level; system/blockMeshDict stays at 16
    sed "s/^nCells .*/nCells          $N;/" system/blockMeshDict \
        > "system/blockMeshDict.N$N"
    solids4Foam::runApplication -s "N$N" blockMesh -dict "system/blockMeshDict.N$N"
    solids4Foam::runApplication -s "N$N" stabilisationFourierCheck -symbolSweep
    tail -n 2 "log.stabilisationFourierCheck.N$N"
done

# Field output: the pressure modes and the model responses S(p) of
# system/stabilisationFourierCheckDict.fields, written to 0/. The utility
# exits nonzero if a mode is not an eigenmode of a model
solids4Foam::runApplication -s fields stabilisationFourierCheck \
    -dict stabilisationFourierCheckDict.fields -writeFields
tail -n 2 log.stabilisationFourierCheck.fields

# Parameter validation: each dictionary must be refused, with its message.
# The output of these expected failures is written to expectedError.<dict>,
# not log.*, so that tutorials/Alltest does not report its FOAM FATAL ERROR
failures=0
checkRejected()
{
    local dictName="$1"
    local expected="$2"
    local log="expectedError.$dictName"
    if stabilisationFourierCheck -dict "$dictName" -constructOnly > "$log" 2>&1
    then
        echo "FAIL rejection: $dictName was accepted"
        failures=$((failures + 1))
    elif grep -Fq "$expected" "$log"; then
        echo "PASS rejection: $dictName"
    else
        echo "FAIL rejection: $dictName (expected: $expected)"
        failures=$((failures + 1))
    fi
}
checkRejected rejectRStarZero \
    "referenceNyquistDirections must be greater than zero"
checkRejected rejectRStarFour \
    "referenceNyquistDirections must be in the valid range 1 .. 2"
checkRejected rejectRStarThree2D \
    "referenceNyquistDirections must be in the valid range 1 .. 2"
checkRejected rejectRStarMissing \
    "referenceNyquistDirections is required when spectralNormalisation is true"
checkRejected rejectAlpha \
    "Spectral normalisation is not supported by stabilisation model alpha"
checkRejected rejectGradDiv \
    "Spectral normalisation is not supported by stabilisation model gradDiv"
checkRejected rejectVolStrainRate \
    "Spectral normalisation is not supported by stabilisation model volStrainRate"
checkRejected rejectMultiple \
    "Spectral normalisation is not supported by stabilisation model multiple"
checkRejected rejectNegativePower \
    "laplacianPower must be non-negative"

# A renamed, reversed pair that shares an implementation but differs in the
# last bit must fail the bitwise requirement. It runs as a separate case,
# bitwisePair/, so that its results do not replace those of the checks above
rm -rf bitwisePair
mkdir bitwisePair
cp -r constant system bitwisePair/
if stabilisationFourierCheck -case bitwisePair \
    -dict stabilisationFourierCheckDict.bitwisePair \
    > expectedError.bitwisePair 2>&1
then
    echo "FAIL bitwise pair: accepted although not bitwise equal"
    failures=$((failures + 1))
elif grep -q '^pair m0/laplacian .* FAIL$' expectedError.bitwisePair; then
    echo "PASS bitwise pair: m0/laplacian must agree bitwise"
else
    echo "FAIL bitwise pair: no failed pair check in expectedError.bitwisePair"
    failures=$((failures + 1))
fi

# The keyword spectralNormalisation must be accepted
if stabilisationFourierCheck -dict acceptSpectralNormalisation -constructOnly \
    > log.stabilisationFourierCheck.acceptSpectralNormalisation 2>&1
then
    echo "PASS accepted: acceptSpectralNormalisation"
else
    echo "FAIL accepted: acceptSpectralNormalisation was refused"
    failures=$((failures + 1))
fi
if [ "$failures" -ne 0 ]; then
    echo "$failures parameter-validation check(s) failed"
    exit 1
fi

# 3-D level, after the parameter validation, whose messages depend on the 2-D
# mesh: the symbols with three active directions and the normalised reference
# mode in all three
solids4Foam::runApplication -s 3D blockMesh -dict system/blockMeshDict.3D
solids4Foam::runApplication -s 3D stabilisationFourierCheck \
    -dict stabilisationFourierCheckDict.3D
tail -n 2 log.stabilisationFourierCheck.3D

if command -v gnuplot > /dev/null 2>&1; then
    echo "Plotting postProcessing/stabilisationFourierCheck/symbols_N16.png"
    gnuplot plotSymbols.gnuplot > /dev/null 2>&1 \
        || echo "gnuplot failed; the checks above are unaffected"
else
    echo "Install gnuplot to plot the analytical symbols"
fi
