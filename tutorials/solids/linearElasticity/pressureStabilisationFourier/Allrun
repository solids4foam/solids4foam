#!/bin/bash
#
# Fourier verification of the pressure-stabilisation operators.
#
#   ./Allrun          16 cells per active axis: stabilisationFourierCheck
#                     (raw and spectrally normalised campaigns, with the
#                     analytical symbol sweep) and the parameter-validation
#                     checks
#   ./Allrun refine   the same for 16, 32 and 64 cells per active axis
#
# stabilisationFourierCheck exits nonzero if a measured eigenvalue differs from
# its analytical symbol by more than the tolerance in
# system/stabilisationFourierDict, so the run stops on a failed check. If
# gnuplot is available, plotSymbols.gnuplot plots the analytical cuts and the
# measured eigenvalues.
set -e
cd "${0%/*}" || exit 1

case "${1:-}" in
    "") levels="16" ;;
    refine) levels="16 32 64" ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Usage: ./Allrun [refine]" >&2; exit 2 ;;
esac

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
source solids4FoamScripts.sh
solids4Foam::caseDoesNotRunWithFoamExtend
solids4Foam::convertCaseFormat .

for N in $levels; do
    # One blockMesh dictionary per level; system/blockMeshDict stays at 16
    sed "s/^nCells .*/nCells          $N;/" system/blockMeshDict \
        > "system/blockMeshDict.N$N"
    solids4Foam::runApplication -s "N$N" blockMesh -dict "system/blockMeshDict.N$N"
    solids4Foam::runApplication -s "N$N" stabilisationFourierCheck -symbolSweep
    tail -n 2 "log.stabilisationFourierCheck.N$N"
done

# Parameter validation: each dictionary must be refused, with its message
failures=0
checkRejected()
{
    local dictName="$1"
    local expected="$2"
    local log="log.stabilisationFourierCheck.$dictName"
    if stabilisationFourierCheck -dict "$dictName" -constructOnly > "$log" 2>&1
    then
        echo "FAIL rejection: $dictName was accepted"
        failures=$((failures + 1))
    elif grep -Fq "$expected" "$log"; then
        echo "PASS rejection: $dictName"
    else
        echo "FAIL rejection: $dictName (expected: $expected)"
        failures=$((failures + 1))
    fi
}
checkRejected rejectRStarZero \
    "referenceNyquistDirections must be greater than zero"
checkRejected rejectRStarFour \
    "referenceNyquistDirections must be in the valid range 1 .. 2"
checkRejected rejectRStarThree2D \
    "referenceNyquistDirections must be in the valid range 1 .. 2"
checkRejected rejectRStarMissing \
    "referenceNyquistDirections is required when spectralNormalisation is true"
checkRejected rejectAlpha \
    "Spectral normalisation is not supported by stabilisation model alpha"
checkRejected rejectGradDiv \
    "Spectral normalisation is not supported by stabilisation model gradDiv"
checkRejected rejectVolStrainRate \
    "Spectral normalisation is not supported by stabilisation model volStrainRate"
checkRejected rejectMultiple \
    "Spectral normalisation is not supported by stabilisation model multiple"
checkRejected rejectNegativePower \
    "laplacianPower must be non-negative"
checkRejected rejectBothSpellings \
    "Both spectralNormalisation and its deprecated alias normalise are given"

# The switch spelling: spectralNormalisation is the keyword, normalise its
# deprecated alias. Each dictionary must be accepted, with the deprecation
# warning for the alias only
checkAccepted()
{
    local dictName="$1"
    local warns="$2"
    local log="log.stabilisationFourierCheck.$dictName"
    if ! stabilisationFourierCheck -dict "$dictName" -constructOnly > "$log" 2>&1
    then
        echo "FAIL accepted: $dictName was refused"
        failures=$((failures + 1))
    elif [ "$warns" = yes ] \
      && ! grep -Fq "The keyword normalise is deprecated" "$log"
    then
        echo "FAIL accepted: $dictName (no deprecation warning)"
        failures=$((failures + 1))
    elif [ "$warns" = no ] && grep -Fq "deprecated" "$log"; then
        echo "FAIL accepted: $dictName (unexpected deprecation warning)"
        failures=$((failures + 1))
    else
        echo "PASS accepted: $dictName"
    fi
}
checkAccepted acceptSpectralNormalisation no
checkAccepted acceptNormaliseAlias yes
if [ "$failures" -ne 0 ]; then
    echo "$failures parameter-validation check(s) failed"
    exit 1
fi

if command -v gnuplot > /dev/null 2>&1; then
    echo "Plotting postProcessing/stabilisationFourierCheck/symbols_N16.png"
    gnuplot plotSymbols.gnuplot > /dev/null 2>&1 \
        || echo "gnuplot failed; the checks above are unaffected"
else
    echo "Install gnuplot to plot the analytical symbols"
fi
