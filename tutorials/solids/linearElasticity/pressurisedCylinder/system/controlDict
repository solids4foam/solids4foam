FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ("libpressurisedCylinderAnalytical.so");

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    runTime;

writeInterval   1;

cycleWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

functions
{
    pressurisedCylinderAnalytical
    {
       type    pressurisedCylinderAnalyticalSolution;
       Ri      7;
       Ro      18.625;
       p       10e6;
       E       1e10;
       nu      0.3;
       cellDisplacement yes;
       pointDisplacement no;
       cellStress yes;
       pointStress no;
    }

    disp
    {
       type    solidPointDisplacement;
       point   (7.0 0 0);
    }

    transformStressToCylindrical
    {
        type        transformStressToCylindrical;

        origin      (0 0 0);
        axis        (0 0 1);
    }
}

