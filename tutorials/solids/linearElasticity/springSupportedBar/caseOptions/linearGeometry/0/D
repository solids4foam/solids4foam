FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    springEnd
    {
        type            solidSpringDashpot;
        kNormal         uniform 1e7;    // [Pa/m]
        value           uniform (0 0 0);
    }
    loadedEnd
    {
        type            solidTraction;
        traction        uniform (1000 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    sides
    {
        type            solidSymmetry;
        patchType       symmetry;
        value           uniform (0 0 0);
    }
}

