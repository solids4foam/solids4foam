FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Bar of length 10 mm along x, square cross-section of side 3 mm
scale 1;

vertices
(
    (0    0    0)
    (0.01 0    0)
    (0.01 0.003 0)
    (0    0.003 0)
    (0    0    0.003)
    (0.01 0    0.003)
    (0.01 0.003 0.003)
    (0    0.003 0.003)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (20 3 3) simpleGrading (1 1 1)
);

edges
(
);

patches
(
    patch springEnd
    (
        (0 4 7 3)
    )
    patch loadedEnd
    (
        (1 2 6 5)
    )
    patch sides
    (
        (0 1 5 4)
        (3 7 6 2)
        (0 3 2 1)
        (4 5 6 7)
    )
);

mergePatchPairs
(
);

