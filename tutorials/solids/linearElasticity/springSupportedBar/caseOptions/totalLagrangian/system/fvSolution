FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-14;
        relTol          0.01;
    }
}

relaxationFactors
{
    equations
    {
    }
    // The whole 20 % stretch is applied in one step, and the segregated
    // iterations oscillate in the lateral contraction. With a D relaxation
    // factor of 0.7 or more they diverge on x86-64.
    fields
    {
        D       0.5;
    }
}

