FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The processor boundary lies exactly on the material interface: every cell of
// the inner material on one processor, every cell of the outer on the other.
// constant/cellDecomposition is written by Allrun from the inner cellSet
numberOfSubdomains 2;

method          manual;

manualCoeffs
{
    dataFile    "cellDecomposition";
}


// ************************************************************************* //
