FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Four processors whose boundaries cut across the material interface, so the
// material-filtered gradient stencil meets both materials at a processor
// boundary
numberOfSubdomains 4;

method          simple;

simpleCoeffs
{
    n           (2 2 1);
    delta       0.001;
}


// ************************************************************************* //
