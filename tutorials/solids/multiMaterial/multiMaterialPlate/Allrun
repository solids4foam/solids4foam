#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

# "./Allrun" runs the plate with a mid-layer of thickness h = 0.01W using the
# segregated solution algorithm. The arguments, in any order, select
#   - the thickness as h/W: 0.002, 0.005, 0.01 or 0, which is the bi-material
#     plate with no mid-layer
#   - the solution algorithm: segregated or petscSnes
H_OVER_W="0.01"
APPROACH="segregated"
for arg in "$@"
do
    case "${arg}" in
        0|0.002|0.005|0.01)
            H_OVER_W="${arg}"
            ;;
        segregated|petscSnes)
            APPROACH="${arg}"
            ;;
        *)
            echo "Usage: ./Allrun [0|0.002|0.005|0.01] [segregated|petscSnes]"
            exit 1
            ;;
    esac
done

if [[ "${H_OVER_W}" == "0" ]]
then
    MATERIALS="twoMaterials"
else
    MATERIALS="threeMaterials"
fi

if [[ "${APPROACH}" == "petscSnes" ]]
then
    solids4Foam::requirePetscOrExitSilently
fi

# Create the dictionaries for the selected mid-layer thickness and solution
# algorithm
echo "Creating the case for h/W = ${H_OVER_W} with the ${APPROACH} approach"
if [[ "${MATERIALS}" == "twoMaterials" ]]
then
    cp system/blockMeshDict.twoMaterials system/blockMeshDict
    cp system/sample.twoMaterials system/sample
else
    m4 -P -DhOverW="${H_OVER_W}" system/blockMeshDict.threeMaterials.m4 \
        > system/blockMeshDict
    m4 -P -DhOverW="${H_OVER_W}" system/sample.threeMaterials.m4 \
        > system/sample
fi
cp system/sample system/sampleDict
cp "constant/mechanicalProperties.${MATERIALS}" constant/mechanicalProperties
cp "constant/solidProperties.${APPROACH}" constant/solidProperties
cp "system/fvSolution.${APPROACH}" system/fvSolution

# Check case version is correct
solids4Foam::convertCaseFormat .

# Create mesh, where each block is a material cellZone
solids4Foam::runApplication blockMesh

# Run solver
solids4Foam::runApplication solids4Foam

# Sample stress along the interfaces
if [[ $WM_PROJECT = "foam" ]]
then
    solids4Foam::runApplication sample -latestTime
else
    solids4Foam::runApplication postProcess -func sample -latestTime
fi

# Create plots
if command -v gnuplot &> /dev/null
then
    echo "Generating sigmaxx.png and sigmaxxMidLine.png using gnuplot"
    gnuplot -e "hOverW=${H_OVER_W}" plot.gnuplot &> /dev/null
else
    echo "Please install gnuplot if you would like to generate the plots"
fi
