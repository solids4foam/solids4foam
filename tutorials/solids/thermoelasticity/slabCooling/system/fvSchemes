FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default                steadyState; //Euler;
}

ddtSchemes
{
    default                steadyState; //Euler;
}

gradSchemes
{
    // leastSquaresS4f needs a list of the patches whose face values enter
    // the least-squares stencils, which the solid models register for D but
    // not for the scalar fields
    default            leastSquares;
    grad(D)            leastSquaresS4f;
    snGradCorr(D)      leastSquaresS4f;
}

divSchemes
{
    default                none;
}

laplacianSchemes
{
    default                none;
    laplacian(DD,D)        Gauss linear corrected;
    laplacian(k,T)         Gauss linear corrected;
}

snGradSchemes
{
    default                none;
    snGrad(D)              corrected;
}

interpolationSchemes
{
    default                linear;
}

