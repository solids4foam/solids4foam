FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default            none;
    d2dt2(D)           steadyState;
}

ddtSchemes
{
    default            none;
    ddt(D)             steadyState;
    ddt(T)             Euler;
}

gradSchemes
{
    default            none;
    grad(U)            leastSquaresS4f;
    grad(T)            leastSquaresS4f;
    grad(D)            leastSquaresS4f;
    grad(DD)           leastSquaresS4f;
    snGradCorr(D)      leastSquaresS4f;
    snGradCorr(DD)     leastSquaresS4f;
}

divSchemes
{
    default            none;
    div(sigma)         Gauss linear;
    div((impK*grad(D))) Gauss linear;
}

laplacianSchemes
{
    default            Gauss linear corrected;
}

snGradSchemes
{
    default            corrected;
}

interpolationSchemes
{
    default            linear;
}

